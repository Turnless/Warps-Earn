                                    <input type="checkbox" name="enable_multiplier" class="sr-only peer" <%= storeConfig.enable_multiplier !== false ? 'checked' : '' %>>
                                    <div class="w-9 h-5 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                                </label>
                            </div>
                            <input type="number" name="multiplier" value="<%= storeConfig.multiplier %>" required class="w-full px-4 py-3 rounded-xl border border-white/10 bg-neutral-900 focus:ring-2 focus:ring-neutral-900 shadow-inner">
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold text-violet-700 uppercase">Premium Tier Upgrade (PTS)</label>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="enable_premium" class="sr-only peer" <%= storeConfig.enable_premium !== false ? 'checked' : '' %>>
                                    <div class="w-9 h-5 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                                </label>
                            </div>
                            <input type="number" name="premium_tier" value="<%= storeConfig.premium_tier %>" required class="w-full px-4 py-3 rounded-xl border border-violet-200 bg-violet-50 focus:ring-2 focus:ring-violet-500 shadow-inner">
                        </div>
                        <div class="flex items-center justify-between col-span-1 md:col-span-2 mt-4 pt-4 border-t border-white/10">
                            <label class="text-sm font-bold text-amber-700 uppercase tracking-widest">Enable Gold Tier Packages</label>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="enable_gold" class="sr-only peer" <%= storeConfig.enable_gold !== false ? 'checked' : '' %>>
                                <div class="w-11 h-6 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                            </label>
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-amber-700 uppercase">Gold Tier 3 Months (PTS)</label>
                            <input type="number" name="gold_tier_3m" value="<%= storeConfig.gold_tier_3m %>" required class="w-full px-4 py-3 rounded-xl border border-amber-200 bg-amber-50 focus:ring-2 focus:ring-amber-500 shadow-inner">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-amber-700 uppercase">Gold Tier 6 Months (PTS)</label>
                            <input type="number" name="gold_tier_6m" value="<%= storeConfig.gold_tier_6m %>" required class="w-full px-4 py-3 rounded-xl border border-amber-200 bg-amber-50 focus:ring-2 focus:ring-amber-500 shadow-inner">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-amber-700 uppercase">Gold 3M + Blue Tick (PTS)</label>
                            <input type="number" name="gold_tier_3m_blue" value="<%= storeConfig.gold_tier_3m_blue %>" required class="w-full px-4 py-3 rounded-xl border border-amber-200 bg-amber-50 focus:ring-2 focus:ring-amber-500 shadow-inner">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-amber-700 uppercase">Gold 6M + Blue Tick (PTS)</label>
                            <input type="number" name="gold_tier_6m_blue" value="<%= storeConfig.gold_tier_6m_blue %>" required class="w-full px-4 py-3 rounded-xl border border-amber-200 bg-amber-50 focus:ring-2 focus:ring-amber-500 shadow-inner">
                        </div>
                    </div>

                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-8 py-4 rounded-2xl shadow-sm tracking-widest uppercase transition-all mt-2 self-end">
                        Update Pricing
                    </button>
                </form>

                <div class="w-full bg-rose-50 border border-rose-200 rounded-3xl p-6 mt-4 flex flex-col gap-4">
                    <div class="flex items-center gap-2 text-rose-800">
                        <span class="text-xl">🧨</span>
                        <h3 class="font-bold tracking-tight uppercase">Nuclear Option</h3>
                    </div>
                    <button onclick="wipeAll()" class="bg-rose-600 hover:bg-rose-700 text-white font-bold py-4 rounded-2xl shadow-md tracking-widest uppercase transition-all text-xs">
                        Wipe Entire Production Database
                    </button>
                </div>
            </section>

            <!-- QUESTS & PROMOS ENGINE -->
            <section id="tab-quests" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">Dynamic Quests Engine</h2>
                    <p class="text-sm text-neutral-400 font-medium">Build, deploy, and manage on-chain custom promotional tasks.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 shadow-sm flex flex-col gap-4">
                        <h3 class="font-bold uppercase tracking-wider text-sm">Create New Quest</h3>
                        <form action="/admin/quests?secret=<%= secret %>" method="POST" class="flex flex-col gap-4">
                            <input type="hidden" name="action" value="create">
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold text-neutral-400 uppercase">Quest Key (No spaces)</label>
                                <input type="text" name="key" placeholder="e.g., promo2" required class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900">
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold text-neutral-400 uppercase">Display Title</label>
                                <input type="text" name="title" placeholder="e.g., Retweet latest post" required class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900">
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold text-neutral-400 uppercase">Target URL</label>
                                <input type="url" name="url" placeholder="https://..." required class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900">
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex flex-col gap-1">
                                    <label class="text-xs font-bold text-neutral-400 uppercase">Reward (PTS)</label>
                                    <input type="number" name="pts" placeholder="150" required class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900">
                                </div>
                                <div class="flex flex-col gap-1">
                                    <label class="text-xs font-bold text-neutral-400 uppercase">Emoji Icon</label>
                                    <input type="text" name="icon" placeholder="🔥" value="🔥" required class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900">
                                </div>
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold text-neutral-400 uppercase">Tier Required</label>
                                <select name="tier_required" class="px-4 py-3 rounded-xl border border-white/10 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-900 bg-neutral-900">
