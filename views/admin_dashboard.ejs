<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Warps Admin Control Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #030303;
            color: #f5f5f5;
            background-image: radial-gradient(circle at 15% 50%, rgba(99, 102, 241, 0.08), transparent 25%), radial-gradient(circle at 85% 30%, rgba(16, 185, 129, 0.08), transparent 25%);
            background-attachment: fixed;
        }
        .mono-text {
            font-family: 'Geist Mono', monospace;
        }
        .hide-section {
            display: none !important;
        }
        .sidebar-active {
            background: linear-gradient(90deg, rgba(255,255,255,0.1) 0%, transparent 100%);
            border-left: 2px solid #6366f1;
            color: #ffffff;
        }
        .sidebar-inactive {
            color: #a3a3a3;
            background-color: transparent;
            border-left: 2px solid transparent;
        }
        .sidebar-inactive:hover {
            color: #ffffff;
            background-color: rgba(255,255,255,0.03);
        }
        /* Custom Scrollbar for Dark Mode */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
    </style>
</head>
<body class="min-h-screen flex selection:bg-indigo-500/30 selection:text-indigo-200">

    <!-- MOBILE TOP BAR -->
    <div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-neutral-950/80 backdrop-blur-xl border-b border-white/10 z-40 flex items-center justify-between px-4">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-sm shadow-[0_0_15px_rgba(99,102,241,0.2)]">🛡️</div>
            <span class="font-bold text-white tracking-tight uppercase text-sm">Admin Hub</span>
        </div>
        <button onclick="toggleMobileMenu()" class="w-10 h-10 bg-neutral-900/5 rounded-xl flex items-center justify-center text-xl text-white shadow-sm border border-white/10 hover:bg-neutral-900/10 transition-colors">
            ☰
        </button>
    </div>

    <!-- SIDEBAR -->
    <div id="mobile-overlay" onclick="toggleMobileMenu()" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-40 hidden md:hidden"></div>
    <aside id="sidebar" class="w-64 bg-neutral-950/90 md:bg-neutral-950/40 backdrop-blur-2xl border-r border-white/5 fixed h-screen flex flex-col justify-between py-6 px-4 z-50 overflow-y-auto transform -translate-x-full md:translate-x-0 transition-transform duration-300 shadow-2xl">
        <div class="flex flex-col gap-8">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 flex items-center justify-center text-xl shadow-[0_0_20px_rgba(99,102,241,0.15)]">
                        🛡️
                    </div>
                    <div class="flex flex-col">
                        <h1 class="text-sm font-bold tracking-tight text-white leading-tight uppercase">Admin Hub</h1>
                        <span class="text-[10px] text-indigo-400 font-medium mono-text">Command Center</span>
                    </div>
                </div>
                <button onclick="toggleMobileMenu()" class="md:hidden text-2xl text-neutral-400 hover:text-white transition-colors">×</button>
            </div>

            <nav class="flex flex-col gap-2">
                <button onclick="switchTab('tab-telemetry')" id="nav-telemetry" class="sidebar-active px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📊</span> Analytics
                </button>
                <button onclick="switchTab('tab-payouts')" id="nav-payouts" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <span class="text-lg">💸</span> Payouts
                    </div>
                    <% if (stats.pending > 0) { %>
                        <span class="bg-amber-500 text-white px-2 py-0.5 rounded-md text-[10px] mono-text group-hover:animate-pulse"><%= stats.pending %></span>
                    <% } %>
                </button>
                <button onclick="switchTab('tab-bounties')" id="nav-bounties" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <span class="text-lg">🎯</span> Bounties
                    </div>
                    <% if (pendingBounties && pendingBounties.length > 0) { %>
                        <span class="bg-indigo-500 text-white px-2 py-0.5 rounded-md text-[10px] mono-text group-hover:animate-pulse"><%= pendingBounties.length %></span>
                    <% } %>
                </button>
                <button onclick="switchTab('tab-orders')" id="nav-orders" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <span class="text-lg">🛒</span> Store Orders
                    </div>
                    <% if (typeof pendingStoreOrders !== 'undefined' && pendingStoreOrders.length > 0) { %>
                        <span class="bg-amber-500 text-white px-2 py-0.5 rounded-md text-[10px] mono-text group-hover:animate-pulse"><%= pendingStoreOrders.length %></span>
                    <% } %>
                </button>
                <button onclick="switchTab('tab-lookup')" id="nav-lookup" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🔍</span> User Lookup
                </button>
                <a href="/admin/sybil-hunter?secret=<%= secret %>" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🕵️</span> Sybil Hunter
                </a>
                <button onclick="switchTab('tab-leaderboard')" id="nav-leaderboard" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🏆</span> Leaderboard
                </button>
                <button onclick="switchTab('tab-quests')" id="nav-quests" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🎯</span> Quests
                </button>
                <button onclick="switchTab('tab-broadcast')" id="nav-broadcast" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📢</span> Broadcast
                </button>
                <button onclick="switchTab('tab-controls')" id="nav-controls" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">⚙️</span> Ecosystem
                </button>
                <a href="/admin/queues?secret=<%= secret %>" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📈</span> Bull Queues ↗
                </a>
            </nav>
        </div>

        <div class="flex flex-col gap-3 mt-8">
            <a href="/admin/logout" class="bg-neutral-900/10 text-neutral-600 hover:bg-neutral-300 w-full text-center py-3 rounded-2xl text-[10px] font-bold uppercase tracking-widest transition-all">
                Logout
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="w-full md:ml-64 flex-1 p-4 md:p-8 h-screen overflow-y-auto pt-20 md:pt-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-6 pb-20">

            <!-- 1. TELEMETRY / METRICS -->
            <section id="tab-telemetry" class="flex flex-col gap-6">
                <div class="flex justify-between items-start md:items-end flex-col md:flex-row gap-4">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-white">Analytics</h2>
                        <p class="text-sm text-neutral-400 font-medium">Real-time stats and metrics.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/admin/export-users?secret=<%= secret %>" class="bg-neutral-900 border border-white/10 text-neutral-700 hover:bg-neutral-900/5 px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all">📄 Export Users</a>
                        <a href="/admin/export-withdrawals?secret=<%= secret %>" class="bg-neutral-900 border border-white/10 text-neutral-700 hover:bg-neutral-900/5 px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all">📄 Export Payouts</a>
                    </div>
                </div>

                <!-- Dark Hero Card -->
                <div class="w-full bg-neutral-950 text-[#e6ddd0] rounded-3xl p-8 border border-neutral-900 relative overflow-hidden shadow-lg flex flex-col gap-6">
                    <div class="absolute inset-0 opacity-5 pointer-events-none bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:14px_24px]"></div>
                    
                    <div class="relative z-10 flex justify-between items-center">
                        <span class="text-xs uppercase tracking-wider text-neutral-400 font-medium mono-text">Total System Value (Circulating)</span>
                        <span class="bg-emerald-950 text-emerald-400 border border-emerald-900 px-3 py-1 rounded-lg text-[10px] uppercase font-bold tracking-widest">LIVE</span>
                    </div>

                    <div class="relative z-10 flex items-baseline gap-2">
                        <span class="text-5xl font-bold tracking-tight text-neutral-100"><%= stats.circulatingPts.toLocaleString() %></span>
                        <span class="text-sm font-medium tracking-widest text-neutral-400 mono-text">PTS</span>
                    </div>

                    <div class="relative z-10 flex gap-8 pt-4 border-t border-neutral-800">
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-bold mono-text">Valuation</span>
                            <span class="text-lg font-bold text-emerald-400">$<%= stats.circulatingUsd %> USD</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-bold mono-text">Total Users</span>
                            <span class="text-lg font-bold text-white"><%= stats.users.toLocaleString() %></span>
                        </div>
                    </div>
                </div>

                <!-- Sub Metrics Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-neutral-900/5 backdrop-blur-md border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-white/10">
                            <div class="flex items-center gap-2 text-xs text-neutral-400">
                                <span class="text-lg">📺</span> <span class="font-bold uppercase tracking-wider">Ad Network Yield</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-white mt-1"><%= stats.adEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-400 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-400 mono-text">Across <%= stats.adsWatched.toLocaleString() %> watched ads</span>
                    </div>

                    <div class="bg-neutral-900/5 backdrop-blur-md border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-white/10">
                            <div class="flex items-center gap-2 text-xs text-neutral-400">
                                <span class="text-lg">🎯</span> <span class="font-bold uppercase tracking-wider">Task Yield</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-white mt-1"><%= stats.taskEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-400 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-400 mono-text">From quests and promos</span>
                    </div>

                    <div class="bg-neutral-900/5 backdrop-blur-md border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-white/10">
                            <div class="flex items-center gap-2 text-xs text-neutral-400">
                                <span class="text-lg">🤝</span> <span class="font-bold uppercase tracking-wider">Campaign Referrals</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-white mt-1"><%= stats.referralEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-400 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-400 mono-text">From referral milestones</span>
                    </div>

                    <div class="bg-neutral-900/5 backdrop-blur-md border border-white/10 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center gap-2 text-xs text-neutral-400 pb-2 border-b border-white/10">
                            <span class="text-lg">💸</span> <span class="font-bold uppercase tracking-wider">Total Paid Out</span>
                        </div>
                        <span class="text-2xl font-bold text-white mt-1"><%= stats.paidOutPts.toLocaleString() %> <span class="text-[10px] text-neutral-400 mono-text">PTS</span></span>
                        <span class="text-xs font-bold text-emerald-600 mono-text">≈ $<%= stats.paidOutUsd %> USD</span>
                    </div>
                </div>

                <!-- PTS CALCULATOR -->
                <div class="bg-indigo-950 text-indigo-100 rounded-3xl p-6 border border-indigo-900 shadow-md flex flex-col gap-4 relative overflow-hidden mt-4">
                    <div class="absolute -right-4 -top-4 text-7xl opacity-10">🧮</div>
                    <div class="flex items-center gap-2 pb-2 border-b border-indigo-900 relative z-10">
                        <span class="text-xl">🧮</span>
                        <h3 class="font-bold text-sm uppercase tracking-wider text-indigo-300 mono-text">Quick Converter (PTS ↔ USD)</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 relative z-10">
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] font-bold uppercase tracking-widest text-indigo-400">Points (PTS)</label>
                            <input type="number" id="calc-pts" placeholder="Enter PTS..." class="w-full bg-indigo-900/50 border border-indigo-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500" oninput="calcToUsd()">
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] font-bold uppercase tracking-widest text-indigo-400">Dollars (USD)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-indigo-300 font-bold">$</span>
                                <input type="number" id="calc-usd" placeholder="Enter USD..." class="w-full bg-indigo-900/50 border border-indigo-800 rounded-xl pl-8 pr-4 py-3 text-white focus:outline-none focus:border-indigo-500" oninput="calcToPts()">
                            </div>
                        </div>
                    </div>
                    <script>
                        function calcToUsd() {
                            const pts = parseFloat(document.getElementById('calc-pts').value) || 0;
                            const usd = pts * 0.0008;
                            document.getElementById('calc-usd').value = usd > 0 ? usd.toFixed(2) : "";
                        }
                        function calcToPts() {
                            const usd = parseFloat(document.getElementById('calc-usd').value) || 0;
                            const pts = usd / 0.0008;
                            document.getElementById('calc-pts').value = pts > 0 ? Math.round(pts) : "";
                        }
                    </script>
                </div>

                <!-- AD NETWORK TELEMETRY -->
                <div class="mt-4 flex flex-col gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">📡</span>
                        <h3 class="font-bold tracking-tight uppercase text-white">Network Health & Telemetry</h3>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <% const networkNames = Object.keys(telemetry || {}); %>
                        <% if (networkNames.length > 0) { %>
                            <% networkNames.forEach(net => { %>
                                <div class="bg-neutral-900/5 backdrop-blur-md rounded-2xl p-4 border border-white/10 shadow-sm flex flex-col gap-2 relative">
                                    <% const stats = telemetry[net]; %>
                                    <% const total = stats.success + stats.fail; %>
                                    <% const winRate = total > 0 ? Math.round((stats.success / total) * 100) : 0; %>
                                    
                                    <div class="flex justify-between items-center border-b border-white/10 pb-2">
                                        <span class="text-xs font-bold uppercase tracking-widest text-neutral-200"><%= net %></span>
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-md mono-text <%= winRate > 50 ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                                            <%= winRate %>% WIN
                                        </span>
                                    </div>
                                    <div class="flex justify-between mt-1 text-xs mono-text">
                                        <span class="text-emerald-600 font-bold">Success: <%= stats.success %></span>
                                        <span class="text-rose-600 font-bold">Failed: <%= stats.fail %></span>
                                    </div>
                                    <% if (stats.lastError) { %>
                                        <div class="mt-2 bg-rose-50 text-rose-800 text-[9px] p-2 rounded-lg mono-text truncate" title="<%= stats.lastError %>">
                                            ⚠️ <%= stats.lastError %>
                                        </div>
                                    <% } else { %>
                                        <div class="mt-2 bg-emerald-50 text-emerald-800 text-[9px] p-2 rounded-lg mono-text">
                                            ✅ Operational
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-span-full text-center text-xs text-neutral-400 py-6 border border-dashed border-white/10 rounded-2xl">
                                No telemetry data captured yet. Network tracking initiates automatically on first ad rotation.
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- COUNTRY BREAKDOWN -->
                <div class="mt-4 flex flex-col gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🌎</span>
                        <h3 class="font-bold tracking-tight uppercase text-white">Demographic Distribution</h3>
                    </div>
                    <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 shadow-sm flex flex-col gap-2">
                        <% if (countryStats && countryStats.length > 0) { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                                <% countryStats.forEach((c, index) => { %>
                                    <div class="flex items-center justify-between bg-neutral-900/5 p-3 rounded-xl border border-white/5 hover:border-indigo-500/50 transition-colors">
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs font-bold text-neutral-400 mono-text">#<%= index + 1 %></span>
                                            <span class="text-sm font-bold text-white"><%= c.country %></span>
                                        </div>
                                        <span class="text-xs font-bold text-indigo-400 bg-indigo-500/10 px-2 py-1 rounded-lg mono-text"><%= c.count.toLocaleString() %> Users</span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center text-xs text-neutral-400 py-6 border border-dashed border-white/10 rounded-2xl">
                                No demographics data available yet.
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>

            <!-- 2. PENDING PAYOUTS -->
            <section id="tab-payouts" class="hide-section flex flex-col gap-6">
                <div class="flex justify-between items-end">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-white">Pending Payouts</h2>
                        <p class="text-sm text-neutral-400 font-medium">Review and process withdrawal requests.</p>
                    </div>
                </div>

                <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 shadow-sm flex flex-col gap-4">
                    <% if (pendingList && pendingList.length > 0) { %>
                        <div class="flex flex-col gap-3">
                            <% pendingList.forEach(p => { %>
                                <div class="flex items-center justify-between bg-neutral-900/5 p-4 rounded-2xl border border-white/10">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-full bg-neutral-900/10 flex items-center justify-center text-lg shadow-inner">
                                            <%= (p.username || 'A').charAt(0).toUpperCase() %>
                                        </div>
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-sm font-bold text-white">@<%= p.username || 'Anonymous' %></span>
                                            <span class="text-[10px] text-neutral-400 mono-text">ID: <%= p.telegram_id %></span>
                                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md w-max mt-1"><%= p.asset %>: <%= p.amount_points %> PTS</span>
                                        </div>
                                    </div>
                                    
                                    <div class="flex flex-col items-end gap-2 text-right">
                                        <span class="text-[10px] bg-neutral-900 border border-white/10 px-2 py-1 rounded-md text-neutral-600 mono-text max-w-[200px] truncate"><%= p.destination_details %></span>
                                        <div class="flex gap-2">
                                            <a href="/admin/payout?txId=<%= p.id %>&action=reject" class="px-4 py-1.5 bg-rose-100 hover:bg-rose-200 text-rose-800 rounded-lg text-[10px] font-bold uppercase transition-all">Reject</a>
                                            <a href="/admin/payout?txId=<%= p.id %>&action=approve" class="px-4 py-1.5 bg-neutral-950 hover:bg-neutral-800 text-[#e6ddd0] rounded-lg text-[10px] font-bold uppercase transition-all shadow-sm">Approve</a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-12 flex flex-col items-center gap-3 opacity-50">
                            <span class="text-4xl">📭</span>
                            <span class="text-sm font-bold text-neutral-400 uppercase tracking-widest">Inbox Zero</span>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- 2.5 BOUNTIES REVIEW -->
            <section id="tab-bounties" class="hide-section flex flex-col gap-6">
                <div class="flex justify-between items-end">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-white">Bounty Approvals</h2>
                        <p class="text-sm text-neutral-400 font-medium">Review submitted proof links and approve/reject social tasks.</p>
                    </div>
                </div>

                <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 shadow-sm flex flex-col gap-4">
                    <% if (pendingBounties && pendingBounties.length > 0) { %>
                        <div class="flex flex-col gap-3">
                            <% pendingBounties.forEach(sub => { %>
                                <div class="flex items-center justify-between bg-neutral-900/5 p-4 rounded-2xl border border-white/10 flex-wrap gap-4">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center text-lg shadow-inner border border-indigo-200">🎯</div>
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-sm font-bold text-white"><%= sub.bounty.title || 'Unknown Bounty' %></span>
                                            <span class="text-[10px] text-neutral-400 font-medium">Sub by: @<%= sub.user.username || sub.user.telegram_id || 'Anonymous' %> (Tier: <%= sub.user.account_tier || 'Standard' %>)</span>
                                            <div class="flex gap-2 mt-1">
                                                <a href="<%= sub.proof_link %>" target="_blank" class="text-[10px] font-bold text-indigo-700 bg-indigo-100 hover:bg-indigo-200 px-2 py-0.5 rounded-md w-max transition-colors flex items-center gap-1">View Proof ↗</a>
                                                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md w-max">Reward: +<%= sub.bounty.reward_pts || 0 %> PTS</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="flex flex-col items-end gap-2 text-right">
                                        <div class="flex gap-2">
                                            <a href="/admin/bounty/action?subId=<%= sub._id %>&action=reject" class="px-4 py-1.5 bg-rose-100 hover:bg-rose-200 text-rose-800 rounded-lg text-[10px] font-bold uppercase transition-all whitespace-nowrap">Reject (+1 Strike)</a>
                                            <a href="/admin/bounty/action?subId=<%= sub._id %>&action=approve" class="px-4 py-1.5 bg-neutral-950 hover:bg-neutral-800 text-[#e6ddd0] rounded-lg text-[10px] font-bold uppercase transition-all shadow-sm">Approve</a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-12 flex flex-col items-center gap-3 opacity-50">
                            <span class="text-4xl">📭</span>
                            <span class="text-sm font-bold text-neutral-400 uppercase tracking-widest">No Pending Bounties</span>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- 2.5 STORE ORDERS -->
            <section id="tab-orders" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">Pending Store Orders</h2>
                    <p class="text-sm text-neutral-400 font-medium">Verify Blue Tick upgrades via your partner and approve to grant Gold status.</p>
                </div>

                <div class="flex flex-col gap-4">
                    <% if (typeof pendingStoreOrders !== 'undefined' && pendingStoreOrders.length > 0) { %>
                        <% pendingStoreOrders.forEach(order => { %>
                            <div class="bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-amber-300/80 shadow-sm flex flex-col gap-4">
                                <div class="flex justify-between items-start">
                                    <div class="flex flex-col">
                                        <div class="flex items-center gap-2">
                                            <h3 class="font-bold text-lg text-white"><%= order.item_title %></h3>
                                            <span class="bg-amber-100 text-amber-800 text-[10px] uppercase font-bold tracking-widest px-2 py-1 rounded">Pending</span>
                                        </div>
                                        <span class="text-xs text-neutral-400 mono-text">User: @<%= order.user.username || order.telegram_id %></span>
                                    </div>
                                    <span class="text-xl font-bold text-rose-600 mono-text"><%= order.cost.toLocaleString() %> PTS</span>
                                </div>
                                <div class="flex gap-2">
                                    <form action="/admin/store-orders/action" method="POST" class="flex-1">
                                        <input type="hidden" name="order_id" value="<%= order._id %>">
                                        <input type="hidden" name="action" value="approve">
                                        <button class="w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold py-3 rounded-xl uppercase tracking-widest transition-all">Approve (Upgrade Tier)</button>
                                    </form>
                                    <form action="/admin/store-orders/action" method="POST" class="flex-1">
                                        <input type="hidden" name="order_id" value="<%= order._id %>">
                                        <input type="hidden" name="action" value="reject">
                                        <button class="w-full bg-rose-100 hover:bg-rose-200 text-rose-700 text-xs font-bold py-3 rounded-xl uppercase tracking-widest transition-all">Reject (Refund PTS)</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-12 bg-neutral-900/5 backdrop-blur-md rounded-3xl border border-dashed border-white/10">
                            <span class="text-4xl opacity-50 mb-4 block">🛒</span>
                            <h3 class="text-neutral-400 font-bold uppercase tracking-widest text-sm">No Pending Orders</h3>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- 3. USER LOOKUP -->
            <section id="tab-lookup" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">User Intelligence</h2>
                    <p class="text-sm text-neutral-400 font-medium">Search the database and execute bans.</p>
                </div>

                <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 shadow-sm flex flex-col gap-4">
                    <form action="/admin/user-lookup" method="GET" class="flex flex-col gap-3">
                        <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Search Identifier</label>
                        <div class="flex gap-3">
                            <input type="text" name="q" placeholder="Enter Telegram ID or @username..." class="flex-1 px-5 py-4 rounded-2xl border border-white/10 bg-neutral-900 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-200 shadow-inner">
                            <button type="submit" class="bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] text-sm font-bold px-8 py-4 rounded-2xl shadow-sm tracking-widest uppercase transition-all">
                                Search
                            </button>
                        </div>
                        <p class="text-[10px] text-neutral-400">Searching by @username correctly strips the @ symbol automatically.</p>
                    </form>
                </div>
            </section>

            <!-- 4. LEADERBOARD -->
            <section id="tab-leaderboard" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">Wealth Leaderboard</h2>
                    <p class="text-sm text-neutral-400 font-medium">Top 10 highest balance accounts. Monitor for abuse.</p>
                </div>

                <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-4 md:p-6 border border-white/10 shadow-sm flex flex-col gap-2">
                    <div class="grid grid-cols-12 px-2 md:px-4 py-2 text-[10px] uppercase font-bold text-neutral-400 tracking-widest mono-text border-b border-white/10">
                        <div class="col-span-2 md:col-span-1">Rnk</div>
                        <div class="col-span-6 md:col-span-5">User</div>
                        <div class="col-span-4 md:col-span-3 text-right hidden md:block">Balance</div>
                        <div class="col-span-4 md:col-span-3 text-right">Action</div>
                    </div>
                    <% topUsers.forEach((u, index) => { %>
                        <div class="grid grid-cols-12 px-2 md:px-4 py-3 items-center bg-neutral-900/5 rounded-xl border border-neutral-100 hover:border-white/10 transition-all gap-1">
                            <div class="col-span-2 md:col-span-1 text-sm font-bold <%= index < 3 ? 'text-amber-500' : 'text-neutral-400' %>">#<%= index + 1 %></div>
                            <div class="col-span-6 md:col-span-5 flex flex-col truncate">
                                <span class="text-sm font-bold text-white truncate">@<%= u.username || 'Anon' %></span>
                                <span class="text-[9px] text-neutral-400 mono-text"><%= u.telegram_id %></span>
                            </div>
                            <div class="col-span-4 md:col-span-3 text-right font-bold text-emerald-700 mono-text hidden md:block">
                                <%= u.points_balance.toLocaleString() %> PTS
                            </div>
                            <div class="col-span-4 md:col-span-3 text-right flex flex-col md:block items-end gap-1">
                                <span class="md:hidden text-[10px] font-bold text-emerald-700 mono-text"><%= u.points_balance.toLocaleString() %> PTS</span>
                                <a href="/admin/user-lookup?q=<%= u.telegram_id %>" class="text-[10px] font-bold text-neutral-950 bg-neutral-900/10 hover:bg-neutral-300 px-3 py-1.5 rounded-lg uppercase transition-all whitespace-nowrap">Inspect</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>

            <!-- 5. BROADCAST ENGINE -->
            <section id="tab-broadcast" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">Broadcast Engine</h2>
                    <p class="text-sm text-neutral-400 font-medium">Push a direct Telegram message to every registered user via Bull Queues.</p>
                </div>

                <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 shadow-sm flex flex-col gap-4 relative overflow-hidden">
                    <div class="absolute right-[-20px] top-[-20px] text-8xl opacity-5 select-none pointer-events-none">📢</div>
                    <form action="/admin/broadcast" method="POST" class="flex flex-col gap-4 relative z-10 border-b border-white/10 pb-6">
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Message Payload</label>
                            <textarea name="message_text" rows="5" placeholder="Enter your HTML formatted message here... (e.g. <b>Hello</b>)" class="w-full px-5 py-4 rounded-2xl border border-white/10 bg-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-200 shadow-inner resize-none"></textarea>
                        </div>
                        <button type="submit" onclick="return confirm('WARNING: This will instantly queue a message to <%= stats.users %> users. Are you absolutely sure?')" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-8 py-4 rounded-2xl shadow-md tracking-widest uppercase transition-all self-end">
                            Deploy Broadcast
                        </button>
                    </form>

                    <form action="/admin/wakeup-push" method="POST" class="flex items-center justify-between mt-2">
                        <div class="flex flex-col">
                            <span class="text-sm font-bold text-white">Automated Wake-up Call</span>
                            <span class="text-[10px] text-neutral-400 uppercase tracking-widest mono-text">Ping inactive users who haven't logged in for 48 hrs</span>
                        </div>
                        <button type="submit" onclick="return confirm('This will ping all inactive users with a reminder. Proceed?')" class="bg-amber-100 hover:bg-amber-200 text-amber-700 text-[10px] font-bold px-4 py-2 rounded-xl uppercase transition-all">
                            Send Wake-up Pings
                        </button>
                    </form>
                </div>
            </section>

            <!-- 6. ECOSYSTEM CONTROLS -->
            <section id="tab-controls" class="hide-section flex flex-col gap-6">
