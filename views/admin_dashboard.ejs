                    <h2 class="text-2xl font-bold tracking-tight text-white">Ecosystem Controls</h2>
                    <p class="text-sm text-neutral-400 font-medium">Global toggles affecting all users live on the network.</p>
                </div>

                <form action="/admin/settings" method="POST" class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 shadow-sm flex flex-col gap-6">
                    
                    <div class="flex justify-between items-center bg-neutral-900/5 p-5 rounded-2xl border border-white/10">
                        <div class="flex flex-col">
                            <label class="text-sm font-bold text-white">Global Maintenance Mode</label>
                            <span class="text-[10px] text-neutral-400 uppercase tracking-widest mono-text mt-0.5">Blocks all UI access</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="maintenance" class="sr-only peer" <%= settings.maintenance ? 'checked' : '' %>>
                            <div class="w-14 h-7 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-amber-500"></div>
                        </label>
                    </div>

                    <div class="flex justify-between items-center bg-neutral-900/5 p-5 rounded-2xl border border-white/10">
                        <div class="flex flex-col">
                            <label class="text-sm font-bold text-white">Allow Withdrawals</label>
                            <span class="text-[10px] text-neutral-400 uppercase tracking-widest mono-text mt-0.5">Toggle payouts on/off</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="withdrawals" class="sr-only peer" <%= settings.withdrawals ? 'checked' : '' %>>
                            <div class="w-14 h-7 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-500"></div>
                        </label>
                    </div>
                    
                    <div class="flex flex-col gap-2">
                        <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Reward Yield Per Loop</label>
                        <input type="number" name="reward_per_ad" value="<%= settings.reward_per_ad || 3 %>" class="w-full px-5 py-4 rounded-2xl border border-white/10 bg-neutral-900 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-200 shadow-inner">
                    </div>

                    <div class="flex flex-col gap-2">
                        <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">7-Day Login Streak Reward</label>
                        <input type="number" name="streak_reward" value="<%= settings.streak_reward || 500 %>" class="w-full px-5 py-4 rounded-2xl border border-white/10 bg-neutral-900 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-200 shadow-inner">
                    </div>

                    <button type="submit" class="bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] text-sm font-bold px-8 py-4 rounded-2xl shadow-sm tracking-widest uppercase transition-all mt-2">
                        Commit Global Settings
                    </button>
                </form>

                <form action="/admin/store-config" method="POST" class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 shadow-sm flex flex-col gap-6 mt-4">
                    <div class="flex items-center gap-2 pb-2 border-b border-white/10">
                        <span class="text-xl">🛒</span>
                        <h3 class="font-bold text-sm uppercase tracking-wider text-white">Store Pricing Configuration</h3>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold text-neutral-700 uppercase">Cooldown Reset (PTS)</label>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="enable_cooldown" class="sr-only peer" <%= storeConfig.enable_cooldown !== false ? 'checked' : '' %>>
                                    <div class="w-9 h-5 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-900 after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
                                </label>
                            </div>
                            <input type="number" name="cooldown" value="<%= storeConfig.cooldown %>" required class="w-full px-4 py-3 rounded-xl border border-white/10 bg-neutral-900 focus:ring-2 focus:ring-neutral-900 shadow-inner">
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold text-neutral-700 uppercase">2x Multiplier 1 Month (PTS)</label>
