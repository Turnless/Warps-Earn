                            </div>
                            <div class="flex items-center gap-2 mt-1">
                                <input type="checkbox" name="is_telegram" id="is_telegram" class="w-4 h-4 text-indigo-600 bg-neutral-900/5 border-white/10 rounded focus:ring-indigo-500">
                                <label for="is_telegram" class="text-xs font-bold text-neutral-700">Require Telegram API Join Verification (Group/Channel)</label>
                            </div>
                            <button type="submit" class="bg-neutral-950 text-white font-bold py-3 rounded-xl uppercase tracking-widest text-xs mt-2 hover:bg-neutral-800">Deploy Quest</button>
                        </form>
                    </div>

                    <div class="w-full bg-neutral-900/5 backdrop-blur-md rounded-3xl p-6 border border-white/10 shadow-sm flex flex-col gap-4">
                        <h3 class="font-bold uppercase tracking-wider text-sm">Active Quests</h3>
                        <div class="flex flex-col gap-3">
                            <% 
                                let activeQuests = {};
                                try { activeQuests = JSON.parse(settings.dynamicQuests || '{}'); } catch(e) {}
                                const questKeys = Object.keys(activeQuests);
                            %>
                            <% if (questKeys.length > 0) { %>
                                <% questKeys.forEach(k => { %>
                                    <div class="flex items-center justify-between bg-neutral-900/5 border border-white/10 p-3 rounded-xl">
                                        <div class="flex flex-col">
                                            <span class="text-sm font-bold"><%= activeQuests[k].icon %> <%= activeQuests[k].title %></span>
                                            <span class="text-[10px] text-neutral-400 mono-text">Key: <%= k %> | Reward: <%= activeQuests[k].pts %> PTS</span>
                                        </div>
                                        <form action="/admin/quests?secret=<%= secret %>" method="POST">
                                            <input type="hidden" name="action" value="delete">
                                            <input type="hidden" name="key" value="<%= k %>">
                                            <button type="submit" class="bg-rose-100 text-rose-700 hover:bg-rose-200 px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase transition-all">Remove</button>
                                        </form>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center text-neutral-400 text-xs py-4 border border-dashed border-white/10 rounded-xl">No dynamic quests deployed.</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
        const secretKey = "<%= secret %>";

        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function switchTab(tabId) {
            const tabs = ['tab-telemetry', 'tab-payouts', 'tab-bounties', 'tab-orders', 'tab-lookup', 'tab-leaderboard', 'tab-quests', 'tab-broadcast', 'tab-controls'];
            tabs.forEach(t => {
                const el = document.getElementById(t);
                if(el) el.classList.add('hide-section');
                const navBtn = document.getElementById('nav-' + t.replace('tab-', ''));
                if (navBtn) {
                    navBtn.className = "sidebar-inactive px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group";
                }
            });
            const activeSection = document.getElementById(tabId);
            if(activeSection) activeSection.classList.remove('hide-section');
            const activeNav = document.getElementById('nav-' + tabId.replace('tab-', ''));
            if (activeNav) {
                activeNav.className = "sidebar-active px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group";
            }

            // Close mobile menu if open
            const sidebar = document.getElementById('sidebar');
            if (!sidebar.classList.contains('-translate-x-full') && window.innerWidth < 768) {
                toggleMobileMenu();
            }
        }

        function wipeAll() {
            if (confirm("CRITICAL WARNING: This will permanently destroy ALL users and sessions from the production database. This cannot be undone! Are you absolutely sure?")) {
                if (confirm("FINAL CONFIRMATION: Type OK to proceed with global wipe.")) {
                    window.location.href = `/admin/delete-user?id=all`;
                }
            }
        }
    </script>
</body>
</html>
