<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Warps Admin Control Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #e6ddd0;
            color: #1a1a16;
        }
        .mono-text {
            font-family: 'Geist Mono', monospace;
        }
        .hide-section {
            display: none !important;
        }
        .sidebar-active {
            background-color: #1a1a16;
            color: #e6ddd0;
        }
        .sidebar-inactive {
            color: #1a1a16;
            background-color: transparent;
        }
        .sidebar-inactive:hover {
            background-color: rgba(0,0,0,0.05);
        }
    </style>
</head>
<body class="min-h-screen flex selection:bg-neutral-800 selection:text-[#e6ddd0]">

    <!-- MOBILE TOP BAR -->
    <div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-white/80 backdrop-blur-md border-b border-neutral-300/80 z-40 flex items-center justify-between px-4">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-neutral-900 flex items-center justify-center text-white text-sm">🛡️</div>
            <span class="font-bold text-neutral-900 tracking-tight uppercase text-sm">Admin Hub</span>
        </div>
        <button onclick="toggleMobileMenu()" class="w-10 h-10 bg-neutral-100 rounded-xl flex items-center justify-center text-xl text-neutral-900 shadow-sm border border-neutral-200">
            ☰
        </button>
    </div>

    <!-- SIDEBAR -->
    <div id="mobile-overlay" onclick="toggleMobileMenu()" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>
    <aside id="sidebar" class="w-64 bg-white/90 md:bg-white/60 backdrop-blur-xl border-r border-neutral-300/80 fixed h-screen flex flex-col justify-between py-6 px-4 z-50 overflow-y-auto transform -translate-x-full md:translate-x-0 transition-transform duration-300 shadow-2xl md:shadow-none">
        <div class="flex flex-col gap-8">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-neutral-900 border border-neutral-950/20 flex items-center justify-center text-[#e6ddd0] text-lg shadow-inner">
                        🛡️
                    </div>
                    <div class="flex flex-col">
                        <h1 class="text-sm font-bold tracking-tight text-neutral-900 leading-tight uppercase">Admin Hub</h1>
                        <span class="text-[10px] text-neutral-500 font-medium mono-text">System Oversight</span>
                    </div>
                </div>
                <button onclick="toggleMobileMenu()" class="md:hidden text-2xl text-neutral-500">×</button>
            </div>

            <nav class="flex flex-col gap-2">
                <button onclick="switchTab('tab-telemetry')" id="nav-telemetry" class="sidebar-active px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📊</span> Telemetry
                </button>
                <button onclick="switchTab('tab-payouts')" id="nav-payouts" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center justify-between text-xs font-bold uppercase tracking-wider transition-all text-left group">
                    <div class="flex items-center gap-3">
                        <span class="text-lg">💸</span> Payouts
                    </div>
                    <% if (stats.pending > 0) { %>
                        <span class="bg-amber-500 text-white px-2 py-0.5 rounded-md text-[10px] mono-text group-hover:animate-pulse"><%= stats.pending %></span>
                    <% } %>
                </button>
                <button onclick="switchTab('tab-lookup')" id="nav-lookup" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🔍</span> User Lookup
                </button>
                <a href="/admin/sybil-hunter?secret=<%= secret %>" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🕵️</span> Sybil Hunter
                </a>
                <button onclick="switchTab('tab-leaderboard')" id="nav-leaderboard" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">🏆</span> Leaderboard
                </button>
                <button onclick="switchTab('tab-broadcast')" id="nav-broadcast" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📢</span> Broadcast
                </button>
                <button onclick="switchTab('tab-controls')" id="nav-controls" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">⚙️</span> Ecosystem
                </button>
                <a href="/admin/queues?secret=<%= secret %>" class="sidebar-inactive px-4 py-3 rounded-2xl flex items-center gap-3 text-xs font-bold uppercase tracking-wider transition-all text-left">
                    <span class="text-lg">📈</span> Bull Queues ↗
                </a>
            </nav>
        </div>

        <div class="flex flex-col gap-3 mt-8">
            <a href="/admin/logout" class="bg-neutral-200 text-neutral-600 hover:bg-neutral-300 w-full text-center py-3 rounded-2xl text-[10px] font-bold uppercase tracking-widest transition-all">
                Terminate Session
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="w-full md:ml-64 flex-1 p-4 md:p-8 h-screen overflow-y-auto pt-20 md:pt-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-6 pb-20">

            <!-- 1. TELEMETRY / METRICS -->
            <section id="tab-telemetry" class="flex flex-col gap-6">
                <div class="flex justify-between items-start md:items-end flex-col md:flex-row gap-4">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Global Telemetry</h2>
                        <p class="text-sm text-neutral-500 font-medium">Real-time macro economics and network statistics.</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="/admin/export-users?secret=<%= secret %>" class="bg-white border border-neutral-300 text-neutral-700 hover:bg-neutral-50 px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all">📄 Export Users</a>
                        <a href="/admin/export-withdrawals?secret=<%= secret %>" class="bg-white border border-neutral-300 text-neutral-700 hover:bg-neutral-50 px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all">📄 Export Payouts</a>
                    </div>
                </div>

                <!-- Dark Hero Card -->
                <div class="w-full bg-neutral-950 text-[#e6ddd0] rounded-3xl p-8 border border-neutral-900 relative overflow-hidden shadow-lg flex flex-col gap-6">
                    <div class="absolute inset-0 opacity-5 pointer-events-none bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:14px_24px]"></div>
                    
                    <div class="relative z-10 flex justify-between items-center">
                        <span class="text-xs uppercase tracking-wider text-neutral-400 font-medium mono-text">Total System Value (Circulating)</span>
                        <span class="bg-emerald-950 text-emerald-400 border border-emerald-900 px-3 py-1 rounded-lg text-[10px] uppercase font-bold tracking-widest">LIVE</span>
                    </div>

                    <div class="relative z-10 flex items-baseline gap-2">
                        <span class="text-5xl font-bold tracking-tight text-neutral-100"><%= stats.circulatingPts.toLocaleString() %></span>
                        <span class="text-sm font-medium tracking-widest text-neutral-400 mono-text">PTS</span>
                    </div>

                    <div class="relative z-10 flex gap-8 pt-4 border-t border-neutral-800">
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] uppercase tracking-wider text-neutral-500 font-bold mono-text">Valuation</span>
                            <span class="text-lg font-bold text-emerald-400">$<%= stats.circulatingUsd %> USD</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] uppercase tracking-wider text-neutral-500 font-bold mono-text">Total Users</span>
                            <span class="text-lg font-bold text-white"><%= stats.users.toLocaleString() %></span>
                        </div>
                    </div>
                </div>

                <!-- Sub Metrics Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white/60 backdrop-blur-md border border-neutral-300/80 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-neutral-200">
                            <div class="flex items-center gap-2 text-xs text-neutral-500">
                                <span class="text-lg">📺</span> <span class="font-bold uppercase tracking-wider">Ad Network Yield</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-neutral-900 mt-1"><%= stats.adEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-500 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-500 mono-text">Across <%= stats.adsWatched.toLocaleString() %> watched ads</span>
                    </div>

                    <div class="bg-white/60 backdrop-blur-md border border-neutral-300/80 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-neutral-200">
                            <div class="flex items-center gap-2 text-xs text-neutral-500">
                                <span class="text-lg">🎯</span> <span class="font-bold uppercase tracking-wider">Task Yield</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-neutral-900 mt-1"><%= stats.taskEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-500 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-500 mono-text">From quests and promos</span>
                    </div>

                    <div class="bg-white/60 backdrop-blur-md border border-neutral-300/80 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center justify-between pb-2 border-b border-neutral-200">
                            <div class="flex items-center gap-2 text-xs text-neutral-500">
                                <span class="text-lg">🤝</span> <span class="font-bold uppercase tracking-wider">Campaign Referrals</span>
                            </div>
                        </div>
                        <span class="text-2xl font-bold text-neutral-900 mt-1"><%= stats.referralEarnings.toLocaleString() %> <span class="text-[10px] text-neutral-500 mono-text">PTS</span></span>
                        <span class="text-[10px] font-bold text-neutral-500 mono-text">From referral milestones</span>
                    </div>

                    <div class="bg-white/60 backdrop-blur-md border border-neutral-300/80 rounded-3xl p-5 flex flex-col gap-2 shadow-sm">
                        <div class="flex items-center gap-2 text-xs text-neutral-500 pb-2 border-b border-neutral-200">
                            <span class="text-lg">💸</span> <span class="font-bold uppercase tracking-wider">Total Paid Out</span>
                        </div>
                        <span class="text-2xl font-bold text-neutral-900 mt-1"><%= stats.paidOutPts.toLocaleString() %> <span class="text-[10px] text-neutral-500 mono-text">PTS</span></span>
                        <span class="text-xs font-bold text-emerald-600 mono-text">≈ $<%= stats.paidOutUsd %> USD</span>
                    </div>
                </div>
            </section>

            <!-- 2. PENDING PAYOUTS -->
            <section id="tab-payouts" class="hide-section flex flex-col gap-6">
                <div class="flex justify-between items-end">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Pending Payouts</h2>
                        <p class="text-sm text-neutral-500 font-medium">Review and process withdrawal requests.</p>
                    </div>
                </div>

                <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-6 border border-neutral-300/80 shadow-sm flex flex-col gap-4">
                    <% if (pendingList && pendingList.length > 0) { %>
                        <div class="flex flex-col gap-3">
                            <% pendingList.forEach(p => { %>
                                <div class="flex items-center justify-between bg-neutral-50 p-4 rounded-2xl border border-neutral-200">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 rounded-full bg-neutral-200 flex items-center justify-center text-lg shadow-inner">
                                            <%= (p.username || 'A').charAt(0).toUpperCase() %>
                                        </div>
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-sm font-bold text-neutral-900">@<%= p.username || 'Anonymous' %></span>
                                            <span class="text-[10px] text-neutral-500 mono-text">ID: <%= p.telegram_id %></span>
                                            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md w-max mt-1"><%= p.asset %>: <%= p.amount_points %> PTS</span>
                                        </div>
                                    </div>
                                    
                                    <div class="flex flex-col items-end gap-2 text-right">
                                        <span class="text-[10px] bg-white border border-neutral-200 px-2 py-1 rounded-md text-neutral-600 mono-text max-w-[200px] truncate"><%= p.destination_details %></span>
                                        <div class="flex gap-2">
                                            <a href="/admin/payout?txId=<%= p.id %>&action=reject" class="px-4 py-1.5 bg-rose-100 hover:bg-rose-200 text-rose-800 rounded-lg text-[10px] font-bold uppercase transition-all">Reject</a>
                                            <a href="/admin/payout?txId=<%= p.id %>&action=approve" class="px-4 py-1.5 bg-neutral-950 hover:bg-neutral-800 text-[#e6ddd0] rounded-lg text-[10px] font-bold uppercase transition-all shadow-sm">Approve</a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-12 flex flex-col items-center gap-3 opacity-50">
                            <span class="text-4xl">📭</span>
                            <span class="text-sm font-bold text-neutral-500 uppercase tracking-widest">Inbox Zero</span>
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- 3. USER LOOKUP -->
            <section id="tab-lookup" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-900">User Intelligence</h2>
                    <p class="text-sm text-neutral-500 font-medium">Search the database and execute bans.</p>
                </div>

                <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-8 border border-neutral-300/80 shadow-sm flex flex-col gap-4">
                    <form action="/admin/user-lookup" method="GET" class="flex flex-col gap-3">
                        <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Search Identifier</label>
                        <div class="flex gap-3">
                            <input type="text" name="q" placeholder="Enter Telegram ID or @username..." class="flex-1 px-5 py-4 rounded-2xl border border-neutral-300 bg-white text-sm font-medium focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-800 shadow-inner">
                            <button type="submit" class="bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] text-sm font-bold px-8 py-4 rounded-2xl shadow-sm tracking-widest uppercase transition-all">
                                Search
                            </button>
                        </div>
                        <p class="text-[10px] text-neutral-500">Searching by @username correctly strips the @ symbol automatically.</p>
                    </form>
                </div>
            </section>

            <!-- 4. LEADERBOARD -->
            <section id="tab-leaderboard" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Wealth Leaderboard</h2>
                    <p class="text-sm text-neutral-500 font-medium">Top 10 highest balance accounts. Monitor for abuse.</p>
                </div>

                <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-4 md:p-6 border border-neutral-300/80 shadow-sm flex flex-col gap-2">
                    <div class="grid grid-cols-12 px-2 md:px-4 py-2 text-[10px] uppercase font-bold text-neutral-400 tracking-widest mono-text border-b border-neutral-200">
                        <div class="col-span-2 md:col-span-1">Rnk</div>
                        <div class="col-span-6 md:col-span-5">User</div>
                        <div class="col-span-4 md:col-span-3 text-right hidden md:block">Balance</div>
                        <div class="col-span-4 md:col-span-3 text-right">Action</div>
                    </div>
                    <% topUsers.forEach((u, index) => { %>
                        <div class="grid grid-cols-12 px-2 md:px-4 py-3 items-center bg-neutral-50 rounded-xl border border-neutral-100 hover:border-neutral-300 transition-all gap-1">
                            <div class="col-span-2 md:col-span-1 text-sm font-bold <%= index < 3 ? 'text-amber-500' : 'text-neutral-500' %>">#<%= index + 1 %></div>
                            <div class="col-span-6 md:col-span-5 flex flex-col truncate">
                                <span class="text-sm font-bold text-neutral-900 truncate">@<%= u.username || 'Anon' %></span>
                                <span class="text-[9px] text-neutral-500 mono-text"><%= u.telegram_id %></span>
                            </div>
                            <div class="col-span-4 md:col-span-3 text-right font-bold text-emerald-700 mono-text hidden md:block">
                                <%= u.points_balance.toLocaleString() %> PTS
                            </div>
                            <div class="col-span-4 md:col-span-3 text-right flex flex-col md:block items-end gap-1">
                                <span class="md:hidden text-[10px] font-bold text-emerald-700 mono-text"><%= u.points_balance.toLocaleString() %> PTS</span>
                                <a href="/admin/user-lookup?q=<%= u.telegram_id %>" class="text-[10px] font-bold text-neutral-950 bg-neutral-200 hover:bg-neutral-300 px-3 py-1.5 rounded-lg uppercase transition-all whitespace-nowrap">Inspect</a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>

            <!-- 5. BROADCAST ENGINE -->
            <section id="tab-broadcast" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Broadcast Engine</h2>
                    <p class="text-sm text-neutral-500 font-medium">Push a direct Telegram message to every registered user via Bull Queues.</p>
                </div>

                <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-8 border border-neutral-300/80 shadow-sm flex flex-col gap-4 relative overflow-hidden">
                    <div class="absolute right-[-20px] top-[-20px] text-8xl opacity-5 select-none pointer-events-none">📢</div>
                    <form action="/admin/broadcast" method="POST" class="flex flex-col gap-4 relative z-10">
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Message Payload</label>
                            <textarea name="message_text" rows="5" placeholder="Enter your HTML formatted message here... (e.g. <b>Hello</b>)" class="w-full px-5 py-4 rounded-2xl border border-neutral-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-800 shadow-inner resize-none"></textarea>
                        </div>
                        <button type="submit" onclick="return confirm('WARNING: This will instantly queue a message to <%= stats.users %> users. Are you absolutely sure?')" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold px-8 py-4 rounded-2xl shadow-md tracking-widest uppercase transition-all self-end">
                            Deploy Broadcast
                        </button>
                    </form>
                </div>
            </section>

            <!-- 6. ECOSYSTEM CONTROLS -->
            <section id="tab-controls" class="hide-section flex flex-col gap-6">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Ecosystem Controls</h2>
                    <p class="text-sm text-neutral-500 font-medium">Global toggles affecting all users live on the network.</p>
                </div>

                <form action="/admin/settings" method="POST" class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-8 border border-neutral-300/80 shadow-sm flex flex-col gap-6">
                    
                    <div class="flex justify-between items-center bg-neutral-50 p-5 rounded-2xl border border-neutral-200">
                        <div class="flex flex-col">
                            <label class="text-sm font-bold text-neutral-900">Global Maintenance Mode</label>
                            <span class="text-[10px] text-neutral-500 uppercase tracking-widest mono-text mt-0.5">Blocks all UI access</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="maintenance" class="sr-only peer" <%= settings.maintenance ? 'checked' : '' %>>
                            <div class="w-14 h-7 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-amber-500"></div>
                        </label>
                    </div>

                    <div class="flex justify-between items-center bg-neutral-50 p-5 rounded-2xl border border-neutral-200">
                        <div class="flex flex-col">
                            <label class="text-sm font-bold text-neutral-900">Allow Withdrawals</label>
                            <span class="text-[10px] text-neutral-500 uppercase tracking-widest mono-text mt-0.5">Toggle payouts on/off</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="withdrawals" class="sr-only peer" <%= settings.withdrawals ? 'checked' : '' %>>
                            <div class="w-14 h-7 bg-neutral-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-500"></div>
                        </label>
                    </div>
                    
                    <div class="flex flex-col gap-2">
                        <label class="text-xs font-bold text-neutral-700 uppercase tracking-widest mono-text">Reward Yield Per Loop</label>
                        <input type="number" name="reward_per_ad" value="<%= settings.reward_per_ad || 3 %>" class="w-full px-5 py-4 rounded-2xl border border-neutral-300 bg-white text-sm font-bold focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-800 shadow-inner">
                    </div>

                    <button type="submit" class="bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] text-sm font-bold px-8 py-4 rounded-2xl shadow-sm tracking-widest uppercase transition-all mt-2">
                        Commit Global Settings
                    </button>
                </form>

                <div class="w-full bg-rose-50 border border-rose-200 rounded-3xl p-6 mt-4 flex flex-col gap-4">
                    <div class="flex items-center gap-2 text-rose-800">
                        <span class="text-xl">🧨</span>
                        <h3 class="font-bold tracking-tight uppercase">Nuclear Option</h3>
                    </div>
                    <button onclick="wipeAll()" class="bg-rose-600 hover:bg-rose-700 text-white font-bold py-4 rounded-2xl shadow-md tracking-widest uppercase transition-all text-xs">
                        Wipe Entire Production Database
                    </button>
                </div>
            </section>
        </div>
    </main>

    <script>
        const secretKey = "<%= secret %>";

        function toggleMobileMenu() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        function switchTab(tabId) {
            // Hide all sections
            document.querySelectorAll('section').forEach(el => el.classList.add('hide-section'));
            // Reset all sidebar buttons
            document.querySelectorAll('aside button').forEach(el => {
                el.classList.remove('sidebar-active');
                el.classList.add('sidebar-inactive');
            });

            // Show selected section
            document.getElementById(tabId).classList.remove('hide-section');
            // Highlight selected button
            const btnId = 'nav-' + tabId.split('-')[1];
            if(document.getElementById(btnId)) {
                document.getElementById(btnId).classList.remove('sidebar-inactive');
                document.getElementById(btnId).classList.add('sidebar-active');
            }

            // Close mobile menu if open
            const sidebar = document.getElementById('sidebar');
            if (!sidebar.classList.contains('-translate-x-full') && window.innerWidth < 768) {
                toggleMobileMenu();
            }
        }

        function wipeAll() {
            if (confirm("CRITICAL WARNING: This will permanently destroy ALL users and sessions from the production database. This cannot be undone! Are you absolutely sure?")) {
                if (confirm("FINAL CONFIRMATION: Type OK to proceed with global wipe.")) {
                    window.location.href = `/admin/delete-user?id=all`;
                }
            }
        }
    </script>
</body>
</html>
