<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Warps Earn - Loading</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { 
            margin: 0; padding: 0; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            height: 100vh; background-color: #0B0F19; color: white; 
            font-family: 'Inter', system-ui, -apple-system, sans-serif; 
            overflow: hidden;
        }
        
        /* Ambient Glow Effects */
        .ambient-glow-1 {
            position: absolute; width: 300px; height: 300px; background: rgba(79, 70, 229, 0.15);
            filter: blur(80px); border-radius: 50%; top: -100px; left: -100px; z-index: 0;
        }
        .ambient-glow-2 {
            position: absolute; width: 250px; height: 250px; background: rgba(16, 185, 129, 0.1);
            filter: blur(80px); border-radius: 50%; bottom: -50px; right: -50px; z-index: 0;
        }

        #loader-content {
            z-index: 10;
            display: flex; flex-direction: column; align-items: center;
        }

        /* Animated Logo */
        .logo-container {
            width: 90px; height: 90px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.05);
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            padding: 4px;
            animation: float 3s ease-in-out infinite;
            margin-bottom: 24px;
        }
        .logo-container img {
            width: 100%; height: 100%;
            object-fit: cover;
            border-radius: 20px;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) scale(1); box-shadow: 0 8px 32px rgba(79, 70, 229, 0.2); }
            50% { transform: translateY(-10px) scale(1.02); box-shadow: 0 16px 40px rgba(79, 70, 229, 0.4); }
        }

        /* Text Styling */
        .brand-text {
            font-size: 20px; font-weight: 800; color: #ffffff;
            letter-spacing: 1px; margin-bottom: 8px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }
        .status-text {
            font-size: 11px; font-weight: 600; color: #818cf8; 
            letter-spacing: 3px; text-transform: uppercase;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* Error States */
        .error-box {
            background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 20px; padding: 24px; text-align: center; max-width: 80%;
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <div id="loader-content">
        <div class="logo-container">
            <img src="/public/logo.jpg" alt="Warps Earn Logo">
        </div>
        <div class="brand-text">Warps Earn</div>
        <div class="status-text">Authenticating</div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.ready();
                window.Telegram.WebApp.expand();
                
                const initData = window.Telegram.WebApp.initData;
                
                // Allow a tiny delay just so the user sees the beautiful loading screen animation
                setTimeout(() => {
                    if (initData) {
                        window.location.replace(`/auth?tgWebAppInitData=${encodeURIComponent(initData)}`);
                    } else {
                        document.getElementById('loader-content').innerHTML = `
                            <div class="error-box">
                                <div style="font-size: 28px; margin-bottom: 16px;">⚠️</div>
                                <div style="color: #f87171; font-weight: 800; font-size: 16px; margin-bottom: 8px;">Identity Validation Failed</div>
                                <div style="color: #94a3b8; font-size: 13px; line-height: 1.6;">The secure handshake failed. Please open this Mini App directly from within Telegram.</div>
                            </div>`;
                    }
                }, 800);
            } else {
                document.getElementById('loader-content').innerHTML = `
                    <div class="error-box">
                        <div style="font-size: 28px; margin-bottom: 16px;">📱</div>
                        <div style="color: #f87171; font-weight: 800; font-size: 16px; margin-bottom: 8px;">Telegram Required</div>
                        <div style="color: #94a3b8; font-size: 13px; line-height: 1.6;">This application must be opened through the official Telegram app.</div>
                    </div>`;
            }
        });
    </script>
</body>
</html>
