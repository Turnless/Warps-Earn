<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Warps Earn - Loading</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { 
            margin: 0; padding: 0; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            height: 100vh; background-color: #e6ddd0; color: #1a1a16; 
            font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif; 
            overflow: hidden;
        }

        #loader-content {
            z-index: 10;
            display: flex; flex-direction: column; align-items: center;
        }

        /* Animated Logo */
        .logo-container {
            width: 90px; height: 90px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.5);
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(10px);
            padding: 4px;
            animation: float 3s ease-in-out infinite;
            margin-bottom: 20px;
        }
        .logo-container img {
            width: 100%; height: 100%;
            object-fit: cover;
            border-radius: 20px;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px) scale(1); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
            50% { transform: translateY(-10px) scale(1.02); box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12); }
        }

        /* Text Styling */
        .brand-text {
            font-size: 22px; font-weight: 800; color: #1a1a16;
            letter-spacing: 0.5px;
            text-shadow: 0 2px 10px rgba(255,255,255,0.5);
        }

        /* Error States */
        .error-box {
            background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 20px; padding: 24px; text-align: center; max-width: 80%;
            backdrop-filter: blur(10px); color: #1a1a16;
        }
    </style>
</head>
<body>
    <div id="loader-content">
        <div class="logo-container">
            <img src="logo.jpg" alt="Warps Earn Logo">
        </div>
        <div class="brand-text">Warps Earn</div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.ready();
                window.Telegram.WebApp.expand();
                
                const initData = window.Telegram.WebApp.initData;
                
                // Allow a tiny delay just so the user sees the beautiful loading screen animation
                setTimeout(() => {
                    if (initData) {
                        window.location.replace(`/auth?tgWebAppInitData=${encodeURIComponent(initData)}`);
                    } else {
                        document.getElementById('loader-content').innerHTML = `
                            <div class="error-box">
                                <div style="font-size: 28px; margin-bottom: 16px;">⚠️</div>
                                <div style="color: #ef4444; font-weight: 800; font-size: 16px; margin-bottom: 8px;">Login Failed</div>
                                <div style="font-size: 13px; line-height: 1.6;">Could not connect. Please open this app from within Telegram.</div>
                            </div>`;
                    }
                }, 800);
            } else {
                document.getElementById('loader-content').innerHTML = `
                    <div class="error-box">
                        <div style="font-size: 28px; margin-bottom: 16px;">📱</div>
                        <div style="color: #ef4444; font-weight: 800; font-size: 16px; margin-bottom: 8px;">Telegram Required</div>
                        <div style="font-size: 13px; line-height: 1.6;">This application must be opened through the official Telegram app.</div>
                    </div>`;
            }
        });
    </script>
</body>
</html>
