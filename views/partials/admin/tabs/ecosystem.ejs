                                </div>
                            </div>
</div>
                        <button type="submit" class="w-full bg-white text-black hover:bg-neutral-200 font-bold py-3.5 rounded-xl shadow-sm transition-all uppercase tracking-widest text-xs mt-2">Update Pricing</button>
