                                    <input type="checkbox" name="enable_premium" class="w-4 h-4 accent-violet-500" <%= storeConfig.enable_premium !== false ? 'checked' : '' %>>
                                </div>
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">1 Month (Standard)</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_1m" placeholder="PTS" value="<%= storeConfig.premium_tier_1m || 15000 %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_1m" placeholder="Stars" value="<%= storeConfig.stars_premium_1m || 15 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">3 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_3m_blue" placeholder="PTS" value="<%= storeConfig.premium_tier_3m_blue || 45000 %>" class="w-full bg-white/90 border border-violet-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_3m_blue" placeholder="Stars" value="<%= storeConfig.stars_premium_3m_blue || 50 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
