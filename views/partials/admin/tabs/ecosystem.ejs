                        <div class="grid grid-cols-2 gap-4 relative z-10">
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] font-bold uppercase tracking-widest text-neutral-500">Points (PTS)</label>
                                <input type="number" id="calc-pts" placeholder="PTS" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:outline-none focus:border-cyan-500 font-mono" oninput="calcToUsd()">
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] font-bold uppercase tracking-widest text-neutral-500">Dollars (USD)</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-cyan-500 font-bold">$</span>
                                    <input type="number" id="calc-usd" placeholder="USD" class="w-full bg-white/80 border border-neutral-300 rounded-xl pl-8 pr-4 py-3 text-neutral-900 focus:outline-none focus:border-cyan-500 font-mono" oninput="calcToPts()">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Leaderboard -->
