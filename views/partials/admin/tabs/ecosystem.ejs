<section id="tab-ecosystem" class="hide-section flex flex-col gap-10">
                <div class="flex flex-col gap-1 animate-fade-in">
                    <h2 class="text-4xl font-heading font-black text-neutral-900 tracking-tight">Ecosystem</h2>
                    <p class="text-neutral-500 text-sm">Global variables, dynamic store pricing, quests builder, and broadcasts.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 animate-fade-in stagger-2">
                    
                    <!-- Global Settings -->
                    <form action="/admin/settings" method="POST" class="glass-panel p-8 flex flex-col gap-6">
                        <h3 class="font-heading font-bold text-xl text-neutral-900">Global State</h3>
                        
                        <div class="flex justify-between items-center bg-white/60 p-4 rounded-xl border border-neutral-200">
                            <div class="flex flex-col">
                                <label class="text-sm font-bold text-neutral-900">Maintenance Mode</label>
                                <span class="text-[10px] text-neutral-500">Blocks all client access</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="maintenance" class="sr-only peer" <%= settings.maintenance ? 'checked' : '' %>>
                                <div class="w-12 h-6 bg-neutral-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                            </label>
                        </div>

                        <div class="flex justify-between items-center bg-white/60 p-4 rounded-xl border border-neutral-200">
                            <div class="flex flex-col">
                                <label class="text-sm font-bold text-neutral-900">Allow Withdrawals</label>
                                <span class="text-[10px] text-neutral-500">Toggle payout engine</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="withdrawals" class="sr-only peer" <%= settings.withdrawals ? 'checked' : '' %>>
                                <div class="w-12 h-6 bg-neutral-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            </label>
                        </div>
                        
                        <div class="flex justify-between items-center bg-white/60 p-4 rounded-xl border border-neutral-200">
                            <div class="flex flex-col">
                                <label class="text-sm font-bold text-neutral-900">Automatic X Verification</label>
                                <span class="text-[10px] text-neutral-500">Enable automatic tier verification via X API</span>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" name="auto_x_verify" class="sr-only peer" <%= settings.auto_x_verify ? 'checked' : '' %>>
                                <div class="w-12 h-6 bg-neutral-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500"></div>
                            </label>
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-neutral-500 uppercase tracking-widest">X API Bearer Token</label>
                            <input type="password" name="x_api_key" value="<%= settings.x_api_key || '' %>" placeholder="Enter Bearer Token..." class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:outline-none focus:border-cyan-500 font-mono text-sm">
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <label class="text-xs font-bold text-neutral-500 uppercase tracking-widest">Base Reward Per Ad (PTS)</label>
                            <input type="number" name="reward_per_ad" value="<%= settings.reward_per_ad || 3 %>" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:outline-none focus:border-violet-500 font-mono">
                        </div>
                        
                        <button type="submit" class="w-full bg-violet-600 hover:bg-violet-500 text-neutral-900 font-bold py-4 rounded-xl shadow-[0_0_20px_rgba(139,92,246,0.3)] transition-all uppercase tracking-widest text-xs mt-2">Commit State</button>
                    </form>

                    <!-- Store Pricing -->
                    <form action="/admin/store-config" method="POST" class="glass-panel p-8 flex flex-col gap-6">
                        <h3 class="font-heading font-bold text-xl text-neutral-900">Store Config</h3>
                        <div class="flex flex-col gap-4 max-h-[500px] overflow-y-auto pr-2">
                            <% const storeItems = [
                                { id: 'cooldown', label: 'Cooldown Reset', val: storeConfig.cooldown, enabled: storeConfig.enable_cooldown },
                                { id: 'multiplier', label: '2x Multiplier', val: storeConfig.multiplier, enabled: storeConfig.enable_multiplier }
                            ]; %>
                            <% storeItems.forEach(item => { %>
                            <div class="flex flex-col gap-2 bg-white/60 p-4 rounded-xl border border-neutral-200">
                                <div class="flex justify-between items-center">
                                    <label class="text-xs font-bold text-neutral-600 uppercase"><%= item.label %></label>
                                    <input type="checkbox" name="enable_<%= item.id %>" class="w-4 h-4 accent-violet-500" <%= item.enabled !== false ? 'checked' : '' %>>
                                </div>
                                <input type="number" name="<%= item.id %>" value="<%= item.val %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-3 py-2 text-neutral-900 font-mono text-sm focus:border-violet-500 focus:outline-none">
                            </div>
                            <% }) %>

                            <!-- Premium Tier Packages -->
                            <div class="border-t border-neutral-300 pt-4 mt-2">
                                <div class="flex justify-between items-center mb-4">
                                    <h4 class="text-xs font-bold text-violet-500 uppercase tracking-widest">Premium Tier Packages</h4>
                                    <input type="checkbox" name="enable_premium" class="w-4 h-4 accent-violet-500" <%= storeConfig.enable_premium !== false ? 'checked' : '' %>>
                                </div>
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">3 Month</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_3m" placeholder="PTS" value="<%= storeConfig.premium_tier_3m || 15000 %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_3m" placeholder="Stars" value="<%= storeConfig.stars_premium_3m || 25 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">3 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_3m_blue" placeholder="PTS" value="<%= storeConfig.premium_tier_3m_blue || 45000 %>" class="w-full bg-white/90 border border-violet-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_3m_blue" placeholder="Stars" value="<%= storeConfig.stars_premium_3m_blue || 50 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">6 Month</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_6m" placeholder="PTS" value="<%= storeConfig.premium_tier_6m || 28000 %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_6m" placeholder="Stars" value="<%= storeConfig.stars_premium_6m || 45 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">6 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_6m_blue" placeholder="PTS" value="<%= storeConfig.premium_tier_6m_blue || 85000 %>" class="w-full bg-white/90 border border-violet-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_6m_blue" placeholder="Stars" value="<%= storeConfig.stars_premium_6m_blue || 95 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Gold Tier Packages -->
                            <div class="border-t border-neutral-300 pt-4 mt-2">
                                <div class="flex justify-between items-center mb-4">
                                    <h4 class="text-xs font-bold text-amber-500 uppercase tracking-widest">Gold Tier Packages</h4>
                                    <input type="checkbox" name="enable_gold" class="w-4 h-4 accent-amber-500" <%= storeConfig.enable_gold !== false ? 'checked' : '' %>>
                                </div>
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">3 Month</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="gold_tier_3m" placeholder="PTS" value="<%= storeConfig.gold_tier_3m %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_gold_3m" placeholder="Stars" value="<%= storeConfig.stars_gold_3m || 100 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">3 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="gold_tier_3m_blue" placeholder="PTS" value="<%= storeConfig.gold_tier_3m_blue %>" class="w-full bg-white/90 border border-amber-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_gold_3m_blue" placeholder="Stars" value="<%= storeConfig.stars_gold_3m_blue || 120 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">6 Month</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="gold_tier_6m" placeholder="PTS" value="<%= storeConfig.gold_tier_6m %>" class="w-full bg-white/90 border border-neutral-300 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_gold_6m" placeholder="Stars" value="<%= storeConfig.stars_gold_6m || 180 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <label class="text-[10px] text-neutral-500">6 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="gold_tier_6m_blue" placeholder="PTS" value="<%= storeConfig.gold_tier_6m_blue %>" class="w-full bg-white/90 border border-amber-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_gold_6m_blue" placeholder="Stars" value="<%= storeConfig.stars_gold_6m_blue || 220 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- X Verification Pricing -->
                            <div class="border-t border-neutral-300 pt-4 mt-2 mb-2">
                                <div class="flex justify-between items-center mb-4">
                                    <h4 class="text-xs font-bold text-sky-500 uppercase tracking-widest">X Verification (Standalone)</h4>
                                </div>
                                <div class="flex flex-col gap-1">
                                    <label class="text-[10px] text-neutral-500">Stars Price</label>
                                    <input type="number" name="stars_x_verify" value="<%= storeConfig.stars_x_verify || 100 %>" class="w-32 bg-blue-50 border border-blue-200 rounded-lg px-3 py-2 text-neutral-900 font-mono text-sm">
                                </div>
                            </div>
</div>
                        <button type="submit" class="w-full bg-white text-black hover:bg-neutral-200 font-bold py-3.5 rounded-xl shadow-sm transition-all uppercase tracking-widest text-xs mt-2">Update Pricing</button>
                    </form>
                </div>

                <!-- Dynamic Quests Builder -->
                <div class="glass-panel p-8 animate-fade-in stagger-3">
                    <h3 class="font-heading font-bold text-xl text-neutral-900 mb-6">Dynamic Quests Engine</h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <!-- Create Form -->
                        <form action="/admin/quests" method="POST" class="flex flex-col gap-4">
                            <input type="hidden" name="action" value="create">
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Quest Key (No spaces)</label>
                                    <input type="text" name="key" required placeholder="e.g. follow_twitter" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs">
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Icon Emoji</label>
                                    <input type="text" name="icon" required placeholder="🐦" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 text-xs text-center">
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Quest Title</label>
                                    <input type="text" name="title" required placeholder="Follow us on Twitter" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 text-xs">
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Target URL</label>
                                    <input type="url" name="url" required placeholder="https://..." class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs">
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4 mt-2">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Quest Timer (Seconds)</label>
                                    <input type="number" name="timer" value="8" min="0" placeholder="e.g. 15" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs">
                                </div>
                                <div class="flex items-center gap-2 mt-6">
                                    <input type="checkbox" name="requires_comment_link" id="requires_comment_link" class="w-4 h-4 rounded border-neutral-300 text-cyan-500 focus:ring-cyan-500">
                                    <label for="requires_comment_link" class="text-xs font-bold text-neutral-700">Require X Comment Link</label>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">User Limit (0 for unlimited)</label>
                                    <input type="number" name="max_participants" value="0" min="0" placeholder="100" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs">
                                </div>
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Reward PTS</label>
                                    <input type="number" name="pts" required placeholder="500" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs">
                                </div>
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Tier Requirement</label>
                                <select name="tier_required" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 text-xs appearance-none">
                                    <option value="Any">Any Tier</option>
                                    <option value="Premium">Premium + Gold</option>
                                    <option value="Gold">Gold Only</option>
                                </select>
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Target Countries (Comma separated, empty for global)</label>
                                <input type="text" name="target_countries" placeholder="US, UK, NG" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-4 py-3 text-neutral-900 focus:border-cyan-500 font-mono text-xs uppercase">
                            </div>
                            <label class="flex items-center gap-3 mt-2 bg-white/60 p-3 rounded-xl border border-neutral-200 cursor-pointer hover:border-cyan-500/50 transition-colors">
                                <input type="checkbox" name="is_telegram" class="w-4 h-4 accent-cyan-500">
                                <span class="text-xs font-bold text-neutral-900">This is a Telegram joining task</span>
                            </label>
                            
                            <button type="submit" class="w-full bg-cyan-600 hover:bg-cyan-500 text-neutral-900 font-bold py-3.5 rounded-xl transition-all uppercase tracking-widest text-xs mt-2 shadow-[0_0_15px_rgba(6,182,212,0.3)]">Deploy Quest</button>
                        </form>

                        <!-- Active Quests List -->
                        <div class="flex flex-col gap-3 max-h-[500px] overflow-y-auto pr-2">
                            <% const qObj = typeof dynamicQuests !== 'undefined' ? dynamicQuests : {}; %>
                            <% const qKeys = Object.keys(qObj); %>
                            <% if (qKeys.length > 0) { %>
                                <% qKeys.forEach(k => { const q = qObj[k]; %>
                                    <div class="bg-white/70 p-4 rounded-xl border border-neutral-200 flex flex-col gap-3 relative overflow-hidden">
                                        <% if (q.is_telegram) { %><div class="absolute right-0 top-0 w-16 h-16 bg-blue-500/20 blur-[20px] rounded-full pointer-events-none"></div><% } %>
                                        <div class="flex justify-between items-start">
                                            <div class="flex items-center gap-3">
                                                <span class="text-2xl"><%= q.icon %></span>
                                                <div class="flex flex-col">
                                                    <h4 class="font-bold text-neutral-900 text-sm"><%= q.title %></h4>
                                                    <span class="text-[10px] text-cyan-400 font-mono">+<%= q.pts %> PTS | Tier: <%= q.tier_required %> | Users: <%= q.current_participants || 0 %>/<%= q.max_participants || '∞' %></span>
                                                </div>
                                            </div>
                                            <form action="/admin/quests" method="POST">
                                                <input type="hidden" name="action" value="delete">
                                                <input type="hidden" name="key" value="<%= k %>">
                                                <button type="submit" class="text-rose-400 hover:text-rose-300 bg-rose-500/10 px-2 py-1 rounded text-[10px] font-bold border border-rose-500/20">Delete</button>
                                            </form>
                                        </div>
                                        <div class="flex flex-wrap gap-2 text-[9px] font-mono text-neutral-500 uppercase">
                                            <span>Key: <%= k %></span>
                                            <% if (q.target_countries && q.target_countries.length > 0) { %>
                                                <span class="text-amber-400 border border-amber-500/20 bg-amber-500/10 px-1.5 py-0.5 rounded"><%= q.target_countries.join(', ') %></span>
                                            <% } else { %>
                                                <span class="text-emerald-400 border border-emerald-500/20 bg-emerald-500/10 px-1.5 py-0.5 rounded">Global</span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-xs text-neutral-500 italic flex items-center justify-center h-full border border-dashed border-neutral-300 rounded-xl bg-black/10">No active dynamic quests.</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Broadcast Engine -->
                <div class="glass-panel p-8 animate-fade-in stagger-4 relative overflow-hidden">
                    <div class="absolute right-0 top-0 w-64 h-64 bg-rose-600/10 blur-[60px] rounded-full pointer-events-none"></div>
                    <h3 class="font-heading font-bold text-xl text-neutral-900 mb-6">Broadcast Engine</h3>
                    <div class="flex flex-col gap-4 relative z-10">
                        <form action="/admin/broadcast" method="POST" id="broadcast-form" class="w-full">
                            <textarea name="message_text" rows="4" placeholder="Enter HTML message payload here... (Sends to all <%= stats.users %> users)" class="w-full bg-white/80 border border-neutral-300 rounded-xl px-5 py-4 text-neutral-900 focus:outline-none focus:border-rose-500 transition-colors font-mono text-sm resize-none"></textarea>
                        </form>
                        <div class="flex justify-end gap-4">
                            <form action="/admin/wakeup-push" method="POST">
                                <button type="submit" onclick="return confirm('Send wake-up pings to inactive users?')" class="glass-btn text-amber-400 font-bold px-6 py-3 rounded-xl uppercase tracking-widest text-xs">Ping Inactive</button>
                            </form>
                            <button type="submit" form="broadcast-form" onclick="return confirm('WARNING: Pushing broadcast to ALL users. Execute?')" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-8 py-3 rounded-xl shadow-[0_0_20px_rgba(225,29,72,0.4)] transition-all uppercase tracking-widest text-xs">Execute Broadcast</button>
                        </div>
                    </div>
                </div>

            </section>