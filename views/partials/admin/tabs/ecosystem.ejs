                                            <input type="number" name="stars_gold_6m_blue" placeholder="Stars" value="<%= storeConfig.stars_gold_6m_blue || 220 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
