                                <div class="flex items-center gap-4">
                                    <span class="text-sm font-heading font-black <%= index < 3 ? 'text-amber-400 drop-shadow-[0_0_5px_rgba(251,191,36,0.5)]' : 'text-neutral-500' %> w-6">#<%= index + 1 %></span>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-neutral-900 text-sm">@<%= u.username || 'Anon' %></span>
                                        <span class="text-[10px] text-neutral-500 font-mono"><%= u.telegram_id %></span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="font-mono font-bold text-emerald-400 hidden md:block"><%= u.points_balance.toLocaleString() %> PTS</span>
                                    <a href="/admin/user-lookup?q=<%= u.telegram_id %>" class="glass-btn px-3 py-1.5 rounded-lg text-[10px] font-bold text-neutral-900 uppercase hover:text-cyan-400">Inspect</a>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>

            <!-- TAB: ECOSYSTEM (Config, Store, Quests, Broadcast) -->
