                                        <label class="text-[10px] text-neutral-500">6 Month + X Blue Tick</label>
                                        <div class="flex gap-2">
                                            <input type="number" name="premium_tier_6m_blue" placeholder="PTS" value="<%= storeConfig.premium_tier_6m_blue || 85000 %>" class="w-full bg-white/90 border border-violet-500/30 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="PTS Price">
                                            <input type="number" name="stars_premium_6m_blue" placeholder="Stars" value="<%= storeConfig.stars_premium_6m_blue || 95 %>" class="w-20 bg-blue-50 border border-blue-200 rounded-lg px-2 py-2 text-neutral-900 font-mono text-xs" title="Stars Price">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Gold Tier Packages -->
                            <div class="border-t border-neutral-300 pt-4 mt-2">
