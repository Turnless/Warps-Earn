<!-- MOBILE TOP BAR -->
    <div class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-white/60 backdrop-blur-xl border-b border-neutral-200 z-[60] flex items-center justify-between px-4">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-neutral-800 to-neutral-950 flex items-center justify-center text-neutral-900 text-sm shadow-md">
                <span>⚡</span>
            </div>
            <span class="font-bold text-neutral-900 tracking-tight uppercase text-sm">Command Center</span>
        </div>
        <button onclick="toggleMobileSidebar()" class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-xl text-neutral-900 shadow-sm border border-neutral-200 hover:bg-neutral-50">
            ☰
        </button>
    </div>

    <!-- MOBILE OVERLAY -->
    <div id="mobile-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-white/80 backdrop-blur-sm z-[65] hidden lg:hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGATION -->
    <aside id="sidebar" class="sidebar w-64 fixed h-screen flex flex-col justify-between py-8 px-6 z-[70] transform -translate-x-full lg:translate-x-0 transition-transform duration-300 top-0 left-0">
        <div class="flex flex-col gap-10">
            <!-- Logo area -->
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-neutral-900 text-xl shadow-[0_0_20px_rgba(139,92,246,0.4)] relative">
                    <div class="absolute inset-0 rounded-2xl bg-white/20 blur-sm"></div>
                    <span class="relative z-10">⚡</span>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-xl font-heading font-black text-neutral-900 tracking-tight leading-none">WARPS</h1>
                    <span class="text-xs text-indigo-400 font-semibold tracking-widest uppercase mt-1">Control</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex flex-col gap-2 relative">
                <button onclick="switchTab('tab-dashboard')" id="nav-dashboard" class="nav-item active px-4 py-3.5 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">📈</span> Overview
                </button>
                
                <div class="mt-4 mb-2">
                    <span class="text-[10px] font-bold text-neutral-600 uppercase tracking-widest px-4">Action Center</span>
                </div>
                
                <button onclick="switchTab('tab-approvals')" id="nav-approvals" class="nav-item px-4 py-3.5 rounded-xl flex items-center justify-between text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <div class="flex items-center gap-4">
                        <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">✅</span> Approvals
                    </div>
                    <% const totalPending = stats.pending + (pendingBounties ? pendingBounties.length : 0) + (typeof pendingStoreOrders !== 'undefined' ? pendingStoreOrders.length : 0); %>
                    <% if (totalPending > 0) { %>
                        <span class="bg-amber-500/20 border border-amber-500/50 text-amber-400 px-2 py-0.5 rounded text-[10px] font-mono badge-glow-amber"><%= totalPending %></span>
                    <% } %>
                </button>

                <div class="mt-4 mb-2">
                    <span class="text-[10px] font-bold text-neutral-600 uppercase tracking-widest px-4">Management</span>
                </div>

                <button onclick="switchTab('tab-users')" id="nav-users" class="nav-item px-4 py-3.5 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">👥</span> Intelligence
                </button>
                <button onclick="switchTab('tab-ecosystem')" id="nav-ecosystem" class="nav-item px-4 py-3.5 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">⚙️</span> Ecosystem
                </button>
            </nav>
        </div>

        <a href="/admin/logout" class="glass-btn w-full text-center py-4 rounded-xl text-xs font-bold uppercase tracking-widest text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-2">
            <span>⏏</span> Disconnect
        </a>
    </aside>
