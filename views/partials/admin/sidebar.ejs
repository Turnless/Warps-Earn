<%
    // Counts drive the queue badges, so the nav shows where work is waiting.
    var payoutCount = stats.pending || 0;
    var reviewCount = (typeof pendingBounties !== 'undefined' ? pendingBounties.length : 0)
                    + (typeof pendingStoreOrders !== 'undefined' ? pendingStoreOrders.length : 0)
                    + (typeof questSubmissions !== 'undefined' ? questSubmissions.length : 0)
                    + (typeof pendingXVerifications !== 'undefined' ? pendingXVerifications.length : 0);
%>
<!-- MOBILE TOP BAR -->
    <div class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-white/60 backdrop-blur-xl border-b border-neutral-200 z-[60] flex items-center justify-between px-4">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-neutral-800 to-neutral-950 flex items-center justify-center text-white text-sm shadow-md">
                <span>⚡</span>
            </div>
            <span class="font-bold text-neutral-900 tracking-tight text-sm">Warps Admin</span>
        </div>
        <div class="flex items-center gap-2">
            <% if (payoutCount + reviewCount > 0) { %>
                <span class="bg-amber-500/20 border border-amber-500/50 text-amber-700 px-2 py-1 rounded text-[10px] font-mono font-bold"><%= payoutCount + reviewCount %></span>
            <% } %>
            <button onclick="toggleMobileSidebar()" class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-xl text-neutral-900 shadow-sm border border-neutral-200 hover:bg-neutral-50">
                ☰
            </button>
        </div>
    </div>

    <!-- MOBILE OVERLAY -->
    <div id="mobile-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-white/80 backdrop-blur-sm z-[65] hidden lg:hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGATION -->
    <aside id="sidebar" class="sidebar w-64 fixed h-screen flex flex-col justify-between py-8 px-6 z-[70] transform -translate-x-full lg:translate-x-0 transition-transform duration-300 top-0 left-0 overflow-y-auto">
        <div class="flex flex-col gap-8">
            <!-- Logo area -->
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-white text-xl shadow-[0_0_20px_rgba(139,92,246,0.4)] relative">
                    <div class="absolute inset-0 rounded-2xl bg-white/20 blur-sm"></div>
                    <span class="relative z-10">⚡</span>
                </div>
                <div class="flex flex-col">
                    <h1 class="text-xl font-heading font-black text-neutral-900 tracking-tight leading-none">WARPS</h1>
                    <span class="text-xs text-indigo-400 font-semibold tracking-widest uppercase mt-1">Admin</span>
                </div>
            </div>

            <nav class="flex flex-col gap-1 relative">

                <!-- Things you check or clear every day -->
                <div class="mb-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest px-4">Daily</span>
                </div>

                <button onclick="switchTab('tab-overview')" id="nav-overview" class="nav-item active px-4 py-3 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">📈</span> Overview
                </button>

                <button onclick="switchTab('tab-payouts')" id="nav-payouts" class="nav-item px-4 py-3 rounded-xl flex items-center justify-between text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <div class="flex items-center gap-4">
                        <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">💸</span> Payouts
                    </div>
                    <% if (payoutCount > 0) { %>
                        <span class="bg-rose-500/20 border border-rose-500/50 text-rose-700 px-2 py-0.5 rounded text-[10px] font-mono font-bold"><%= payoutCount %></span>
                    <% } %>
                </button>

                <button onclick="switchTab('tab-review')" id="nav-review" class="nav-item px-4 py-3 rounded-xl flex items-center justify-between text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <div class="flex items-center gap-4">
                        <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">📥</span> Review
                    </div>
                    <% if (reviewCount > 0) { %>
                        <span class="bg-amber-500/20 border border-amber-500/50 text-amber-700 px-2 py-0.5 rounded text-[10px] font-mono badge-glow-amber font-bold"><%= reviewCount %></span>
                    <% } %>
                </button>

                <!-- Things you change occasionally -->
                <div class="mt-5 mb-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest px-4">Manage</span>
                </div>

                <button onclick="switchTab('tab-users')" id="nav-users" class="nav-item px-4 py-3 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">👥</span> Users
                </button>

                <button onclick="switchTab('tab-content')" id="nav-content" class="nav-item px-4 py-3 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">🎯</span> Tasks
                </button>

                <button onclick="switchTab('tab-economy')" id="nav-economy" class="nav-item px-4 py-3 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">⚖️</span> Economy
                </button>

                <!-- Rare, high blast radius, or diagnostic -->
                <div class="mt-5 mb-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest px-4">Platform</span>
                </div>

                <button onclick="switchTab('tab-messaging')" id="nav-messaging" class="nav-item px-4 py-3 rounded-xl flex items-center justify-between text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <div class="flex items-center gap-4">
                        <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">📣</span> Messaging
                    </div>
                    <span class="text-[9px] text-rose-500 font-bold uppercase tracking-wider">All users</span>
                </button>

                <button onclick="switchTab('tab-system')" id="nav-system" class="nav-item px-4 py-3 rounded-xl flex items-center gap-4 text-sm font-semibold text-neutral-500 hover:text-neutral-900 group">
                    <span class="text-lg opacity-80 group-hover:opacity-100 transition-opacity">🔧</span> System
                </button>
            </nav>
        </div>

        <div class="flex flex-col gap-3 mt-8">
            <% if (settings && settings.maintenance) { %>
                <div class="bg-rose-500/10 border border-rose-500/40 text-rose-700 rounded-xl px-4 py-3 text-[10px] font-bold uppercase tracking-widest text-center">
                    ⚠️ Maintenance mode is ON
                </div>
            <% } %>
            <% if (settings && settings.withdrawals === false) { %>
                <div class="bg-amber-500/10 border border-amber-500/40 text-amber-700 rounded-xl px-4 py-3 text-[10px] font-bold uppercase tracking-widest text-center">
                    ⚠️ Withdrawals are OFF
                </div>
            <% } %>
            <a href="/admin/logout" class="glass-btn w-full text-center py-4 rounded-xl text-xs font-bold uppercase tracking-widest text-neutral-600 hover:text-neutral-900 flex items-center justify-center gap-2">
                <span>⏏</span> Log out
            </a>
        </div>
    </aside>
