                        <div class="flex flex-col gap-1 bg-neutral-50 p-3 rounded-xl border border-neutral-100">
                            <span class="text-neutral-500 font-medium">Sending to:</span>
                            <p id="confirm-display-destination" class="font-bold text-neutral-900 text-[11px] break-all mono-text bg-white p-2 rounded-lg border border-neutral-200/60 mt-1 select-all"></p>
                        </div>

                        <div id="confirm-display-conversion-box" class="flex justify-between items-center bg-emerald-50 text-emerald-800 p-2.5 rounded-xl border border-emerald-100 font-bold mono-text">
