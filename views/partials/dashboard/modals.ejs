<!-- 🍞 PREMIUM TOAST NOTIFICATION -->
<div id="custom-toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] transform -translate-y-24 opacity-0 transition-all duration-300 bg-neutral-950 text-[#e6ddd0] px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 border border-neutral-800 text-xs font-bold uppercase tracking-wider mono-text w-[calc(100%-32px)] max-w-[418px]">
    <span id="toast-icon">⚡</span>
    <span id="toast-message">Verification Complete</span>
</div>

<!-- 🛡️ CUSTOM TRANSACTION CONFIRMATION MODAL -->
<div id="custom-confirm-modal" class="hidden fixed inset-0 z-[160] bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white rounded-3xl p-6 border border-neutral-200 shadow-2xl flex flex-col gap-4 text-neutral-900">
        <div class="flex items-center gap-2 pb-2 border-b border-neutral-100">
            <span class="text-lg">🛡️</span>
            <h3 class="font-bold text-xs uppercase tracking-wider text-neutral-400 mono-text">Confirm Withdrawal</h3>
        </div>

        <div class="flex flex-col gap-3 text-xs leading-normal">
            <div class="flex justify-between items-center bg-neutral-50 p-2.5 rounded-xl border border-neutral-100">
                <span class="text-neutral-500 font-medium">Payment Method:</span>
                <span id="confirm-display-asset" class="font-bold text-neutral-900 mono-text">USDT (BEP20)</span>
            </div>

            <div class="flex justify-between items-center bg-neutral-50 p-2.5 rounded-xl border border-neutral-100">
                <span class="text-neutral-500 font-medium">Amount:</span>
                <span id="confirm-display-pts" class="font-bold text-neutral-900 mono-text">1,500 PTS</span>
            </div>

            <div class="flex flex-col gap-1 bg-neutral-50 p-3 rounded-xl border border-neutral-100">
                <span class="text-neutral-500 font-medium">Sending to:</span>
                <p id="confirm-display-destination" class="font-bold text-neutral-900 text-[11px] break-all mono-text bg-white p-2 rounded-lg border border-neutral-200/60 mt-1 select-all"></p>
            </div>

            <div id="confirm-display-conversion-box" class="flex justify-between items-center bg-emerald-50 text-emerald-800 p-2.5 rounded-xl border border-emerald-100 font-bold mono-text">
                <span>You'll receive:</span>
                <span id="confirm-display-conversion">$1.20 USD</span>
            </div>
        </div>

        <div class="p-3 bg-amber-50 border border-amber-200 rounded-2xl flex gap-2 text-[10px] text-amber-800 leading-normal font-medium">
            <span class="text-xs">⚠️</span>
            <span>Double-check your details. Points are deducted immediately and can't be reversed.</span>
        </div>

        <div class="grid grid-cols-2 gap-2 mt-2">
            <button type="button" onclick="closeConfirmModal()" class="py-3 border border-neutral-200 hover:bg-neutral-50 rounded-xl font-bold text-xs uppercase text-neutral-500 tracking-wider transition-all shadow-sm">Cancel</button>
            <button type="button" id="btn-modal-action-confirm" class="py-3 bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] rounded-xl font-bold text-xs uppercase tracking-wider transition-all shadow-md">Confirm</button>
        </div>
    </div>
</div>

<div id="fallback-player-modal" class="hidden fixed inset-0 z-[150] bg-neutral-950/90 backdrop-blur-md flex flex-col justify-between p-6 max-w-md mx-auto">
    <div class="w-full flex justify-between items-center">
        <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
            <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider mono-text">Watching Ad</span>
        </div>
        <button id="fallback-close-btn" disabled class="bg-neutral-800 text-neutral-500 font-bold text-[11px] px-3 py-1.5 rounded-xl uppercase tracking-wider transition-all cursor-not-allowed">Wait 15s</button>
    </div>

    <div class="w-full h-3/4 my-4 bg-black rounded-3xl border border-neutral-800/80 overflow-hidden relative shadow-inner">
        <div id="fallback-loading-spinner" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-[#e6ddd0]">
            <div class="w-10 h-10 border-4 border-[#e6ddd0]/30 border-t-[#e6ddd0] rounded-full animate-spin"></div>
            <p class="text-[10px] uppercase tracking-widest font-bold text-neutral-400 mono-text">Loading ad...</p>
        </div>
        <iframe id="fallback-ad-iframe" class="w-full h-full border-0 hidden" sandbox="allow-scripts allow-popups allow-same-origin"></iframe>
    </div>

    <div class="w-full text-center flex flex-col gap-2">
        <p id="fallback-countdown-text" class="text-sm font-medium text-neutral-300">Watch the ad to earn your points.</p>
        <div class="w-full bg-neutral-900 rounded-full h-1 border border-neutral-800 overflow-hidden">
            <div id="fallback-progress-bar" class="bg-emerald-500 h-1 rounded-full transition-all duration-1000" style="width: 100%"></div>
        </div>
    </div>
</div>

<!-- 🎯 BOUNTY SUBMISSION MODAL -->
<div id="bounty-modal" class="fixed inset-0 z-50 hidden flex-col justify-end bg-neutral-950/80 backdrop-blur-sm transition-opacity">
    <div class="bg-white w-full max-w-md mx-auto rounded-t-3xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
        <div class="px-5 py-4 border-b border-neutral-100 flex justify-between items-center bg-indigo-50/30">
            <div class="flex items-center gap-2">
                <span class="text-lg">🎯</span>
                <h3 class="font-black text-neutral-900 tracking-tight" id="bounty-modal-title">Complete Task</h3>
            </div>
            <button onclick="closeBountyModal()" class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-500 font-bold active:scale-95">✕</button>
        </div>
        
        <div class="p-5 overflow-y-auto flex-1 flex flex-col gap-4">
            <div class="flex justify-between items-center p-3 bg-neutral-50 rounded-xl border border-neutral-200">
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase font-bold text-neutral-400">Reward</span>
                    <span id="bounty-modal-reward" class="text-sm font-black text-emerald-600 mono-text"></span>
                </div>
                <div class="flex flex-col text-right">
                    <span class="text-[10px] uppercase font-bold text-neutral-400">Action</span>
                    <span id="bounty-modal-action" class="text-xs font-bold text-indigo-700 uppercase bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100"></span>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-neutral-800">1. Open the target link</span>
                <button id="bounty-modal-link-btn" class="w-full bg-neutral-900 text-white font-bold text-xs py-3 rounded-xl shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                    Open Target Link ↗
                </button>
            </div>

            <div class="flex flex-col gap-2">
                <span class="text-xs font-bold text-neutral-800">2. Submit Proof (Comment Link)</span>
                <input type="text" id="bounty-proof-input" placeholder="Paste link to your comment/reply here..." class="w-full px-4 py-3 bg-neutral-50 border border-neutral-300 rounded-xl text-xs focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                <p class="text-[10px] text-neutral-500">Only submit the direct link to your reply. Fake or invalid links will result in a <strong class="text-rose-600">strike penalty</strong>.</p>
            </div>
        </div>

        <div class="p-5 border-t border-neutral-100 bg-neutral-50">
            <input type="hidden" id="bounty-modal-id">
            <button onclick="submitBountyProof()" id="btn-submit-bounty" class="w-full bg-indigo-600 text-white font-bold text-sm py-3.5 rounded-xl shadow-md hover:bg-indigo-700 active:scale-[0.98] transition-all uppercase tracking-wider">Submit for Verification</button>
        </div>
    </div>
</div>

<!-- 🛒 STORE PURCHASE CONFIRMATION MODAL -->
<div id="store-confirm-modal" class="hidden fixed inset-0 z-[160] bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white rounded-3xl p-6 border border-neutral-200 shadow-2xl flex flex-col gap-4 text-neutral-900">
        <div class="flex items-center gap-2 pb-2 border-b border-neutral-100">
            <span class="text-lg">🛒</span>
            <h3 class="font-bold text-xs uppercase tracking-wider text-neutral-400 mono-text">Confirm Purchase</h3>
        </div>

        <div class="flex flex-col gap-3 my-2">
            <div class="flex justify-between items-center">
                <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest mono-text">Item</span>
                <span id="store-modal-item" class="text-xs font-black text-neutral-900"></span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest mono-text">Cost</span>
                <span id="store-modal-cost" class="text-xs font-black text-rose-600 mono-text"></span>
            </div>
        </div>

        <p id="store-modal-desc" class="text-[10px] text-neutral-500 text-center leading-relaxed"></p>

        <div class="flex flex-col gap-2 mt-2 w-full">
            <button id="btn-store-confirm-pts" class="w-full py-3.5 rounded-xl bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] font-bold text-xs shadow-md uppercase tracking-wider active:scale-95 transition-all flex items-center justify-center gap-2">
                Pay with PTS <span id="store-modal-pts-badge" class="bg-white/20 px-2 py-0.5 rounded text-[10px] mono-text"></span>
            </button>
            <button id="btn-store-confirm-stars" class="w-full bg-[#2AABEE] hover:bg-[#229ED9] text-white font-bold text-xs py-3.5 rounded-xl shadow-md uppercase tracking-wider active:scale-95 transition-all flex items-center justify-center gap-2">
                Pay with Telegram Stars <span id="store-modal-stars-badge" class="bg-white/20 px-2 py-0.5 rounded text-[10px] mono-text"></span>
            </button>
            <button onclick="closeStoreModal()" class="w-full mt-1 py-3 rounded-xl border border-transparent text-neutral-500 font-bold text-xs uppercase tracking-wider hover:bg-neutral-50 active:scale-95 transition-all">Cancel</button>
        </div>
    </div>
</div>