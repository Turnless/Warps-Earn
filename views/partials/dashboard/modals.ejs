                                    <div class="w-9 h-5 bg-amber-700/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-500"></div>
                                </label>
                                <span class="text-[10px] font-bold text-amber-950 uppercase tracking-widest leading-tight">Add X Blue Tick <span class="inline-block">✓</span><br><span class="text-amber-800 lowercase tracking-normal font-medium">(Verified via Partner)</span></span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 mt-2 relative z-10">
                                <button onclick="promptStorePurchase('gold_tier_3m')" class="bg-amber-900/60 hover:bg-amber-800 text-amber-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-amber-700/50 flex flex-col items-center">
                                    <span>3 Months</span>
                                    <span id="price-gold-3m" class="text-[9px] text-amber-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.gold_tier_3m) || 50000).toLocaleString() %> PTS</span>
                                </button>
                                <button onclick="promptStorePurchase('gold_tier_6m')" class="bg-amber-900/60 hover:bg-amber-800 text-amber-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-amber-700/50 flex flex-col items-center">
                                    <span>6 Months</span>
                                    <span id="price-gold-6m" class="text-[9px] text-amber-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.gold_tier_6m) || 90000).toLocaleString() %> PTS</span>
                                </button>
                            </div>
                            <div class="mt-2 relative z-10 flex justify-center border-t border-amber-400/30 pt-2">
                                <button onclick="purchaseWithStars('gold_tier', <%= locals.storeConfig?.stars_gold || 150 %>)" class="w-full bg-[#2AABEE] hover:bg-[#229ED9] text-white font-bold text-xs py-2.5 rounded-xl shadow-md active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                    <span>Pay with Telegram Stars</span>
                                    <span class="bg-white/20 px-2 py-0.5 rounded text-[10px] mono-text">🌟 <%= locals.storeConfig?.stars_gold || 150 %></span>
                                </button>
                            </div>
                            <div class="mt-2 relative z-10 flex justify-center border-t border-amber-400/30 pt-2">
                                <button onclick="purchaseWithStars('x_verify', <%= locals.storeConfig?.stars_x_verify || 100 %>)" class="w-full bg-neutral-900 hover:bg-neutral-800 text-white font-bold text-[10px] py-2 rounded-xl shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                    <span>X Verification Pack</span>
                                    <span class="bg-white/20 px-1.5 py-0.5 rounded text-[9px] mono-text">🌟 <%= locals.storeConfig?.stars_x_verify || 100 %></span>
                                </button>
                            </div>
                            <% } else if (hasPendingGold) { %>
                                <button disabled class="w-full bg-amber-900/50 text-amber-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-amber-700/50 mt-4">
                                    Upgrade Pending Verification ⏳
                                </button>
                            <% } else { 
                                const daysLeft = user.tier_expires_at ? Math.ceil((new Date(user.tier_expires_at) - new Date()) / (1000 * 60 * 60 * 24)) : 0;
                            %>
                                <button disabled class="w-full bg-amber-900/50 text-amber-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-amber-700/50 mt-4">
                                    You are already Gold
                                    <% if (daysLeft > 0) { %><br><span class="text-[10px] text-amber-400"><%= daysLeft %> days left</span><% } %>
                                </button>
                            <% } %>
                        </div>
                        <% } %>
                    </div>

                    <!-- BOOSTS -->
                    <div class="w-full bg-white/70 backdrop-blur-md rounded-3xl p-5 shadow-sm border border-neutral-300/80 mt-1">
                        <h3 class="font-bold text-sm text-neutral-800 mb-3">Utility Boosts</h3>
                        <div class="flex flex-col gap-4">
                        <% if ((locals.storeConfig && locals.storeConfig.enable_cooldown) !== false) { %>
                        <div class="flex justify-between items-center pb-4 border-b border-neutral-200">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-neutral-800">Instant Cooldown Reset</span>
                                <span class="text-[10px] text-neutral-500 mt-0.5">Skip the 45s wait between ad blocks</span>
                            </div>
                            <button onclick="promptStorePurchase('cooldown')" class="bg-neutral-900 text-white text-[10px] font-bold px-3 py-2 rounded-lg shrink-0"><%= ((locals.storeConfig && locals.storeConfig.cooldown) || 500).toLocaleString() %> PTS</button>
                        </div>
                        <% } %>
                        <% if ((locals.storeConfig && locals.storeConfig.enable_multiplier) !== false) { %>
                        <div class="flex justify-between items-center">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-neutral-800">2x Yield Multiplier</span>
                                <span class="text-[10px] text-neutral-500 mt-0.5">Double your ad earnings for 1 Month</span>
                            </div>
                            <button onclick="promptStorePurchase('multiplier')" class="bg-neutral-900 text-white text-[10px] font-bold px-3 py-2 rounded-lg shrink-0"><%= ((locals.storeConfig && locals.storeConfig.multiplier) || 3000).toLocaleString() %> PTS</button>
                        </div>
                        <% } %>
                    </div>
                </div>
            </main>

            <!-- 📱 NAVIGATION BAR WITH NOTIFICATION BADGE -->
            <nav class="bg-white/80 backdrop-blur-md border border-neutral-300/80 rounded-2xl p-1.5 grid grid-cols-5 gap-1 shadow-md">
                <button onclick="switchTab('home')" id="tab-home" class="active-tab py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all">
                    <span class="text-base">🏠</span>
                    <span class="text-[10px] font-bold tracking-tight">Home</span>
                </button>

                <button onclick="switchTab('tasks')" id="tab-tasks" class="text-neutral-500 hover:text-neutral-900 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all relative">
                    <span class="text-base">📋</span>
                    <span class="text-[10px] font-bold tracking-tight">Tasks</span>
                    <% if (incompleteCount> 0) { %>
                        <span id="task-nav-badge" class="absolute top-1 right-2 bg-rose-500 text-white text-[8px] font-extrabold h-4 w-4 rounded-full flex items-center justify-center border border-white animate-pulse shadow-sm mono-text">
                            <%= incompleteCount %>
                        </span>
                    <% } %>
                </button>

                <button onclick="switchTab('store')" id="tab-store" class="text-neutral-500 hover:text-neutral-900 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all">
                    <span class="text-base">🛒</span>
                    <span class="text-[10px] font-bold tracking-tight">Store</span>
                </button>

                <button onclick="switchTab('invite')" id="tab-invite" class="text-neutral-500 hover:text-neutral-900 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all">
                    <span class="text-base">🤝</span>
                    <span class="text-[10px] font-bold tracking-tight">Invite</span>
                </button>

                <button onclick="switchTab('wallet')" id="tab-wallet" class="text-neutral-500 hover:text-neutral-900 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all">
                    <span class="text-base">💰</span>
                    <span class="text-[10px] font-bold tracking-tight">Wallet</span>
                </button>
            </nav>

    </div>

    <!-- 🎯 BOUNTY SUBMISSION MODAL -->
    <div id="bounty-modal" class="fixed inset-0 z-50 hidden flex-col justify-end bg-neutral-950/80 backdrop-blur-sm transition-opacity">
        <div class="bg-white w-full max-w-md mx-auto rounded-t-3xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
            <div class="px-5 py-4 border-b border-neutral-100 flex justify-between items-center bg-indigo-50/30">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🎯</span>
                    <h3 class="font-black text-neutral-900 tracking-tight" id="bounty-modal-title">Complete Task</h3>
                </div>
                <button onclick="closeBountyModal()" class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-neutral-500 font-bold active:scale-95">✕</button>
            </div>
            
            <div class="p-5 overflow-y-auto flex-1 flex flex-col gap-4">
                <div class="flex justify-between items-center p-3 bg-neutral-50 rounded-xl border border-neutral-200">
                    <div class="flex flex-col">
                        <span class="text-[10px] uppercase font-bold text-neutral-400">Reward</span>
                        <span id="bounty-modal-reward" class="text-sm font-black text-emerald-600 mono-text"></span>
                    </div>
                    <div class="flex flex-col text-right">
                        <span class="text-[10px] uppercase font-bold text-neutral-400">Action</span>
                        <span id="bounty-modal-action" class="text-xs font-bold text-indigo-700 uppercase bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100"></span>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <span class="text-xs font-bold text-neutral-800">1. Open the target link</span>
                    <button id="bounty-modal-link-btn" class="w-full bg-neutral-900 text-white font-bold text-xs py-3 rounded-xl shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                        Open Target Link ↗
                    </button>
                </div>

                <div class="flex flex-col gap-2">
                    <span class="text-xs font-bold text-neutral-800">2. Submit Proof (Comment Link)</span>
                    <input type="text" id="bounty-proof-input" placeholder="Paste link to your comment/reply here..." class="w-full px-4 py-3 bg-neutral-50 border border-neutral-300 rounded-xl text-xs focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all">
                    <p class="text-[10px] text-neutral-500">Only submit the direct link to your reply. Fake or invalid links will result in a <strong class="text-rose-600">strike penalty</strong>.</p>
                </div>
            </div>

            <div class="p-5 border-t border-neutral-100 bg-neutral-50">
                <input type="hidden" id="bounty-modal-id">
                <button onclick="submitBountyProof()" id="btn-submit-bounty" class="w-full bg-indigo-600 text-white font-bold text-sm py-3.5 rounded-xl shadow-md hover:bg-indigo-700 active:scale-[0.98] transition-all uppercase tracking-wider">Submit for Verification</button>
            </div>
        </div>
    </div>

    <!-- 🛒 STORE PURCHASE CONFIRMATION MODAL -->

<div id="store-confirm-modal" class="hidden fixed inset-0 z-[160] bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="w-full max-w-sm bg-white rounded-3xl p-6 border border-neutral-200 shadow-2xl flex flex-col gap-4 text-neutral-900">
            <div class="flex items-center gap-2 pb-2 border-b border-neutral-100">
                <span class="text-lg">🛒</span>
                <h3 class="font-bold text-xs uppercase tracking-wider text-neutral-400 mono-text">Confirm Purchase</h3>
            </div>

            <div class="flex flex-col gap-3 my-2">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest mono-text">Item</span>
                    <span id="store-modal-item" class="text-xs font-black text-neutral-900"></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest mono-text">Cost</span>
                    <span id="store-modal-cost" class="text-xs font-black text-rose-600 mono-text"></span>
                </div>
            </div>

            <p id="store-modal-desc" class="text-[10px] text-neutral-500 text-center leading-relaxed"></p>

            <div class="flex gap-3 mt-2">
                <button onclick="closeStoreModal()" class="flex-1 py-3.5 rounded-xl border border-neutral-300 text-neutral-600 font-bold text-xs uppercase tracking-wider hover:bg-neutral-50 active:scale-95 transition-all">Cancel</button>
                <button id="btn-store-confirm" class="flex-1 py-3.5 rounded-xl bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] font-bold text-xs shadow-md uppercase tracking-wider active:scale-95 transition-all">Confirm</button>
            </div>
        </div>
    </div>