                    </div>
                </div>
            </div>

            <div id="fallback-player-modal" class="hidden fixed inset-0 z-[150] bg-neutral-950/90 backdrop-blur-md flex flex-col justify-between p-6 max-w-md mx-auto">
                <div class="w-full flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                        <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider mono-text">Watching Ad</span>
                    </div>
                    <button id="fallback-close-btn" disabled class="bg-neutral-800 text-neutral-500 font-bold text-[11px] px-3 py-1.5 rounded-xl uppercase tracking-wider transition-all cursor-not-allowed">Wait 15s</button>
