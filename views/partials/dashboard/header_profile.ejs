<!-- HEADER PROFILE BLOCK -->
            <header class="w-full flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-full bg-neutral-900 border-2 border-neutral-950/20 overflow-hidden flex items-center justify-center text-[#e6ddd0] font-bold text-lg relative shadow-inner">
                    <% if (user.photo_url) { %>
                        <img src="<%= user.photo_url %>" alt="pfp" class="w-full h-full object-cover">
                    <% } else { %>
                        <%= (user.username || 'A' ).substring(0, 2).toUpperCase() %>
                    <% } %>
                </div>

                <div class="flex flex-col">
                    <h1 class="text-base font-bold tracking-tight text-neutral-900 leading-tight">
                        <%= user.first_name || 'User' %>
                    </h1>
                    <span class="text-xs text-neutral-600 font-medium">@<%= user.username || 'Anonymous' %></span>
                </div>
            </header>

            <main class="w-full flex-1 flex flex-col gap-4 justify-start">

                <!-- 🏠 HOME VIEW -->