<script>
        const STORE_CONFIG = <%- JSON.stringify(locals.storeConfig || {
            cooldown: 500, multiplier: 3000,
            premium_tier_3m: 15000, premium_tier_6m: 28000,
            premium_tier_3m_blue: 45000, premium_tier_6m_blue: 85000,
            gold_tier_3m: 50000, gold_tier_6m: 90000,
            gold_tier_3m_blue: 80000, gold_tier_6m_blue: 150000
        }) %>;

        function updateGoldPrices() {
            const hasBlueTick = document.getElementById('store-bluetick-toggle').checked;
            const opt1m = document.getElementById('gold-options-1m');
            const optBlue = document.getElementById('gold-options-blue');
            if (hasBlueTick) {
                opt1m?.classList.add('hidden');
                optBlue?.classList.remove('hidden');
            } else {
                opt1m?.classList.remove('hidden');
                optBlue?.classList.add('hidden');
            }
        }

        function updatePremiumPrices() {
            const hasBlueTick = document.getElementById('store-premium-bluetick-toggle').checked;
            const opt1m = document.getElementById('premium-options-1m');
            const optBlue = document.getElementById('premium-options-blue');
            if (hasBlueTick) {
                opt1m?.classList.add('hidden');
                optBlue?.classList.remove('hidden');
            } else {
                opt1m?.classList.remove('hidden');
                optBlue?.classList.add('hidden');
            }
        }

        let currentStoreItem = null;
        let currentStoreCost = 0;

        function promptStorePurchase(itemKey, ptsParam = null, starsParam = null) {
            currentStoreItem = itemKey;
            
            // Determine blue tick state based on which tier
            let hasBlueTick = false;
            if (itemKey.startsWith('premium_tier_')) {
                const premToggle = document.getElementById('store-premium-bluetick-toggle');
                hasBlueTick = premToggle ? premToggle.checked : false;
            } else if (itemKey.startsWith('gold_tier_')) {
                const goldToggle = document.getElementById('store-bluetick-toggle');
                hasBlueTick = goldToggle ? goldToggle.checked : false;
            }
            
            let itemName = "";
            let desc = "";
            let starsCost = null;
            
            if (itemKey === 'gold_tier_1m') {
                itemName = "Gold Tier (1 Month)";
                desc = "You will upgrade to Gold Tier for 1 month.";
            } else if (itemKey === 'premium_tier_1m') {
                itemName = "Premium Tier (1 Month)";
                desc = "Unlock premium tasks and faster withdrawals for 1 month.";
            } else if (itemKey === 'gold_tier_3m_blue') {
                itemName = "Gold Tier (3 Months) + X Blue Tick ✓";
                desc = "You will upgrade to Gold Tier for 3 months and we will verify your X account with a blue tick via our partner. Your order will be pending until verification is complete.";
            } else if (itemKey === 'gold_tier_6m_blue') {
                itemName = "Gold Tier (6 Months) + X Blue Tick ✓";
                desc = "You will upgrade to Gold Tier for 6 months and we will verify your X account with a blue tick via our partner. Your order will be pending until verification is complete.";
            } else if (itemKey === 'premium_tier_3m_blue') {
                itemName = "Premium Tier (3 Months) + X Blue Tick ✓";
                desc = "Upgrade to Premium Tier for 3 months and get verified with a blue tick via our partner. Your order will be pending.";
            } else if (itemKey === 'premium_tier_6m_blue') {
                itemName = "Premium Tier (6 Months) + X Blue Tick ✓";
                desc = "Upgrade to Premium Tier for 6 months and get verified with a blue tick via our partner. Your order will be pending.";
            } else if (itemKey === 'multiplier') {
                itemName = "2x Yield Multiplier (1 Month)";
                desc = "Double your points from ad views for 30 days.";
                currentStoreCost = STORE_CONFIG.multiplier || 3000;
            } else if (itemKey === 'cooldown') {
                itemName = "Instant Cooldown Reset";
                desc = "Skip the 45s wait between ad blocks.";
                currentStoreCost = STORE_CONFIG.cooldown || 500;
            } else if (itemKey === 'x_verify') {
                itemName = "X Verification Pack";
                desc = "Purchase the standalone X Verification pack to get the blue tick. Pending approval.";
            }

            // Fallback to params if defined directly in UI
            if (ptsParam) currentStoreCost = ptsParam;
            if (starsParam) starsCost = starsParam;

            document.getElementById('store-modal-item').innerText = itemName;
            
            // Adjust PTS Button
            document.getElementById('store-modal-pts-badge').innerText = currentStoreCost.toLocaleString() + " PTS";
            document.getElementById('btn-store-confirm-pts').onclick = () => {
                closeStoreModal();
                purchaseStoreItem(itemKey, hasBlueTick);
            };

            // Adjust Stars Button
            const starsBtn = document.getElementById('btn-store-confirm-stars');
            if (starsCost) {
                starsBtn.classList.remove('hidden');
                document.getElementById('store-modal-stars-badge').innerText = "🌟 " + starsCost;
                starsBtn.onclick = () => {
                    closeStoreModal();
                    purchaseWithStars(itemKey, starsCost, hasBlueTick);
                };
            } else {
                starsBtn.classList.add('hidden');
            }

            document.getElementById('store-modal-desc').innerText = desc;
            document.getElementById('store-confirm-modal').classList.remove('hidden');
        }

        function closeStoreModal() {
            document.getElementById('store-confirm-modal').classList.add('hidden');
        }

        async function purchaseWithStars(itemKey, amount, hasBlueTick = false) {
            showToast("Generating invoice...", "⏳");
            try {
                const telegramInitData = window.Telegram?.WebApp?.initData || "";
                const response = await fetch('/portal/generate-invoice', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `WebApp ${telegramInitData}`
                    },
                    body: JSON.stringify({
                        id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                        item: itemKey,
                        amount: amount,
                        hasBlueTick: hasBlueTick
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.invoiceUrl) {
                        window.Telegram.WebApp.openInvoice(data.invoiceUrl, (status) => {
                            if (status === 'paid') {
                                showToast("Payment successful! Processing upgrade...", "🎉");
                                // Realistically the backend bot would handle the pre_checkout_query and successful_payment webhook
                                // and upgrade the user. For immediate frontend feedback, we can reload.
                                setTimeout(() => window.location.reload(), 2000);
                            } else {
                                showToast("Payment " + status, "ℹ️");
                            }
                        });
                    } else {
                        showToast(data.error || "Failed to generate invoice", "❌");
                    }
                } else {
                    const err = await response.text();
                    showToast(err, "❌");
                }
            } catch (err) {
                console.error(err);
                showToast("Connection error", "❌");
            }
        }

        async function purchaseStoreItem(itemKey, hasBlueTick = false) {
            showToast("Processing purchase...", "⚡");
            
            try {
                const telegramInitData = window.Telegram?.WebApp?.initData || "";
                
                const response = await fetch('/portal/purchase-store-item', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `WebApp ${telegramInitData}`
                    },
                    body: JSON.stringify({
                        id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                        item: itemKey,
                        blue_tick: hasBlueTick
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    showToast(data.isPending ? "Purchase Pending Verification!" : "Purchase Successful!", "🎉");
                    
                    const userBalanceEl = document.getElementById('user-balance');
                    const storeBalanceEl = document.getElementById('store-balance');
                    const walletBalanceEl = document.getElementById('wallet-balance');
                    
                    if(userBalanceEl) userBalanceEl.innerText = data.newBalance.toLocaleString();
                    if(storeBalanceEl) storeBalanceEl.innerText = data.newBalance.toLocaleString();
                    if(walletBalanceEl) walletBalanceEl.innerText = data.newBalance.toLocaleString();
                    
                    // Dynamically update activity history
                    const activityList = document.getElementById('list-activity');
                    if (activityList) {
                        const emptyMsg = document.getElementById('empty-history');
                        if (emptyMsg) emptyMsg.remove();
                        
                        const title = document.getElementById('store-modal-item') ? document.getElementById('store-modal-item').innerText : itemKey;
                        const costText = document.getElementById('store-modal-cost') ? document.getElementById('store-modal-cost').innerText.replace(' PTS', '') : '';
                        
                        const newEntry = document.createElement('div');
                        newEntry.className = 'flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0';
                        newEntry.innerHTML = `
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-neutral-800">${data.isPending ? '[PENDING] Store Purchase: ' : '[COMPLETED] Store Purchase: '}${title}</span>
                                <span class="text-[9px] text-neutral-400 mono-text">${new Date().toLocaleString()}</span>
                            </div>
                            <span class="text-xs font-bold text-rose-700 mono-text">-${costText.replace(/,/g, '')}</span>
                        `;
                        activityList.prepend(newEntry);
                    }
                    
                    setTimeout(() => window.location.reload(), 2500);
                } else {
                    const errMsg = await response.text();
                    showToast(errMsg || "Insufficient balance.", "❌");
                }
            } catch (err) {
                showToast("Connection error.", "⚠️");
            }
        }

        function showToast(message, icon, duration = 3000) {
            const toast = document.getElementById('custom-toast');
            const toastIcon = document.getElementById('toast-icon');
            const toastMessage = document.getElementById('toast-message');

            toastIcon.innerText = icon;
            toastMessage.innerText = message;

            toast.classList.remove('-translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-24', 'opacity-0');
            }, duration);
        }

        function switchHistory(type) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.selectionChanged();
            }

            document.getElementById('list-activity').classList.toggle('hidden', type !== 'activity');
            document.getElementById('list-withdrawals').classList.toggle('hidden', type !== 'withdrawals');

            document.getElementById('tab-activity').className = type === 'activity'
                ? 'flex-1 py-2 text-[10px] font-bold rounded-lg transition-all bg-white shadow-sm text-neutral-900 uppercase tracking-widest'
                : 'flex-1 py-2 text-[10px] font-bold rounded-lg transition-all text-neutral-500 uppercase tracking-widest';

            document.getElementById('tab-withdrawals').className = type === 'withdrawals'
                ? 'flex-1 py-2 text-[10px] font-bold rounded-lg transition-all bg-white shadow-sm text-neutral-900 uppercase tracking-widest'
                : 'flex-1 py-2 text-[10px] font-bold rounded-lg transition-all text-neutral-500 uppercase tracking-widest';
        }

        function switchTab(tabId) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.selectionChanged();
            }

            const tabs = ['home', 'tasks', 'store', 'invite', 'wallet'];
            tabs.forEach(t => {
                const buttonElement = document.getElementById(`tab-${t}`);
                const viewElement = document.getElementById(`view-${t}`);

                if (t === tabId) {
                    if (buttonElement) buttonElement.className = "active-tab py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all shadow-sm relative";
                    if (viewElement) viewElement.classList.remove('hidden');
                } else {
                    if (buttonElement) buttonElement.className = "text-neutral-500 hover:text-neutral-900 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 transition-all relative";
                    if (viewElement) viewElement.classList.add('hidden');
                }
            });
        }

        async function verifyTask(questKey, targetUrl) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.selectionChanged();
            }
            window.open(targetUrl, '_blank');

            const btn = document.getElementById(`btn-quest-${questKey}`);
            if (!btn) return;

            btn.disabled = true;
            btn.innerText = "Checking...";
            btn.className = "bg-neutral-400 text-neutral-100 text-xs font-medium px-3 py-2 rounded-xl cursor-not-allowed shadow-none";

            setTimeout(async () => {
                try {
                    const telegramInitData = window.Telegram?.WebApp?.initData || "";

                    const response = await fetch('/portal/verify-quest', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `WebApp ${telegramInitData}`
                        },
                        body: JSON.stringify({
                            id: "<%= user.telegram_id %>",
                            quest: questKey
                        })
                    });

                    if (response.ok) {
                        showToast("Task done! +100 PTS", "🎉");

                        const rowId = `quest-row-${questKey}`;
                        const row = document.getElementById(rowId);
                        if (row) {
                            row.style.opacity = '0';
                            setTimeout(() => {
                                row.remove();
                                // Check if mandatory quests are all done visually
                                const container = document.getElementById('quest-row-channel')?.parentElement;
                                if (container && !container.querySelector('[id^="quest-row-"]')) {
                                    container.insertAdjacentHTML('beforeend', '<div class="text-center text-xs text-neutral-400 py-4 mono-text">All done ✓</div>');
                                }
                            }, 300);
                        }

                        // Add to activity history instantly
                        const listActivity = document.getElementById('list-activity');
                        if (listActivity) {
                            const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const historyHtml = `
                                <div class="flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-bold text-neutral-800">Task: ${questKey}</span>
                                        <span class="text-[9px] text-neutral-400 mono-text">${timeNow}</span>
                                    </div>
                                    <span class="text-xs font-bold text-emerald-700 mono-text">+100</span>
                                </div>`;
                            listActivity.insertAdjacentHTML('afterbegin', historyHtml);
                        }

                        const userBalanceEl = document.getElementById('user-balance');
                        const walletBalanceEl = document.getElementById('wallet-balance');

                        const currentBalance = parseInt(userBalanceEl.innerText.replace(/,/g, '')) || 0;
                        const newBalance = currentBalance + 100;

                        userBalanceEl.innerText = newBalance.toLocaleString();
                        if (walletBalanceEl) {
                            walletBalanceEl.innerText = newBalance.toLocaleString();
                        }

                        const newUsdVal = newBalance * 0.0008;
                        const userValEl = document.getElementById('user-value');
                        const walletValEl = document.getElementById('wallet-valuation');

                        if (userValEl) userValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                        if (walletValEl) walletValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;

                        const taskBadge = document.getElementById('task-nav-badge');
                        if (taskBadge) {
                            let currentBadgeCount = parseInt(taskBadge.innerText) || 0;
                            currentBadgeCount--;
                            if (currentBadgeCount > 0) {
                                taskBadge.innerText = currentBadgeCount;
                                taskBadge.classList.remove('hidden');
                            } else {
                                taskBadge.innerText = '0';
                                taskBadge.classList.add('hidden');
                            }
                        }

                        const activityList = document.getElementById('list-activity');
                        const emptyPlaceholder = document.getElementById('empty-history');
                        if (emptyPlaceholder) {
                            emptyPlaceholder.remove();
                        }

                        let questLabel = "X Follow";
                        if (questKey === 'channel') questLabel = "Warps Channel";
                        if (questKey === 'group') questLabel = "Warps Group";
                        if (questKey === 'payout_channel') questLabel = "WarpsEarn Payouts";

                        const optionsDate = { month: 'short', day: 'numeric', year: 'numeric' };
                        const optionsTime = { hour: '2-digit', minute: '2-digit', hour12: true };
                        const dateStr = new Date().toLocaleDateString('en-US', optionsDate);
                        const timeStr = new Date().toLocaleTimeString('en-US', optionsTime);
                        const currentFormattedTimestamp = `${dateStr} • ${timeStr}`;

                        const newRow = document.createElement('div');
                        newRow.className = "flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0";
                        newRow.innerHTML = `
                        <div class="flex flex-col">
                            <span class="text-xs font-bold text-neutral-800">${questLabel} Quest</span>
                            <span class="text-[9px] text-neutral-400 mono-text">${currentFormattedTimestamp}</span>
                        </div>
                        <span class="text-xs font-bold text-emerald-700 mono-text">+100</span>
                        `;

                        activityList.insertBefore(newRow, activityList.firstChild);

                        if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.HapticFeedback) {
                            window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                        }
                    } else {
                        showToast("Please join the channel/group first.", "⚠️");
                        btn.disabled = false;
                        btn.innerText = "Start";
                        btn.className = "bg-neutral-950 hover:bg-neutral-900 active:scale-[0.95] transition-all text-[#e6ddd0] text-xs font-bold px-4 py-2 rounded-xl shadow-sm";
                    }
                } catch (err) {
                    console.error(err);
                    showToast("Something went wrong. Try again.", "⚠️");
                    btn.disabled = false;
                    btn.innerText = "Start";
                    btn.className = "bg-neutral-950 hover:bg-neutral-900 active:scale-[0.95] transition-all text-[#e6ddd0] text-xs font-bold px-4 py-2 rounded-xl shadow-sm";
                }
            }, 10000);
        }

        function copyRefLink(linkText) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
            }

            navigator.clipboard.writeText(linkText).then(() => {
                const btn = document.getElementById('btn-copy-link');
                btn.innerText = "COPIED";
                btn.className = "bg-emerald-700 text-white font-bold text-[10px] uppercase tracking-wider px-3 py-2 rounded-lg shrink-0";
                setTimeout(() => {
                    btn.innerText = "COPY";
                    btn.className = "bg-neutral-950 text-[#e6ddd0] font-bold text-[10px] uppercase tracking-wider px-3 py-2 rounded-lg shrink-0";
                }, 2000);
            }).catch(err => {
                showToast("Couldn't copy. Long-press the link to copy manually.", "⚠️");
            });
        }

        let activeAsset = '';
        let activeCountryContext = '';

        function getBankProviderValue() {
            const selectEl = document.getElementById('select-bank-provider');
            return selectEl ? selectEl.value : null;
        }

        function openWithdrawalFlow() {
            document.getElementById('withdrawal-flow').classList.remove('hidden');
            resetFlowToCountry();
            document.getElementById('withdrawal-flow').scrollIntoView({ behavior: 'smooth' });
        }

        function closeWithdrawalFlow() {
            document.getElementById('withdrawal-flow').classList.add('hidden');
        }

        function resetFlowToCountry() {
            activeAsset = '';
            activeCountryContext = '';

            document.getElementById('step-country').classList.remove('hidden');
            document.getElementById('wrapper-currency').classList.add('hidden');
            document.getElementById('wrapper-details').classList.add('hidden');
            document.getElementById('bank-select-dropdown').classList.add('hidden');
            document.getElementById('wrapper-fiat-calc').classList.add('hidden');
            document.getElementById('input-destination').value = '';
            if (document.getElementById('input-amount-pts')) {
                document.getElementById('input-amount-pts').value = '';
            }
        }

        function setCountry(countryCode) {
            activeCountryContext = countryCode;
            document.getElementById('step-country').classList.add('hidden');

            const currencyWrapper = document.getElementById('wrapper-currency');
            const currencyContainer = document.getElementById('container-currency');
            currencyWrapper.classList.remove('hidden');

            if (countryCode === 'NG') {
                currencyContainer.innerHTML = `
                <button type="button" onclick="setAsset('NAIRA')" class="border border-neutral-300 bg-white px-3 py-3 rounded-xl font-bold text-xs text-neutral-800 shadow-sm active:scale-95 transition-all">🇳🇬 Local Naira</button>
                <button type="button" onclick="renderCryptoOptions()" class="border border-neutral-300 bg-white px-3 py-3 rounded-xl font-bold text-xs text-neutral-800 shadow-sm active:scale-95 transition-all">⚡ Crypto Options</button>
            `;
            } else {
                renderCryptoOptions();
            }
        }

        function renderCryptoOptions() {
            const currencyContainer = document.getElementById('container-currency');
            currencyContainer.innerHTML = `
            <button type="button" onclick="setAsset('USDT_BEP20')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">USDT (BEP20)</button>
            <button type="button" onclick="setAsset('TON')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">TON Native</button>
            <button type="button" onclick="setAsset('STARS')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">TG Stars</button>
            <button type="button" onclick="setAsset('SOL')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">Solana Network</button>
        `;
        }

        function setAsset(assetType) {
            activeAsset = assetType;

            const detailsWrapper = document.getElementById('wrapper-details');
            const bankDropdown = document.getElementById('bank-select-dropdown');
            const addressLabel = document.getElementById('label-input-address');
            const addressInput = document.getElementById('input-destination');
            const fiatCalc = document.getElementById('wrapper-fiat-calc');

            detailsWrapper.classList.remove('hidden');
            fiatCalc.classList.remove('hidden');

            if (assetType === 'NAIRA') {
                bankDropdown.classList.remove('hidden');
                addressLabel.innerText = "3. Your Account Number";
                addressInput.placeholder = "Enter your 10-digit account number...";
            } else {
                bankDropdown.classList.add('hidden');

                if (assetType === 'STARS') {
                    addressLabel.innerText = "3. Your Telegram Username";
                    addressInput.placeholder = "@your_telegram_username";
                } else {
                    addressLabel.innerText = `3. Your ${assetType.split('_')[0]} Wallet Address`;
                    addressInput.placeholder = `Paste your ${assetType.split('_')[0]} address...`;
                }
            }
            calculateDynamicYield();
        }

        function calculateDynamicYield() {
            const ptsInput = document.getElementById('input-amount-pts');
            const ptsVal = parseFloat(ptsInput.value) || 0;
            const yieldDisplay = document.getElementById('display-yield-value');

            const usdVal = ptsVal * 0.0008;

            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                yieldDisplay.innerHTML = `
                <span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>
                <span class="text-neutral-400 font-medium px-1">•</span>
                <span class="text-emerald-700 font-bold">₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} NGN</span>
            `;
            } else {
                yieldDisplay.innerHTML = `<span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>`;
            }
        }

        function openConfirmModal() {
            const inputVal = document.getElementById('input-destination').value.trim();
            const inputAmountVal = parseInt(document.getElementById('input-amount-pts').value) || 0;

            if (!activeAsset) return showToast("Pick a payment method first.", "⚠️");
            if (inputAmountVal <= 0) return showToast("Enter a valid amount.", "⚠️");

            if (activeAsset === 'NAIRA' && !/^\d{10}$/.test(inputVal)) {
                return showToast("Account number must be exactly 10 digits.", "⚠️");
            }

            if (!inputVal) return showToast("Enter your account details.", "⚠️");

            document.getElementById('confirm-display-asset').innerText = activeAsset.replace('_', ' ');
            document.getElementById('confirm-display-pts').innerText = `${inputAmountVal.toLocaleString()} PTS`;
            document.getElementById('confirm-display-destination').innerText = inputVal;

            const usdVal = inputAmountVal * 0.0008;
            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                document.getElementById('confirm-display-conversion').innerHTML = `$${usdVal.toFixed(2)} USD • ₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            } else {
                document.getElementById('confirm-display-conversion').innerText = `$${usdVal.toFixed(2)} USD`;
            }

            const confirmBtn = document.getElementById('btn-modal-action-confirm');
            confirmBtn.onclick = () => {
                closeConfirmModal();
                fireWithdrawalPayload();
            };

            document.getElementById('custom-confirm-modal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('custom-confirm-modal').classList.add('hidden');
        }

        async function fireWithdrawalPayload() {
            const inputVal = document.getElementById('input-destination').value.trim();
            const inputAmountVal = parseInt(document.getElementById('input-amount-pts').value) || 0;
            const bankVal = getBankProviderValue();

            const requestPayload = {
                telegram_id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                points_to_withdraw: inputAmountVal,
                country_context: activeCountryContext,
                payment_provider: activeAsset === 'NAIRA' ? (bankVal || 'OPAY') : activeAsset,
                destination_account: inputVal,
                id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                amount: inputAmountVal,
                destination: inputVal,
                asset: activeAsset,
                bank: activeAsset === 'NAIRA' ? (bankVal || 'OPAY') : null
            };

            showToast("Submitting withdrawal...", "⚡");

            try {
                const telegramInitData = window.Telegram?.WebApp?.initData || "";

                let response = await fetch('/portal/request-payout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `WebApp ${telegramInitData}`
                    },
                    body: JSON.stringify(requestPayload)
                });

                if (response.status === 404) {
                    console.log("⚠️ Portal router returned 404. Falling back to root /request-payout route...");
                    response = await fetch('/request-payout', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `WebApp ${telegramInitData}`
                        },
                        body: JSON.stringify(requestPayload)
                    });
                }

                if (response.ok) {
                    showToast("Withdrawal submitted!", "✅");

                    closeWithdrawalFlow();

                    const userBalanceEl = document.getElementById('user-balance');
                    const walletBalanceEl = document.getElementById('wallet-balance');

                    const oldBalance = parseInt(userBalanceEl.innerText.replace(/,/g, '')) || 0;
                    const newBalance = Math.max(0, oldBalance - inputAmountVal);

                    userBalanceEl.innerText = newBalance.toLocaleString();
                    if (walletBalanceEl) {
                        walletBalanceEl.innerText = newBalance.toLocaleString();
                    }

                    const newUsdVal = newBalance * 0.0008;
                    const userValEl = document.getElementById('user-value');
                    const walletValEl = document.getElementById('wallet-valuation');

                    if (userValEl) userValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                    if (walletValEl) walletValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;

                    const listWithdrawals = document.getElementById('list-withdrawals');
                    const emptyPlaceholder = listWithdrawals.querySelector('.text-center');
                    if (emptyPlaceholder) {
                        emptyPlaceholder.remove();
                    }

                    const optionsDate = { month: 'short', day: 'numeric', year: 'numeric' };
                    const optionsTime = { hour: '2-digit', minute: '2-digit', hour12: true };
                    const dateStr = new Date().toLocaleDateString('en-US', optionsDate);
                    const timeStr = new Date().toLocaleTimeString('en-US', optionsTime);
                    const currentFormattedTimestamp = `${dateStr} • ${timeStr}`;

                    const newTxRow = document.createElement('div');
                    newTxRow.className = "flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0";
                    newTxRow.innerHTML = `
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-neutral-800">Withdrawal (${activeAsset.replace('_', ' ')})</span>
                        <span class="text-[9px] text-neutral-400 mono-text">${currentFormattedTimestamp}</span>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-xs font-bold text-blue-700 mono-text">-$${(inputAmountVal * 0.0008).toFixed(2)} USD</span>
                        <span class="text-[9px] uppercase tracking-wider font-extrabold text-amber-500 animate-pulse mono-text">Pending</span>
                    </div>
                `;

                    listWithdrawals.insertBefore(newTxRow, listWithdrawals.firstChild);

                    document.getElementById('input-destination').value = '';
                    if (document.getElementById('input-amount-pts')) {
                        document.getElementById('input-amount-pts').value = '';
                    }

                    switchHistory('withdrawals');

                    if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.HapticFeedback) {
                        window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                    }
                } else {
                    const errMsg = await response.text();
                    showToast(`Withdrawal failed: ${errMsg}`, "❌");
                }
            } catch (err) {
                showToast("Connection error. Try again.", "❌");
            }
        }

