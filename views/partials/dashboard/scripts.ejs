        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        async function triggerAdNetworkSequence() {
            const playBtn = document.getElementById('adsgram-play-btn');
            const btnIcon = document.getElementById('ad-btn-icon');
            const btnTitle = document.getElementById('ad-btn-title');
            const btnSubtitle = document.getElementById('ad-btn-subtitle');
            const btnArrow = document.getElementById('ad-btn-arrow');

            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.impactOccurred('medium');
            }

            playBtn.disabled = true;
            playBtn.classList.add('opacity-70', 'cursor-not-allowed');

            const totalChainSteps = 3;
            let adsCompletedCount = 0;

            for (let i = 1; i <= totalChainSteps; i++) {
                if (i > 1) {
                    let secondsLeft = 3;
                    while (secondsLeft > 0) {
                        btnIcon.innerText = "⏳";
                        btnTitle.innerText = `Waiting ${secondsLeft}s...`;
                        btnSubtitle.innerText = "Re-establishing secure ad stream connection...";
                        await new Promise(resolve => setTimeout(resolve, 1000));
                        secondsLeft--;
                    }
                }

                btnIcon.innerText = "⏳";
                btnTitle.innerText = `Loading Ad ${i} of ${totalChainSteps}...`;
                btnSubtitle.innerText = "Routing decentralized network connection...";
                btnArrow.innerText = "•";

                const telegramInitData = window.Telegram?.WebApp?.initData || "";
                
                async function reportAdTelemetry(network, status, errorMsg = null) {
                    try {
                        fetch('/portal/ad-telemetry', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Authorization': `WebApp ${telegramInitData}` },
                            body: JSON.stringify({ network, status, errorMsg: errorMsg ? errorMsg.toString() : null })
                        });
                    } catch(e) {}
                }

                const activePool = shuffleArray(['adsgram', 'monetag', 'telegaio']);
                let adLoadedSuccessfully = false;

                for (let network of activePool) {
                    if (adLoadedSuccessfully) break;

                    console.log(`📡 AdEngine attempting delivery on node: ${network.toUpperCase()}`);

                    try {
                        if (network === 'adsgram' && AdsgramController) {
                            const result = await AdsgramController.show();
                            if (result && (result.done || result.state === 'completed')) {
                                adsCompletedCount++;
                                adLoadedSuccessfully = true;
                                reportAdTelemetry('adsgram', 'success');
                                showToast(`Ad ${i}/${totalChainSteps} (Adsgram) completed!`, "✓", 1500);
                            }
                        }
                        else if (network === 'monetag' && AdConfiguration.monetag.enabled) {
                            // Open in Telegram web browser externally
                            if (window.Telegram && window.Telegram.WebApp) {
                                window.Telegram.WebApp.openLink(AdConfiguration.monetag.adUrl);
                            } else {
                                window.open(AdConfiguration.monetag.adUrl, '_blank');
                            }

                            // Show a waiting modal to claim the reward
                            const completed = await new Promise((resolve) => {
                                const modal = document.getElementById('fallback-player-modal');
                                const closeBtn = document.getElementById('fallback-close-btn');
                                const iframe = document.getElementById('fallback-ad-iframe');
                                const spinner = document.getElementById('fallback-loading-spinner');
                                const countdownText = document.getElementById('fallback-countdown-text');
                                const progressBar = document.getElementById('fallback-progress-bar');

                                modal.classList.remove('hidden');
                                spinner.classList.add('hidden');
                                iframe.classList.add('hidden');

                                countdownText.innerText = "Please view the ad in the browser. You can claim your reward in 15 seconds.";

                                closeBtn.disabled = true;
                                closeBtn.innerText = "Wait 15s";
                                closeBtn.className = "bg-neutral-800 text-neutral-500 font-bold text-[11px] px-3 py-1.5 rounded-xl uppercase tracking-wider transition-all cursor-not-allowed shadow-none";

                                progressBar.style.transition = "width 15s linear";
                                void progressBar.offsetWidth;
                                progressBar.style.width = "0%";

                                let secondsLeft = 15;
                                const timer = setInterval(() => {
                                    secondsLeft--;
                                    closeBtn.innerText = `Wait ${secondsLeft}s`;

                                    if (secondsLeft <= 0) {
                                        clearInterval(timer);
                                        closeBtn.disabled = false;
                                        closeBtn.innerText = "Claim Reward ✓";
                                        closeBtn.className = "bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-[#e6ddd0] font-bold text-[11px] px-4 py-1.5 rounded-xl uppercase tracking-wider transition-all shadow-md";
                                        countdownText.innerText = "Ad complete! Tap below to claim your points.";
                                    }
                                }, 1000);

                                closeBtn.onclick = () => {
                                    clearInterval(timer);
                                    modal.classList.add('hidden');
                                    resolve(true); 
                                };
                            });

                            if (completed) {
                                adsCompletedCount++;
                                adLoadedSuccessfully = true;
                                reportAdTelemetry('monetag', 'success');
                                showToast(`Ad ${i}/${totalChainSteps} (Monetag) completed!`, "✓", 1500);
                            }
                        }
                        else if (network === 'telegaio' && AdConfiguration.telegaio.enabled) {
                            if (!window.TelegaAdsController) throw new Error("Telega SDK not initialized.");
                            
                            // Using the correct method from Telega documentation
                            await window.TelegaAdsController.ad_show({
                                adBlockUuid: AdConfiguration.telegaio.blockId
                            });

                            adsCompletedCount++;
                            adLoadedSuccessfully = true;
                            reportAdTelemetry('telegaio', 'success');
                            showToast(`Ad ${i}/${totalChainSteps} (Telega.io) completed!`, "✓", 1500);
                        }
                    } catch (e) {
                        console.warn(`⚠️ Delivery node failed: ${network.toUpperCase()}. Executing next pool fallback...`);
                        reportAdTelemetry(network, 'fail', e.message || e);
                    }
                }

                if (!adLoadedSuccessfully) {
                    showToast("No ads available right now. Try again shortly.", "⚠️");
                    resetAdButton();
                    return;
                }
            }

            if (adsCompletedCount === totalChainSteps) {
                btnIcon.innerText = "🔄";
                btnTitle.innerText = "Verifying...";
                btnSubtitle.innerText = "Adding points to your balance...";

                try {
                    const telegramInitData = window.Telegram?.WebApp?.initData || "";

                    const response = await fetch('/portal/claim-ad-reward', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `WebApp ${telegramInitData}`
                        },
                        body: JSON.stringify({ id: "<%= user.telegram_id %>" })
                    });

                    if (response.ok) {
                        const updatedData = await response.json();

                        if (window.Telegram && window.Telegram.WebApp) {
                            window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                        }

                        showToast("+<%= ((locals.globalSettings?.reward_per_ad || 3) * 3) * (user.ad_multiplier || 1) %> PTS earned!", "🪙");

                        const currentBalance = parseInt(document.getElementById('user-balance').innerText.replace(/,/g, ''));
                        const newBalance = currentBalance + <%= ((locals.globalSettings?.reward_per_ad || 3) * 3) * (user.ad_multiplier || 1) %>;

                        document.getElementById('user-balance').innerText = newBalance.toLocaleString();
                        document.getElementById('user-value').innerText = `$${(newBalance * 0.0008).toFixed(2)} USD`;

                        const walletBal = document.getElementById('wallet-balance');
                        if (walletBal) walletBal.innerText = newBalance.toLocaleString();
                        const walletVal = document.getElementById('wallet-valuation');
                        if (walletVal) walletVal.innerText = `$${(newBalance * 0.0008).toFixed(2)} USD`;

                        const adsCountElement = document.getElementById('total-ads-watched');
                        if (adsCountElement) {
                            const currentAdsCount = parseInt(adsCountElement.innerText);
                            adsCountElement.innerText = (currentAdsCount + 3).toString();
                        }

                        // Auto-sync Activity History
                        const listActivity = document.getElementById('list-activity');
                        if (listActivity) {
                            const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const loopDisplay = updatedData.loopIndex === 0 ? 3 : updatedData.loopIndex;
                            const historyHtml = `
                                <div class="flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-bold text-neutral-800">Ad Reward #${loopDisplay}</span>
                                        <span class="text-[9px] text-neutral-400 mono-text">${timeNow}</span>
                                    </div>
                                    <span class="text-xs font-bold text-emerald-700 mono-text">+3</span>
                                </div>`;
                            listActivity.insertAdjacentHTML('afterbegin', historyHtml);
                        }

                        resetAdButton();
                    } else {
                        const errorMsg = await response.text();
                        showToast(`Error: ${errorMsg}`, "❌");
                        resetAdButton();
                    }
                } catch (networkErr) {
                    showToast("Points will update when you reopen the app.", "⚠️");
                    resetAdButton();
                }
            }

            function resetAdButton() {
                playBtn.disabled = false;
                playBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                btnIcon.innerText = "⚡";
                btnTitle.innerText = "Watch Ad";
                btnSubtitle.innerText = "Watch 3 short ads (+<%= ((locals.globalSettings?.reward_per_ad || 3) * 3) * (user.ad_multiplier || 1) %> PTS)";
                btnArrow.innerText = "→";
            }
        }

        function triggerFallbackOverlay(destinationUrl) {
            return new Promise((resolve) => {
                const modal = document.getElementById('fallback-player-modal');
                const closeBtn = document.getElementById('fallback-close-btn');
                const iframe = document.getElementById('fallback-ad-iframe');
                const spinner = document.getElementById('fallback-loading-spinner');
                const countdownText = document.getElementById('fallback-countdown-text');
                const progressBar = document.getElementById('fallback-progress-bar');

                modal.classList.remove('hidden');
                spinner.classList.remove('hidden');
                iframe.classList.add('hidden');

                closeBtn.disabled = true;
                closeBtn.innerText = "Wait 15s";
                closeBtn.className = "bg-neutral-800 text-neutral-500 font-bold text-[11px] px-3 py-1.5 rounded-xl uppercase tracking-wider transition-all cursor-not-allowed shadow-none";

                progressBar.style.width = "100%";

                iframe.src = destinationUrl;

                iframe.onload = () => {
                    spinner.classList.add('hidden');
                    iframe.classList.remove('hidden');

                    let secondsLeft = 15;
                    progressBar.style.transition = "width 15s linear";
                    void progressBar.offsetWidth;
                    progressBar.style.width = "0%";

                    const timer = setInterval(() => {
                        secondsLeft--;
                        closeBtn.innerText = `Wait ${secondsLeft}s`;

                        if (secondsLeft <= 0) {
                            clearInterval(timer);
                            closeBtn.disabled = false;
                            closeBtn.innerText = "Claim Reward ✓";
                            closeBtn.className = "bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-[#e6ddd0] font-bold text-[11px] px-4 py-1.5 rounded-xl uppercase tracking-wider transition-all shadow-md";
                            countdownText.innerText = "Ad complete! Tap below to claim your points.";
                        }
                    }, 1000);

                    closeBtn.onclick = () => {
                        clearInterval(timer);
                        modal.classList.add('hidden');
                        iframe.src = ""; 
                        resolve(true); 
                    };
                };

                setTimeout(() => {
                    if (!spinner.classList.contains('hidden')) {
                        console.warn("⚠️ Fallback iframe loading timeout. Resolving true to bypass.");
                        spinner.classList.add('hidden');
                        modal.classList.add('hidden');
                        iframe.src = "";
                        resolve(true);
                    }
                }, 8000);
            });
        }



        // Promo task handler
        async function triggerPromoTask(promoKey, targetUrl, rewardPts = 150, isTelegram = false, timer = 8, requiresCommentLink = false) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.selectionChanged();
            }
            window.open(targetUrl, '_blank');

            const btn = document.getElementById(`promo-btn-${promoKey}`); 
            if (!btn) return;

            let commentLink = null;
            if (requiresCommentLink) {
                // Wait a bit before prompting so they actually switch tabs and come back
                await new Promise(r => setTimeout(r, 2000));
                commentLink = window.prompt("Please paste the link to your X comment/retweet to verify this task:");
                if (!commentLink || commentLink.trim() === "") {
                    showToast("Task verification cancelled. Valid link required.", "⚠️");
                    return;
                }
            }

            btn.disabled = true;
            btn.innerText = "Verifying...";
            btn.className = "bg-neutral-300 text-neutral-500 text-xs font-medium px-4 py-2.5 rounded-xl cursor-not-allowed";

            setTimeout(async () => {
                try {
                    const telegramInitData = window.Telegram?.WebApp?.initData || "";
                    const response = await fetch('/portal/verify-custom-promo', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `WebApp ${telegramInitData}`
                        },
                        body: JSON.stringify({
                            id: "<%= user.telegram_id %>",
                            promoKey: promoKey,
                            commentLink: commentLink
                        })
                    });

                    if (response.ok) {
                        showToast(`Task done! +${rewardPts} PTS`, "🎉");
                        
                        const row = document.getElementById(`promo-row-${promoKey}`);
                        if (row) {
                            row.style.opacity = '0';
                            setTimeout(() => {
                                row.remove();
                                // Hide whole container if empty
                                const remainingRows = document.querySelectorAll('[id^="promo-row-"]');
                                if (remainingRows.length === 0) {
                                    const container = document.querySelector('.bg-gradient-to-br.from-amber-50');
                                    if(container) container.classList.add('hidden');
                                }
                            }, 300);
                        }
                        
                        const userBalanceEl = document.getElementById('user-balance');
                        const walletBalanceEl = document.getElementById('wallet-balance');
                        const currentVal = parseInt(userBalanceEl.innerText.replace(/,/g, '')) || 0;
                        
                        userBalanceEl.innerText = (currentVal + rewardPts).toLocaleString();
                        if (walletBalanceEl) walletBalanceEl.innerText = (currentVal + rewardPts).toLocaleString();
                        
                        // Sync UI valuation
                        const newUsdVal = (currentVal + rewardPts) * 0.0008;
                        const userValEl = document.getElementById('user-value');
                        if(userValEl) userValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                        
                        // Add to activity history instantly
                        const listActivity = document.getElementById('list-activity');
                        if (listActivity) {
                            const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                            const historyHtml = `
                                <div class="flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0">
                                    <div class="flex flex-col">
                                        <span class="text-xs font-bold text-neutral-800">Bonus Task: ${promoKey}</span>
                                        <span class="text-[9px] text-neutral-400 mono-text">${timeNow}</span>
                                    </div>
                                    <span class="text-xs font-bold text-emerald-700 mono-text">+${rewardPts}</span>
                                </div>`;
                            listActivity.insertAdjacentHTML('afterbegin', historyHtml);
                        }
                        
                        // Decrement the task badge
                        const taskBadge = document.getElementById('task-nav-badge');
                        if (taskBadge) {
                            let currentBadgeCount = parseInt(taskBadge.innerText) || 0;
                            currentBadgeCount--;
                            if (currentBadgeCount > 0) {
                                taskBadge.innerText = currentBadgeCount;
                                taskBadge.classList.remove('hidden');
                            } else {
                                taskBadge.innerText = '0';
                                taskBadge.classList.add('hidden');
                            }
                        }
                    } else {
                        const errText = await response.text();
                        showToast(errText || "Complete the task first, then try again.", "⚠️");
                        btn.disabled = false;
                        btn.innerText = "Start";
                        btn.className = "bg-neutral-900 hover:bg-neutral-800 active:scale-[0.95] transition-all text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow-md border border-neutral-800";
                    }
                } catch (err) {
                    showToast("Something went wrong. Try again.", "⚠️");
                    btn.disabled = false;
                    btn.innerText = "Start";
                    btn.className = "bg-neutral-900 hover:bg-neutral-800 active:scale-[0.95] transition-all text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow-md border border-neutral-800";
                }
            }, timer * 1000);
        }

        // ✅ BOUNTY MODAL & SUBMISSION LOGIC
        function openBountyModal(id, title, platform, action, reward, url, requiresLink = true) {
            if (window.Telegram && window.Telegram.WebApp) {
                window.Telegram.WebApp.HapticFeedback.selectionChanged();
            }
            
            if (!requiresLink) {
                // "verify after some times" logic
                window.open(url, '_blank');
                showToast("Verifying... Please wait.", "⏳");
                
                // We don't have the button reference easily here, but we can do a background submit
                setTimeout(async () => {
                    try {
                        const telegramInitData = window.Telegram?.WebApp?.initData || "";
                        const response = await fetch('/portal/submit-bounty', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `WebApp ${telegramInitData}`
                            },
                            body: JSON.stringify({
                                id: "<%= user.telegram_id %>",
                                bounty_id: id,
                                proof_url: "N/A"
                            })
                        });

                        if (response.ok) {
                            showToast(`Task done! +${reward} PTS`, "🎉");
                            setTimeout(() => window.location.reload(), 1500);
                        } else {
                            const errText = await response.text();
                            showToast(errText || "Verification failed.", "⚠️");
                        }
                    } catch (err) {
                        showToast("Something went wrong.", "⚠️");
                    }
                }, 15000); // 15 second timer
                return;
            }
            
            document.getElementById('bounty-modal-id').value = id;
            document.getElementById('bounty-modal-title').innerText = title;
            document.getElementById('bounty-modal-reward').innerText = `+${reward} PTS`;
            document.getElementById('bounty-modal-action').innerText = `${platform} ${action}`;
            
            const linkBtn = document.getElementById('bounty-modal-link-btn');
            linkBtn.onclick = () => {
                window.open(url, '_blank');
            };
            
            document.getElementById('bounty-proof-input').value = '';
            
            const step2Div = document.getElementById('bounty-proof-input').parentElement;
            step2Div.style.display = 'flex';
            document.getElementById('btn-submit-bounty').innerText = "Submit for Verification";
            
            document.getElementById('bounty-modal').classList.remove('hidden');
            document.getElementById('bounty-modal').classList.add('flex');
        }

        function closeBountyModal() {
            document.getElementById('bounty-modal').classList.add('hidden');
            document.getElementById('bounty-modal').classList.remove('flex');
        }

        async function submitBountyProof() {
            const bountyId = document.getElementById('bounty-modal-id').value;
            const proofUrl = document.getElementById('bounty-proof-input').value.trim();
            const btn = document.getElementById('btn-submit-bounty');
            
            if (!proofUrl) return showToast("Please paste your proof link first.", "⚠️");
            
            btn.disabled = true;
            btn.innerText = "Submitting...";
            
            try {
                const telegramInitData = window.Telegram?.WebApp?.initData || "";
                const response = await fetch('/portal/submit-bounty', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `WebApp ${telegramInitData}`
                    },
                    body: JSON.stringify({
                        id: "<%= user.telegram_id %>",
                        bounty_id: bountyId,
                        proof_url: proofUrl
                    })
                });

                if (response.ok) {
                    showToast("Proof submitted! Waiting for admin approval.", "✅");
                    closeBountyModal();
                } else {
                    const err = await response.text();
                    showToast(err, "❌");
                }
            } catch (err) {
                showToast("Connection error. Try again.", "❌");
            } finally {
                btn.disabled = false;
                btn.innerText = "SUBMIT FOR VERIFICATION";
            }
        }



        document.addEventListener("DOMContentLoaded", () => {
            initAdsgram(); 
            initOnClickA();

            // ✅ FIXED: Safely binds listener exclusively to the auto-loading Adsgram HTML web component
            const taskAdElement = document.getElementById('adsgram-task-element');
            const taskAdWrapper = document.getElementById('adsgram-task-wrapper');
            const ecoContainer = document.getElementById('ecosystem-container');

            if (taskAdElement && taskAdWrapper) {
                if (ecoContainer) {
                    ecoContainer.classList.remove('hidden');
                    ecoContainer.classList.add('flex');
                }
                taskAdWrapper.classList.remove('hidden');
                taskAdWrapper.classList.add('flex');

                taskAdElement.addEventListener('onBannerNotFound', () => {
                    console.log("📡 Adsgram Task Ad: No active campaign matched. Hiding wrapper card.");
                    if (ecoContainer) { ecoContainer.classList.remove('flex'); ecoContainer.classList.add('hidden'); }
                    taskAdWrapper.classList.remove('flex');
                    taskAdWrapper.classList.add('hidden');
                });

                taskAdElement.addEventListener('onError', () => {
                    console.warn("⚠️ Adsgram Task Ad: Execution failed or empty. Hiding wrapper card.");
                    if (ecoContainer) { ecoContainer.classList.remove('flex'); ecoContainer.classList.add('hidden'); }
                    taskAdWrapper.classList.remove('flex');
                    taskAdWrapper.classList.add('hidden');
                });

                taskAdElement.addEventListener('reward', async () => {
                    showToast("Sponsored task completed! +50 PTS Added.", "🎉");
                    try {
                        const telegramInitData = window.Telegram?.WebApp?.initData || "";
                        const response = await fetch('/portal/claim-adsgram-reward', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `WebApp ${telegramInitData}`
                            },
                            body: JSON.stringify({
                                id: "<%= user.telegram_id %>"
                            })
                        });

                        if (response.ok) {
                            const data = await response.json();
                            const userBalanceEl = document.getElementById('user-balance');
                            const walletBalanceEl = document.getElementById('wallet-balance');
                            if (userBalanceEl) userBalanceEl.innerText = data.newBalance.toLocaleString();
                            if (walletBalanceEl) walletBalanceEl.innerText = data.newBalance.toLocaleString();
                            
                            const newUsdVal = data.newBalance * 0.0008;
                            const userValEl = document.getElementById('user-value');
                            const walletValEl = document.getElementById('wallet-valuation');
                            if (userValEl) userValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                            if (walletValEl) walletValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                        }
                    } catch (err) {
                        console.error("Adsgram secure claim failed:", err);
                    }
                    if (ecoContainer) { ecoContainer.classList.remove('flex'); ecoContainer.classList.add('hidden'); }
                    taskAdWrapper.classList.add('hidden'); 
                });
            }
        });
    </script>

