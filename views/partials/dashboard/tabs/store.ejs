<div id="view-store" class="hidden flex flex-col gap-3 w-full">
                    <div class="px-1">
                        <h2 class="text-lg font-bold text-neutral-900 tracking-tight">Store</h2>
                        <p class="text-xs text-neutral-500 mt-0.5">Upgrade your account and unlock premium perks.</p>
                    </div>

                    <div class="w-full bg-neutral-950 text-[#e6ddd0] rounded-3xl p-5 shadow-md flex flex-col gap-4 relative overflow-hidden">
                        <div class="absolute right-[-10px] top-[-10px] text-6xl opacity-10 select-none">💳</div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] tracking-widest uppercase font-bold text-neutral-400 mono-text">Available Points</span>
                            <div class="flex items-baseline gap-1.5">
                                <span id="store-balance" class="text-3xl font-extrabold tracking-tight text-white">
                                    <%= (user.points_balance || 0).toLocaleString() %>
                                </span>
                                <span class="text-xs font-bold text-neutral-400 mono-text">PTS</span>
                            </div>
                        </div>
                    </div>

                    <!-- TIER UPGRADES -->
                    <div class="grid grid-cols-1 gap-4">
                        <% if ((locals.storeConfig && locals.storeConfig.enable_premium) !== false) { %>
                        <div class="bg-gradient-to-br from-indigo-500 to-violet-600 rounded-3xl p-6 shadow-md border border-indigo-400 relative overflow-hidden flex flex-col justify-between">
                            <div class="absolute -right-4 -top-4 text-7xl opacity-20">🌟</div>
                            <div class="flex flex-col gap-1 relative z-10">
                                <h3 class="text-white font-bold text-lg">Premium Tier</h3>
                                <span class="text-indigo-100 text-xs">Unlock high-yield tasks & faster payouts.</span>
                            </div>

                            <% 
                                const hasPendingPremium = locals.pendingOrders && locals.pendingOrders.some(o => o.item_key.startsWith('premium_tier'));
                                if (user.account_tier === 'Standard' && !hasPendingPremium) { 
                            %>
                                <div class="flex items-center gap-2 mt-3 bg-indigo-400/20 p-2.5 rounded-lg border border-indigo-300/40 relative z-10">
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" id="store-premium-bluetick-toggle" class="sr-only peer" onchange="updatePremiumPrices()">
                                        <div class="w-9 h-5 bg-indigo-800/40 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-500"></div>
                                    </label>
                                    <span class="text-[10px] font-bold text-white uppercase tracking-widest leading-tight">Add X Blue Tick <span class="inline-block">✓</span><br><span class="text-indigo-200 lowercase tracking-normal font-medium">(Verified via Partner)</span></span>
                                </div>

                                <div id="premium-options-1m" class="mt-2 relative z-10">
                                    <button onclick="promptStorePurchase('premium_tier_1m', <%= locals.storeConfig?.premium_tier_1m || 15000 %>, <%= locals.storeConfig?.stars_premium_1m || 15 %>)" class="w-full bg-indigo-900/60 hover:bg-indigo-800 text-indigo-50 font-bold text-xs py-3 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-indigo-700/50 flex items-center justify-between px-4">
                                        <span>1 Month (Standard)</span>
                                        <span class="text-[9px] text-indigo-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.premium_tier_1m) || 15000).toLocaleString() %> PTS</span>
                                    </button>
                                </div>

                                <div id="premium-options-blue" class="hidden grid grid-cols-2 gap-2 mt-2 relative z-10">
                                    <button onclick="promptStorePurchase('premium_tier_3m_blue', <%= locals.storeConfig?.premium_tier_3m_blue || 45000 %>, <%= locals.storeConfig?.stars_premium_3m_blue || 50 %>)" class="bg-indigo-900/60 hover:bg-indigo-800 text-indigo-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-indigo-700/50 flex flex-col items-center">
                                        <span>3 Months</span>
                                        <span class="text-[9px] text-indigo-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.premium_tier_3m_blue) || 45000).toLocaleString() %> PTS</span>
                                    </button>
                                    <button onclick="promptStorePurchase('premium_tier_6m_blue', <%= locals.storeConfig?.premium_tier_6m_blue || 85000 %>, <%= locals.storeConfig?.stars_premium_6m_blue || 95 %>)" class="bg-indigo-900/60 hover:bg-indigo-800 text-indigo-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-indigo-700/50 flex flex-col items-center">
                                        <span>6 Months</span>
                                        <span class="text-[9px] text-indigo-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.premium_tier_6m_blue) || 85000).toLocaleString() %> PTS</span>
                                    </button>
                                </div>
                                
                            <% } else if (hasPendingPremium) { %>
                                <button disabled class="w-full bg-violet-900/50 text-violet-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-violet-700/50 mt-4">
                                    Upgrade Pending Verification ⏳
                                </button>
                            <% } else { 
                                const daysLeft = user.tier_expires_at ? Math.ceil((new Date(user.tier_expires_at) - new Date()) / (1000 * 60 * 60 * 24)) : 0;
                            %>
                                <button disabled class="w-full bg-violet-900/50 text-violet-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-violet-700/50 mt-4">
                                    You are already Premium (or Gold)
                                    <% if (daysLeft > 0) { %><br><span class="text-[10px] text-violet-400"><%= daysLeft %> days left</span><% } %>
                                </button>
                            <% } %>
                        </div>
                        <% } %>

                        <% if ((locals.storeConfig && locals.storeConfig.enable_gold) !== false) { %>
                        <div class="bg-gradient-to-br from-amber-400 to-amber-600 rounded-3xl p-6 shadow-md border border-amber-300 relative overflow-hidden flex flex-col justify-between">
                            <div class="absolute -right-4 -bottom-4 text-7xl opacity-20">👑</div>
                            <div class="flex flex-col gap-1 relative z-10">
                                <h3 class="text-amber-950 font-bold text-lg">Gold Tier</h3>
                                <span class="text-amber-900 text-xs">Instant payouts, max yield, exclusive access.</span>
                            </div>

                            <% 
                                const hasPendingGold = locals.pendingOrders && locals.pendingOrders.some(o => o.item_key.startsWith('gold_tier'));
                                if (user.account_tier !== 'Gold' && !hasPendingGold) { 
                            %>
                            <div class="flex items-center gap-2 mt-3 bg-amber-500/20 p-2.5 rounded-lg border border-amber-500/30 relative z-10">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="store-bluetick-toggle" class="sr-only peer" onchange="updateGoldPrices()">
                                    <div class="w-9 h-5 bg-amber-700/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-500"></div>
                                </label>
                                <span class="text-[10px] font-bold text-amber-950 uppercase tracking-widest leading-tight">Add X Blue Tick <span class="inline-block">✓</span><br><span class="text-amber-800 lowercase tracking-normal font-medium">(Verified via Partner)</span></span>
                            </div>

                            <div id="gold-options-1m" class="mt-2 relative z-10">
                                <button onclick="promptStorePurchase('gold_tier_1m', <%= locals.storeConfig?.gold_tier_1m || 50000 %>, <%= locals.storeConfig?.stars_gold_1m || 50 %>)" class="w-full bg-amber-900/60 hover:bg-amber-800 text-amber-50 font-bold text-xs py-3 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-amber-700/50 flex items-center justify-between px-4">
                                    <span>1 Month (Standard)</span>
                                    <span class="text-[9px] text-amber-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.gold_tier_1m) || 50000).toLocaleString() %> PTS</span>
                                </button>
                            </div>

                            <div id="gold-options-blue" class="hidden grid grid-cols-2 gap-2 mt-2 relative z-10">
                                <button onclick="promptStorePurchase('gold_tier_3m_blue', <%= locals.storeConfig?.gold_tier_3m_blue || 80000 %>, <%= locals.storeConfig?.stars_gold_3m_blue || 120 %>)" class="bg-amber-900/60 hover:bg-amber-800 text-amber-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-amber-700/50 flex flex-col items-center">
                                    <span>3 Months</span>
                                    <span class="text-[9px] text-amber-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.gold_tier_3m_blue) || 80000).toLocaleString() %> PTS</span>
                                </button>
                                <button onclick="promptStorePurchase('gold_tier_6m_blue', <%= locals.storeConfig?.gold_tier_6m_blue || 150000 %>, <%= locals.storeConfig?.stars_gold_6m_blue || 220 %>)" class="bg-amber-900/60 hover:bg-amber-800 text-amber-50 font-bold text-xs py-2.5 rounded-xl shadow-inner active:scale-[0.98] transition-all border border-amber-700/50 flex flex-col items-center">
                                    <span>6 Months</span>
                                    <span class="text-[9px] text-amber-300 mono-text"><%= ((locals.storeConfig && locals.storeConfig.gold_tier_6m_blue) || 150000).toLocaleString() %> PTS</span>
                                </button>
                            </div>
                            
                            <div class="mt-2 relative z-10 flex justify-center border-t border-amber-400/30 pt-2">
                                <button onclick="purchaseWithStars('x_verify', <%= locals.storeConfig?.stars_x_verify || 100 %>)" class="w-full bg-neutral-900 hover:bg-neutral-800 text-white font-bold text-[10px] py-2 rounded-xl shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                    <span>X Verification Pack</span>
                                    <span class="bg-white/20 px-1.5 py-0.5 rounded text-[9px] mono-text">🌟 <%= locals.storeConfig?.stars_x_verify || 100 %></span>
                                </button>
                            </div>
                            <% } else if (hasPendingGold) { %>
                                <button disabled class="w-full bg-amber-900/50 text-amber-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-amber-700/50 mt-4">
                                    Upgrade Pending Verification ⏳
                                </button>
                            <% } else { 
                                const daysLeft = user.tier_expires_at ? Math.ceil((new Date(user.tier_expires_at) - new Date()) / (1000 * 60 * 60 * 24)) : 0;
                            %>
                                <button disabled class="w-full bg-amber-900/50 text-amber-300 font-bold text-xs py-3 rounded-xl shadow-inner cursor-not-allowed border border-amber-700/50 mt-4">
                                    You are already Gold
                                    <% if (daysLeft > 0) { %><br><span class="text-[10px] text-amber-400"><%= daysLeft %> days left</span><% } %>
                                </button>
                            <% } %>
                        </div>
                        <% } %>
                    </div>

                    <!-- BOOSTS -->
                    <div class="w-full bg-white/70 backdrop-blur-md rounded-3xl p-5 shadow-sm border border-neutral-300/80 mt-1">
                        <h3 class="font-bold text-sm text-neutral-800 mb-3">Utility Boosts</h3>
                        <div class="flex flex-col gap-4">
                        <% if ((locals.storeConfig && locals.storeConfig.enable_cooldown) !== false) { %>
                        <div class="flex justify-between items-center pb-4 border-b border-neutral-200">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-neutral-800">Instant Cooldown Reset</span>
                                <span class="text-[10px] text-neutral-500 mt-0.5">Skip the 45s wait between ad blocks</span>
                            </div>
                            <button onclick="promptStorePurchase('cooldown')" class="bg-neutral-900 text-white text-[10px] font-bold px-3 py-2 rounded-lg shrink-0"><%= ((locals.storeConfig && locals.storeConfig.cooldown) || 500).toLocaleString() %> PTS</button>
                        </div>
                        <% } %>
                        <% if ((locals.storeConfig && locals.storeConfig.enable_multiplier) !== false) { %>
                        <div class="flex justify-between items-center">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-neutral-800">2x Yield Multiplier</span>
                                <span class="text-[10px] text-neutral-500 mt-0.5">Double your ad earnings for 1 Month</span>
                            </div>
                            <button onclick="promptStorePurchase('multiplier')" class="bg-neutral-900 text-white text-[10px] font-bold px-3 py-2 rounded-lg shrink-0"><%= ((locals.storeConfig && locals.storeConfig.multiplier) || 3000).toLocaleString() %> PTS</button>
                        </div>
                        <% } %>
                    </div>
                </div>
            </main>

            <!-- 📱 NAVIGATION BAR WITH NOTIFICATION BADGE -->