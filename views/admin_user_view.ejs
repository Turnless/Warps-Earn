<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Dossier: @<%= user.username || user.telegram_id %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;700&family=Outfit:wght@500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #e6ddd0;
            --glass-bg: rgba(255, 255, 255, 0.6);
            --glass-border: rgba(0, 0, 0, 0.1);
            --glass-glow: 0 4px 24px rgba(0, 0, 0, 0.06);
            --accent-primary: #8b5cf6;
            --accent-cyan: #06b6d4;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: #1a1a16;
            background-image: 
                radial-gradient(circle at 50% -20%, rgba(139, 92, 246, 0.15), transparent 60%);
            min-height: 100vh;
        }

        h1, h2, h3, .font-heading { font-family: 'Outfit', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-glow);
            border-radius: 24px;
        }

        .glass-btn {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(0, 0, 0, 0.1); color: #1a1a16; font-weight: bold;
            backdrop-filter: blur(8px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
            transform: scale(1.02);
        }
    </style>
</head>
<body class="p-6 md:p-12 flex flex-col items-center">
    
    <div class="w-full max-w-4xl flex flex-col gap-8">
        
        <!-- Header Actions -->
        <div class="flex justify-between items-center">
            <a href="/admin" class="glass-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-widest text-neutral-500 hover:text-neutral-900 flex items-center gap-2">
                <span>←</span> Back to Command Center
            </a>
            
            <form action="/admin/user-ban" method="POST" class="inline">
                <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                <% if (user.is_banned) { %>
                    <input type="hidden" name="action" value="unban">
                    <button type="submit" class="glass-btn text-emerald-400 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-emerald-500/10 hover:border-emerald-500/30">Revoke Ban</button>
                <% } else { %>
                    <input type="hidden" name="action" value="ban">
                    <button type="submit" class="glass-btn text-rose-400 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-rose-500/10 hover:border-rose-500/30">Execute Ban</button>
                <% } %>
            </form>
        </div>

        <!-- Main Dossier Card -->
        <div class="glass-panel p-8 md:p-12 relative overflow-hidden flex flex-col gap-10">
            <% if (user.is_banned) { %>
                <div class="absolute inset-0 border-4 border-rose-500/30 rounded-2xl pointer-events-none"></div>
                <div class="absolute top-8 right-8 text-rose-500/20 text-8xl font-black rotate-12 pointer-events-none uppercase">BANNED</div>
            <% } %>

            <!-- Top Identity Section -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 relative z-10">
                <div class="flex items-center gap-6">
                    <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-purple-500/20 flex items-center justify-center text-4xl shadow-inner border border-neutral-300 relative overflow-hidden">
                        <% if (user.photo_url) { %>
                            <img src="<%= user.photo_url %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <span class="relative z-10 font-black text-neutral-600"><%= (user.first_name || 'A').charAt(0).toUpperCase() %></span>
                        <% } %>
                        <% if (user.is_banned) { %>
                            <div class="absolute -bottom-1 -right-1 bg-rose-500 w-6 h-6 rounded-full border-4 border-white"></div>
                        <% } else { %>
                            <div class="absolute -bottom-1 -right-1 bg-emerald-500 w-6 h-6 rounded-full border-4 border-white"></div>
                        <% } %>
                    </div>
                    <div class="flex flex-col gap-1">
                        <h1 class="text-4xl font-heading font-black text-neutral-900 tracking-tight"><%= user.first_name || 'Anonymous' %></h1>
                        <span class="text-lg text-indigo-400 font-mono">@<%= user.username || 'N/A' %></span>
                        <div class="flex gap-2 mt-2">
                            <span class="bg-white/5 border border-neutral-300 px-2.5 py-1 rounded-lg text-[10px] font-mono text-neutral-500"><%= user.telegram_id %></span>
                            <span class="bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold text-indigo-400 uppercase tracking-widest"><%= user.account_tier || 'Standard' %> Tier</span>
                            <span class="bg-amber-500/10 border border-amber-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold text-amber-400 uppercase tracking-widest flex items-center gap-1">🌎 <%= user.country || 'Unknown' %></span>
                        </div>
                    </div>
                </div>
                
                <div class="flex flex-col items-end">
                    <span class="text-[10px] text-neutral-500 uppercase tracking-widest font-bold">Total Wealth</span>
                    <span class="text-4xl font-heading font-black text-emerald-400"><%= (user.points_balance || 0).toLocaleString() %> <span class="text-lg text-neutral-500 font-mono">PTS</span></span>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 relative z-10">
                <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Ads Watched</span>
                    <span class="text-2xl font-mono text-neutral-900 font-bold"><%= user.total_ads_watched || 0 %></span>
                </div>
                <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Referrals</span>
                    <span class="text-2xl font-mono text-neutral-900 font-bold"><%= (user.referrals || []).length %></span>
                </div>
                <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Payouts</span>
                    <span class="text-2xl font-mono text-neutral-900 font-bold"><%= user.withdrawals_count || 0 %></span>
                </div>
                <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest">Joined</span>
                    <span class="text-xs font-mono text-neutral-900 font-bold mt-1"><%= user.created_at ? new Date(user.created_at).toLocaleDateString() : 'Unknown' %></span>
                </div>
            </div>

            <!-- Deep Intelligence & Actions -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10 border-t border-neutral-200 pt-8">
                
                <!-- Security Profile -->
                <div class="flex flex-col gap-4">
                    <h3 class="font-heading font-bold text-lg text-neutral-900 flex items-center gap-2">🛡️ Security Fingerprint</h3>
                    <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-2">
                        <span class="text-[10px] text-neutral-500 uppercase tracking-widest font-bold">Device Hash</span>
                        <div class="text-[10px] font-mono text-neutral-600 break-all bg-white/80 p-3 rounded-lg border border-neutral-200">
                            <%= user.device_fingerprint || 'No fingerprint captured.' %>
                        </div>
                    </div>

                    <h3 class="font-heading font-bold text-lg text-neutral-900 flex items-center gap-2 mt-4">💰 Financial History</h3>
                    <div class="bg-white/60 p-4 rounded-xl border border-neutral-200 flex flex-col gap-3 max-h-[300px] overflow-y-auto">
                        <% if (user.earnings_history && user.earnings_history.length > 0) { %>
                            <% user.earnings_history.forEach(tx => { %>
                                <div class="flex justify-between items-center border-b border-neutral-200 pb-2 last:border-0 last:pb-0">
                                    <div class="flex flex-col">
                                        <span class="text-xs text-neutral-900 font-semibold"><%= tx.type %></span>
                                        <span class="text-[9px] text-neutral-500 font-mono"><%= tx.timestamp %></span>
                                    </div>
                                    <span class="text-xs font-mono font-bold <%= tx.amount > 0 ? 'text-emerald-400' : 'text-rose-400' %>">
                                        <%= tx.amount > 0 ? '+' : '' %><%= tx.amount %>
                                    </span>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <span class="text-xs text-neutral-500 italic">No transactions recorded.</span>
                        <% } %>
                    </div>
                </div>

                <!-- Admin Overrides -->
                <div class="flex flex-col gap-4">
                    <h3 class="font-heading font-bold text-lg text-neutral-900 flex items-center gap-2">⚙️ Direct Interventions</h3>
                    
                    <!-- Adjust Balance -->
                    <form action="/admin/user-manage-balance" method="POST" class="bg-white/60 p-5 rounded-xl border border-neutral-200 flex flex-col gap-4">
                        <div class="flex flex-col gap-1">
                            <span class="text-sm font-bold text-neutral-900">Adjust Ledger Balance</span>
                            <span class="text-[10px] text-neutral-500">Add or deduct PTS manually.</span>
                        </div>
                        <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                        <input type="hidden" name="reason" value="Manual Adjustment from Admin Panel">
                        <div class="flex gap-2">
                            <input type="number" name="amount" placeholder="e.g. 5000 or -5000" class="flex-1 bg-white/80 border border-neutral-300 rounded-lg px-3 py-2 text-neutral-900 font-mono text-sm focus:border-violet-500 focus:outline-none" required>
                            <button type="submit" class="glass-btn px-4 py-2 rounded-lg text-xs font-bold text-neutral-900 uppercase tracking-widest hover:text-violet-400">Apply</button>
                        </div>
                    </form>

                    <!-- Reset Activities -->
                    <form action="/admin/user-clear-activities" method="POST" class="bg-white/60 p-5 rounded-xl border border-neutral-200 flex flex-col gap-4">
                        <div class="flex flex-col gap-1">
                            <span class="text-sm font-bold text-neutral-900">Clear Daily Metrics</span>
                            <span class="text-[10px] text-neutral-500">Resets today's ad limits & cooldowns.</span>
                        </div>
                        <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                        <button type="submit" class="glass-btn px-4 py-3 rounded-lg text-xs font-bold text-rose-400 uppercase tracking-widest text-center hover:bg-rose-500/10" onclick="return confirm('Reset all activities for this user?');">Execute Reset</button>
                    </form>

                    <!-- Delete User -->
                    <form action="/admin/user-delete" method="POST" class="bg-rose-500/10 p-5 rounded-xl border border-rose-500/30 flex flex-col gap-4">
                        <div class="flex flex-col gap-1">
                            <span class="text-sm font-bold text-rose-600">Eradicate User</span>
                            <span class="text-[10px] text-rose-500/80">Permanently deletes account from database.</span>
                        </div>
                        <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                        <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white px-4 py-3 rounded-lg text-xs font-bold uppercase tracking-widest text-center shadow-lg transition-all" onclick="return confirm('WARNING: Are you absolutely sure you want to permanently delete this user? This cannot be undone!');">Annihilate Record</button>
                    </form>

                </div>

            </div>
        </div>
    </div>
</body>
</html>
