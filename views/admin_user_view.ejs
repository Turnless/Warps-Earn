<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>User Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #e6ddd0;
            color: #1a1a16;
        }
        .mono-text {
            font-family: 'Geist Mono', monospace;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-4 selection:bg-neutral-800 selection:text-[#e6ddd0]">
    <div class="w-full max-w-md flex flex-col gap-5 min-h-[calc(100vh-32px)]">

        <header class="w-full flex items-center gap-3 mt-2 mb-2">
            <a href="/admin" class="w-12 h-12 rounded-full bg-white/60 backdrop-blur-md border border-neutral-300/80 flex items-center justify-center text-xl shadow-sm text-neutral-800 hover:bg-white transition-all">←</a>
            <div class="flex flex-col">
                <h1 class="text-base font-bold tracking-tight text-neutral-900 leading-tight">User Profile</h1>
                <span class="text-xs text-neutral-600 font-medium mono-text">Search Result</span>
            </div>
        </header>

        <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-6 border border-neutral-300/80 shadow-sm flex flex-col gap-4">
            <div class="flex items-center gap-4 border-b border-neutral-200 pb-4">
                <div class="w-16 h-16 rounded-full bg-neutral-900 overflow-hidden flex items-center justify-center text-white text-xl font-bold">
                    <% if (user.photo_url) { %>
                        <img src="<%= user.photo_url %>" class="w-full h-full object-cover">
                    <% } else { %>
                        <%= (user.first_name || 'U').charAt(0) %>
                    <% } %>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-lg text-neutral-900"><%= user.first_name %></span>
                    <span class="text-xs font-medium text-neutral-500 mono-text">@<%= user.username || 'N/A' %></span>
                    <span class="text-[10px] bg-neutral-200 text-neutral-600 px-2 py-0.5 rounded mt-1 w-max mono-text"><%= user.telegram_id %></span>
                    <div class="flex gap-2 mt-2">
                        <span class="text-[9px] font-bold bg-indigo-100 text-indigo-800 uppercase px-2 py-0.5 rounded"><%= user.account_tier || 'Standard' %> Tier</span>
                        <span class="text-[9px] font-bold bg-amber-100 text-amber-800 uppercase px-2 py-0.5 rounded"><%= user.country || 'Unknown' %></span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-sm">
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Balance</span>
                    <span class="font-bold text-neutral-900 text-xl"><%= user.points_balance %> PTS</span>
                </div>
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Ads Watched</span>
                    <span class="font-bold text-neutral-900 text-xl"><%= user.total_ads_watched %></span>
                </div>
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Referrals</span>
                    <span class="font-bold text-neutral-900 text-xl"><%= (user.referrals || []).length %></span>
                </div>
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-1">
                    <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Payouts Done</span>
                    <span class="font-bold text-neutral-900 text-xl"><%= user.withdrawals_count || 0 %></span>
                </div>
            </div>

            <div class="mt-2 flex flex-col gap-2">
                <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Device Fingerprint</span>
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 text-xs mono-text text-neutral-600 break-all">
                    <% if (user.device_fingerprint) { %>
                        <%= user.device_fingerprint %>
                    <% } else { %>
                        No fingerprint recorded
                    <% } %>
                </div>
            </div>

            <!-- 🛠️ DYNAMIC COOLDOWN MANAGER -->
            <div class="mt-2 border-t border-neutral-200 pt-4 flex flex-col gap-3">
                <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Cooldown Status</span>
                <div class="flex items-center justify-between bg-neutral-50 p-3 rounded-xl border border-neutral-200">
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-neutral-900"><%= (user.cooldown_until && user.cooldown_until > Date.now()) ? 'Currently Locked ⏳' : 'Active (Ready)' %></span>
                        <span class="text-[9px] text-neutral-500 mono-text">Current Loop Sequence: <%= user.current_session_loop || 0 %>/3</span>
                    </div>
                    <form action="/admin/user-reset-cooldown" method="POST">
                        <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                        <button type="submit" class="bg-indigo-100 text-indigo-700 hover:bg-indigo-200 px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase transition-all">Reset Cooldown</button>
                    </form>
                </div>
            </div>

            <!-- 💰 MANUAL BALANCE ADJUSTMENT -->
            <div class="mt-2 border-t border-neutral-200 pt-4 flex flex-col gap-3">
                <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Update Balance</span>
                <form action="/admin/user-manage-balance" method="POST" class="flex flex-col gap-2 bg-neutral-50 p-3 rounded-xl border border-neutral-200">
                    <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                    <div class="flex gap-2">
                        <input type="number" name="amount" placeholder="+/- Amount (e.g. 500 or -200)" required class="flex-1 px-3 py-2 rounded-lg border border-neutral-300 text-xs focus:outline-none focus:ring-1 focus:ring-neutral-900">
                        <input type="text" name="reason" placeholder="Reason (e.g. Apology Bonus)" class="flex-1 px-3 py-2 rounded-lg border border-neutral-300 text-xs focus:outline-none focus:ring-1 focus:ring-neutral-900">
                    </div>
                    <button type="submit" class="bg-neutral-950 text-[#e6ddd0] w-full py-2 rounded-lg text-[10px] font-bold uppercase tracking-widest hover:bg-neutral-800 transition-all">Apply Adjustment</button>
                </form>
            </div>

            <!-- 🌲 REFERRAL TREE VISUALIZER -->
            <div class="mt-2 border-t border-neutral-200 pt-4 flex flex-col gap-3">
                <span class="text-[10px] uppercase font-bold text-neutral-400 tracking-wider mono-text">Referral Tree (<%= (user.referrals || []).length %>)</span>
                <div class="bg-neutral-50 p-3 rounded-xl border border-neutral-200 flex flex-col gap-2 max-h-48 overflow-y-auto">
                    <% if (user.referrals && user.referrals.length > 0) { %>
                        <% user.referrals.forEach(ref => { %>
                            <div class="flex justify-between items-center text-xs">
                                <a href="/admin/user-lookup?q=<%= ref.telegram_id %>" class="font-bold text-neutral-900 hover:underline">@<%= ref.username.replace('@','') %></a>
                                <% if (ref.qualified || ref.ads_viewed >= 20) { %>
                                    <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[9px] font-bold uppercase">Qualified</span>
                                <% } else { %>
                                    <span class="bg-neutral-200 text-neutral-600 px-2 py-0.5 rounded text-[9px] font-bold uppercase"><%= ref.ads_viewed || 0 %>/20 Ads</span>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <span class="text-xs text-neutral-500 italic">No referrals found.</span>
                    <% } %>
                </div>
            </div>

            <div class="mt-4 pt-4 border-t border-neutral-200">
                <form action="/admin/user-clear-activities" method="POST" class="mb-3">
                    <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                    <button type="submit" class="w-full bg-orange-500 hover:bg-orange-600 text-white rounded-xl py-3 text-xs font-bold uppercase tracking-wider shadow-md">
                        Clear All Activities (Reset)
                    </button>
                </form>

                <form action="/admin/user-delete" method="POST" class="mb-3">
                    <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white rounded-xl py-3 text-xs font-bold uppercase tracking-wider shadow-md" onclick="return confirm('Are you sure you want to permanently delete this user? This cannot be undone.');">
                        Delete User Profile
                    </button>
                </form>

                <form action="/admin/user-ban" method="POST">
                    <input type="hidden" name="telegram_id" value="<%= user.telegram_id %>">
                    <% if (user.is_banned) { %>
                        <div class="bg-rose-100 text-rose-800 p-3 rounded-xl text-xs font-bold mb-3 flex items-center gap-2 border border-rose-200">
                            <span class="text-base">⚠️</span> USER IS CURRENTLY BANNED
                        </div>
                        <input type="hidden" name="action" value="unban">
                        <button type="submit" class="w-full bg-neutral-900 hover:bg-neutral-800 text-white rounded-xl py-3 text-xs font-bold uppercase tracking-wider">
                            Unban User
                        </button>
                    <% } else { %>
                        <input type="hidden" name="action" value="ban">
                        <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white rounded-xl py-3 text-xs font-bold uppercase tracking-wider shadow-md">
                            Permanently Ban User
                        </button>
                    <% } %>
                </form>
            </div>
        </div>

    </div>
</body>
</html>
