        }

        function closeWithdrawalFlow() {
            document.getElementById('withdrawal-flow').classList.add('hidden');
        }

        function resetFlowToCountry() {
            activeAsset = '';
            activeCountryContext = '';

            document.getElementById('step-country').classList.remove('hidden');
            document.getElementById('wrapper-currency').classList.add('hidden');
            document.getElementById('wrapper-details').classList.add('hidden');
            document.getElementById('bank-select-dropdown').classList.add('hidden');
            document.getElementById('wrapper-fiat-calc').classList.add('hidden');
            document.getElementById('input-destination').value = '';
