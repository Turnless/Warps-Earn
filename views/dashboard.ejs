    </div>

    <!-- 🎯 BOUNTY SUBMISSION MODAL -->
    <div id="bounty-modal" class="fixed inset-0 z-50 hidden flex-col justify-end bg-neutral-950/80 backdrop-blur-sm transition-opacity">
