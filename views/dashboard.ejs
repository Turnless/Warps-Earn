<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Warps Earn Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://sad.adsgram.ai/js/sad.min.js"></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;600&family=Space+Grotesk:wght@400;500;700&display=swap"
        rel="stylesheet">

    <style>
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: #e6ddd0;
            color: #1a1a16;
        }

        .mono-text {
            font-family: 'Geist Mono', monospace;
        }

        .active-tab {
            background-color: #1a1a16;
            color: #e6ddd0;
        }

        nav {
            position: fixed !important;
            bottom: 16px !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            width: calc(100% - 32px) !important;
            max-width: 418px !important;
            z-index: 50 !important;
        }

        main {
            padding-bottom: 95px !important;
        }
    </style>

    <!-- OnClickA Ad Manager SDK -->
    <script src="https://js.onclckvd.com/in-stream-ad-admanager/tma.js"></script>


</head>

<body class="min-h-screen flex flex-col items-center justify-start p-4 selection:bg-neutral-800 selection:text-[#e6ddd0]">

    <div class="w-full max-w-md flex flex-col min-h-[calc(100vh-32px)]">

        <% var incompleteCount=0; 
            if (!user.quests || !user.quests.channel) incompleteCount++; 
            if (!user.quests || !user.quests.group) incompleteCount++; 
            if (!user.quests || !user.quests.payout_channel) incompleteCount++;
            if (!user.quests || !user.quests.x_account) incompleteCount++; 

            if (typeof dynamicQuests !== 'undefined') {
                Object.keys(dynamicQuests).forEach(k => {
                    let q = dynamicQuests[k];
                    if (!user.custom_promos || !user.custom_promos[k]) {
                        if (!q.target_countries || q.target_countries.length === 0 || q.target_countries.includes(user.country)) {
                            incompleteCount++;
                        }
                    }
                });
            }

            if (typeof bounties !== 'undefined') {
                bounties.forEach(b => {
                    if (!b.target_countries || b.target_countries.length === 0 || b.target_countries.includes(user.country)) {
                        incompleteCount++;
                    }
                });
            }

            var firstWithdrawalDone=(user.withdrawals_count && user.withdrawals_count> 0);

            var totalRefs = (user.referrals || []).length;
            var qualifiedRefs = (user.referrals || []).filter(r => r.qualified).length;

            var nextMilestoneTarget = 10;
            var prevMilestoneTarget = 0;
            var rewardValue = "$5.00";

            if (qualifiedRefs >= 50) {
            nextMilestoneTarget = 100;
            prevMilestoneTarget = 50;
            rewardValue = "$25.00";
            } else if (qualifiedRefs >= 20) {
            nextMilestoneTarget = 50;
            prevMilestoneTarget = 20;
            rewardValue = "$15.00";
            } else if (qualifiedRefs >= 10) {
            nextMilestoneTarget = 20;
            prevMilestoneTarget = 10;
            rewardValue = "$5.00";
            }

            var rangeFactor = nextMilestoneTarget - prevMilestoneTarget;
            var relativeProgress = qualifiedRefs - prevMilestoneTarget;
            var contestProgressPct = Math.min(Math.max((relativeProgress / rangeFactor) * 100, 0), 100);
            %>

            <!-- 🍞 PREMIUM TOAST NOTIFICATION -->
            <div id="custom-toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] transform -translate-y-24 opacity-0 transition-all duration-300 bg-neutral-950 text-[#e6ddd0] px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 border border-neutral-800 text-xs font-bold uppercase tracking-wider mono-text w-[calc(100%-32px)] max-w-[418px]">
                <span id="toast-icon">⚡</span>
                <span id="toast-message">Verification Complete</span>
            </div>

            <!-- 🛡️ CUSTOM TRANSACTION CONFIRMATION MODAL -->
            <div id="custom-confirm-modal" class="hidden fixed inset-0 z-[160] bg-neutral-950/80 backdrop-blur-md flex items-center justify-center p-4">
                <div class="w-full max-w-sm bg-white rounded-3xl p-6 border border-neutral-200 shadow-2xl flex flex-col gap-4 text-neutral-900">
                    <div class="flex items-center gap-2 pb-2 border-b border-neutral-100">
                        <span class="text-lg">🛡️</span>
                        <h3 class="font-bold text-xs uppercase tracking-wider text-neutral-400 mono-text">Confirm Withdrawal</h3>
                    </div>

                    <div class="flex flex-col gap-3 text-xs leading-normal">
                        <div class="flex justify-between items-center bg-neutral-50 p-2.5 rounded-xl border border-neutral-100">
                            <span class="text-neutral-500 font-medium">Payment Method:</span>
                            <span id="confirm-display-asset" class="font-bold text-neutral-900 mono-text">USDT (BEP20)</span>
                        </div>

                        <div class="flex justify-between items-center bg-neutral-50 p-2.5 rounded-xl border border-neutral-100">
                            <span class="text-neutral-500 font-medium">Amount:</span>
                            <span id="confirm-display-pts" class="font-bold text-neutral-900 mono-text">1,500 PTS</span>
                        </div>

                        <div class="flex flex-col gap-1 bg-neutral-50 p-3 rounded-xl border border-neutral-100">
                            <span class="text-neutral-500 font-medium">Sending to:</span>
                            <p id="confirm-display-destination" class="font-bold text-neutral-900 text-[11px] break-all mono-text bg-white p-2 rounded-lg border border-neutral-200/60 mt-1 select-all"></p>
                        </div>

                        <div id="confirm-display-conversion-box" class="flex justify-between items-center bg-emerald-50 text-emerald-800 p-2.5 rounded-xl border border-emerald-100 font-bold mono-text">
                            <span>You'll receive:</span>
                            <span id="confirm-display-conversion">$1.20 USD</span>
                        </div>
                    </div>

                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-2xl flex gap-2 text-[10px] text-amber-800 leading-normal font-medium">
                        <span class="text-xs">⚠️</span>
                        <span>Double-check your details. Points are deducted immediately and can't be reversed.</span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <button type="button" onclick="closeConfirmModal()" class="py-3 border border-neutral-200 hover:bg-neutral-50 rounded-xl font-bold text-xs uppercase text-neutral-500 tracking-wider transition-all shadow-sm">Cancel</button>
                        <button type="button" id="btn-modal-action-confirm" class="py-3 bg-neutral-950 hover:bg-neutral-900 text-[#e6ddd0] rounded-xl font-bold text-xs uppercase tracking-wider transition-all shadow-md">Confirm</button>
                    </div>
                </div>
            </div>

            <div id="fallback-player-modal" class="hidden fixed inset-0 z-[150] bg-neutral-950/90 backdrop-blur-md flex flex-col justify-between p-6 max-w-md mx-auto">
                <div class="w-full flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                        <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider mono-text">Watching Ad</span>
                    </div>
                    <button id="fallback-close-btn" disabled class="bg-neutral-800 text-neutral-500 font-bold text-[11px] px-3 py-1.5 rounded-xl uppercase tracking-wider transition-all cursor-not-allowed">Wait 15s</button>
                </div>

                <div class="w-full h-3/4 my-4 bg-black rounded-3xl border border-neutral-800/80 overflow-hidden relative shadow-inner">
                    <div id="fallback-loading-spinner" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-[#e6ddd0]">
                        <div class="w-10 h-10 border-4 border-[#e6ddd0]/30 border-t-[#e6ddd0] rounded-full animate-spin"></div>
                        <p class="text-[10px] uppercase tracking-widest font-bold text-neutral-400 mono-text">Loading ad...</p>
                    </div>
                    <iframe id="fallback-ad-iframe" class="w-full h-full border-0 hidden" sandbox="allow-scripts allow-popups allow-same-origin"></iframe>
                </div>

                <div class="w-full text-center flex flex-col gap-2">
                    <p id="fallback-countdown-text" class="text-sm font-medium text-neutral-300">Watch the ad to earn your points.</p>
                    <div class="w-full bg-neutral-900 rounded-full h-1 border border-neutral-800 overflow-hidden">
                        <div id="fallback-progress-bar" class="bg-emerald-500 h-1 rounded-full transition-all duration-1000" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <!-- HEADER PROFILE BLOCK -->
            <header class="w-full flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-full bg-neutral-900 border-2 border-neutral-950/20 overflow-hidden flex items-center justify-center text-[#e6ddd0] font-bold text-lg relative shadow-inner">
                    <% if (user.photo_url) { %>
                        <img src="<%= user.photo_url %>" alt="pfp" class="w-full h-full object-cover">
                    <% } else { %>
                        <%= (user.username || 'A' ).substring(0, 2).toUpperCase() %>
                    <% } %>
                </div>

                <div class="flex flex-col">
                    <h1 class="text-base font-bold tracking-tight text-neutral-900 leading-tight">
                        <%= user.first_name || 'User' %>
                    </h1>
                    <span class="text-xs text-neutral-600 font-medium">@<%= user.username || 'Anonymous' %></span>
                </div>
            </header>

            <main class="w-full flex-1 flex flex-col gap-4 justify-start">

                <!-- 🏠 HOME VIEW -->
                <div id="view-home" class="flex flex-col gap-4 w-full">
                    <div class="w-full bg-neutral-950 text-[#e6ddd0] rounded-3xl p-6 border border-neutral-900 relative overflow-hidden shadow-lg">
                        <div class="absolute inset-0 opacity-5 pointer-events-none bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:14px_24px]"></div>

                        <div class="relative z-10">
                            <span class="text-xs uppercase tracking-wider text-neutral-400 font-medium mono-text">Your Balance</span>
                        </div>

                        <div class="mt-4 mb-2 relative z-10 flex items-baseline gap-2">
                            <span id="user-balance" class="text-5xl font-bold tracking-tight text-neutral-100">
                                <%= (user.points_balance || 0).toLocaleString() %>
                            </span>
                            <span class="text-sm font-medium tracking-widest text-neutral-400 mono-text">PTS</span>
                        </div>

                        <div class="pt-3 border-t border-neutral-800 text-xs text-neutral-400 flex justify-between items-center relative z-10 mono-text">
                            <span>Est. Value:</span>
                            <span id="user-value" class="text-neutral-200 font-medium text-sm">$<%= ((user.points_balance || 0) * 0.0008).toFixed(2) %> USD</span>
                        </div>
                    </div>

                    <div class="w-full bg-white/60 backdrop-blur-md rounded-3xl p-5 border border-neutral-300/80 shadow-sm flex flex-col gap-4">
                        <div class="flex justify-between items-center pb-2 border-b border-neutral-200/60 text-xs text-neutral-600">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span class="font-medium">Status: <span class="mono-text text-neutral-900 font-bold">READY</span></span>
                            </div>
                            <span class="mono-text text-[10px]">+<%= (locals.settings && locals.settings.reward_per_ad) || 3 %> PTS PER ROUND</span>
                        </div>

                        <button id="adsgram-play-btn" onclick="triggerAdNetworkSequence()" class="w-full bg-neutral-900 hover:bg-neutral-800 active:scale-[0.98] transition-all text-[#e6ddd0] rounded-2xl p-4 flex items-center justify-between shadow-md group">
                            <div class="flex items-center gap-3.5">
                                <div id="ad-btn-icon" class="w-10 h-10 rounded-xl bg-neutral-800 flex items-center justify-center text-xl border border-neutral-700 transition-all">⚡</div>
                                <div class="text-left">
                                    <h3 id="ad-btn-title" class="font-bold text-sm tracking-wide text-white">Watch Ad</h3>
                                    <p id="ad-btn-subtitle" class="text-xs text-neutral-400 mono-text mt-0.5">Watch short ads to earn points</p>
                                </div>
                            </div>
                            <div id="ad-btn-arrow" class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-sm font-bold group-hover:translate-x-0.5 transition-transform">→</div>
                        </button>

                        <div class="w-full bg-neutral-100/80 rounded-xl p-3 flex justify-between items-center border border-neutral-200/40 text-xs">
                            <span class="text-neutral-600 font-medium">Total ads watched:</span>
                            <span id="total-ads-watched" class="font-bold text-neutral-900 bg-white px-2.5 py-0.5 rounded-md border border-neutral-200 shadow-sm mono-text">
                                <%= user.total_ads_watched || user.video_views || 0 %>
                            </span>
                        </div>
                    </div>

                    <!-- 🚀 NEW FEATURE: LOGIN STREAK & VIP STATUS -->
                    <div class="grid grid-cols-2 gap-3 w-full">
                        <!-- Daily Streak Card -->
                        <div class="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/60 rounded-3xl p-4 flex flex-col justify-between relative overflow-hidden shadow-sm">
                            <div class="absolute -right-4 -bottom-4 text-6xl opacity-10">🔥</div>
                            <div class="flex flex-col gap-1 z-10">
                                <span class="text-[10px] font-extrabold text-amber-600 tracking-wider uppercase mono-text">Login Streak</span>
                                <span class="text-2xl font-black text-amber-950"><%= user.login_streak || 0 %><span class="text-sm text-amber-700 ml-1">Days</span></span>
                            </div>
                            <div class="mt-3 z-10">
                                <div class="w-full h-1.5 bg-amber-200/50 rounded-full overflow-hidden">
                                    <div class="h-full bg-amber-500 rounded-full" style="width: <%= Math.min(((user.login_streak || 0) % 7) / 7 * 100, 100) %>%"></div>
                                </div>
                                <span class="text-[9px] text-amber-700 font-bold mt-1 block">7-day streak = bonus reward!</span>
                            </div>
                        </div>

                        <!-- VIP Status Card -->
                        <div class="bg-gradient-to-br from-slate-900 to-neutral-900 border border-neutral-800 rounded-3xl p-4 flex flex-col justify-between relative overflow-hidden shadow-sm">
                            <div class="absolute -right-2 -bottom-2 text-6xl opacity-10">👑</div>
                            <div class="flex flex-col gap-1 z-10">
                                <span class="text-[10px] font-extrabold text-neutral-400 tracking-wider uppercase mono-text">Account Tier</span>
                                <% if ((user.ad_multiplier || 1) >= 2 || (user.referrals && user.referrals.length >= 50)) { %>
                                    <span class="text-xl font-black text-amber-400">GOLD VIP</span>
                                <% } else { %>
                                    <span class="text-xl font-black text-white">STANDARD</span>
                                <% } %>
                            </div>
                            <div class="mt-3 z-10 flex items-center justify-between">
                                <span class="text-[9px] text-neutral-400 font-medium">Earnings Boost:</span>
                                <span class="text-[10px] font-bold text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded uppercase mono-text"><%= user.ad_multiplier || 1 %>x</span>
                            </div>
                        </div>
                        </div>
                        
                        <!-- 🚀 NEW FEATURE: BOUNTY HUB BANNER -->
                        <div class="w-full mt-1 bg-gradient-to-r from-indigo-600 to-violet-600 rounded-3xl p-5 border border-indigo-500/50 shadow-lg relative overflow-hidden group cursor-pointer" onclick="switchTab('tasks', 'nav-tasks')">
                            <!-- Background elements -->
                            <div class="absolute -right-6 -bottom-6 text-7xl opacity-20 transform group-hover:scale-110 group-hover:rotate-12 transition-transform duration-500">🎯</div>
                            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPjxyZWN0IHdpZHRoPSI4IiBoZWlnaHQ9IjgiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSIvPjxwYXRoIGQ9Ik0wIDBMOCA4Wk04IDBMMCA4WiIgc3Ryb2tlPSIjZmZmIiBzdHJva2Utb3BhY2l0eT0iMC4wNSIvPjwvc3ZnPg==')] opacity-30"></div>
                            
                            <div class="relative z-10 flex flex-col gap-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="bg-indigo-950/50 text-indigo-200 text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded mono-text backdrop-blur-sm border border-indigo-400/30">New Feature</span>
                                </div>
                                <h3 class="text-white font-black text-xl tracking-tight">Earn PTS - Social Tasks</h3>
                                <p class="text-indigo-100/80 text-xs font-medium max-w-[80%]">Get paid to like, repost, and engage on X (Twitter).</p>
                                
                                <div class="mt-4 flex items-center justify-between">
                                    <span class="text-xs font-bold text-white mono-text">Up to +1,000 PTS / Task</span>
                                    <div class="w-8 h-8 rounded-full bg-white text-indigo-600 flex items-center justify-center font-bold text-lg shadow-sm group-hover:translate-x-1 transition-transform">→</div>
                                </div>
                            </div>
                        </div>

                </div>

                <!-- 💰 WALLET HUB -->
                <div id="view-wallet" class="hidden flex flex-col gap-4 w-full">
                    <% var personalThreshold=firstWithdrawalDone ? 1250 : 1500; var isUplinePromoter=(qualifiedRefs>=10);
                        var globalClearedStatus = (user.points_balance >= personalThreshold || isUplinePromoter);
                    %>

                        <div class="w-full bg-neutral-950 text-[#e6ddd0] rounded-3xl p-5 shadow-md flex flex-col gap-4 relative overflow-hidden">
                            <div class="absolute right-[-10px] top-[-10px] text-6xl opacity-10 select-none">💳</div>

                            <div class="flex flex-col gap-1">
                                <span class="text-[10px] tracking-widest uppercase font-bold text-neutral-400 mono-text">Your Balance</span>
                                <div class="flex items-baseline gap-1.5">
                                    <span id="wallet-balance" class="text-3xl font-extrabold tracking-tight text-white">
                                        <%= (user.points_balance || 0).toLocaleString() %>
                                    </span>
                                    <span class="text-xs font-bold text-neutral-400 mono-text">PTS</span>
                                </div>
                            </div>

                            <div class="p-3 bg-neutral-900 border border-neutral-800/80 rounded-xl flex items-start gap-2 text-[11px] text-neutral-400 leading-normal">
                                <span class="text-xs mt-0.5">ℹ️</span>
                                <span>
                                    <% if (user.account_tier === 'Gold') { %>
                                        <b class="text-amber-400">Gold Tier</b> — Min withdrawal: <b class="text-white mono-text">1,000 PTS ($0.80)</b>.
                                        Up to <b class="text-emerald-400 mono-text">3 withdrawals/day</b>. Instant processing. No limits.
                                    <% } else if (user.account_tier === 'Premium') { %>
                                        <b class="text-violet-400">Premium Tier</b> — First withdrawal: <b class="text-white mono-text">1,500 PTS ($1.20)</b>.
                                        After that, min drops to <b class="text-emerald-400 mono-text">1,250 PTS ($1.00)</b>. Up to 2/day. 1h processing.
                                    <% } else { %>
                                        <b class="text-neutral-200">Standard Tier</b> — First withdrawal: <b class="text-white mono-text">1,500 PTS ($1.20)</b>.
                                        After that, min drops to <b class="text-emerald-400 mono-text">1,250 PTS ($1.00)</b>. Max 1/day. 24h processing.
                                    <% } %>
                                </span>
                            </div>

                            <button onclick="openWithdrawalFlow()" class="w-full bg-white text-neutral-950 font-bold text-xs py-3 rounded-xl uppercase tracking-wider active:scale-[0.98] transition-all shadow-sm">Withdraw</button>

                            <div class="text-[11px] text-neutral-400 flex items-center gap-1.5 mt-1 border-t border-neutral-800 pt-2">
                                <span>Value:</span>
                                <span id="wallet-valuation" class="text-emerald-400 font-bold mono-text">$<%= ((user.points_balance || 0) * 0.0008).toFixed(2) %> USD</span>
                                <span>•</span>
                                <span>Min:</span>
                                <span class="font-bold underline text-neutral-300"><%= personalThreshold %> PTS</span>
                            </div>
                        </div>



                        <div id="withdrawal-flow" class="hidden w-full bg-white/70 backdrop-blur-md border border-neutral-300/80 rounded-3xl p-5 shadow-sm flex flex-col gap-4">
                            <div class="flex justify-between items-center border-b border-neutral-200/60 pb-2">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-neutral-400 mono-text">Withdraw</span>
                                <button onclick="closeWithdrawalFlow()" class="text-xs font-bold text-neutral-400 hover:text-neutral-600 transition-all">✕ Close</button>
                            </div>

                            <div id="step-country" class="flex flex-col gap-2">
                                <label class="text-xs font-bold text-neutral-700">1. Select your region:</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <button type="button" onclick="setCountry('NG')" class="border border-neutral-300 bg-white hover:bg-neutral-50 px-4 py-3 rounded-xl font-bold text-xs text-neutral-800 transition-all text-center shadow-sm">🇳🇬 Nigeria</button>
                                    <button type="button" onclick="setCountry('INTL')" class="border border-neutral-300 bg-white hover:bg-neutral-50 px-4 py-3 rounded-xl font-bold text-xs text-neutral-800 transition-all text-center shadow-sm">🌐 Other Countries</button>
                                </div>
                            </div>

                            <div id="wrapper-currency" class="hidden flex flex-col gap-2">
                                <div class="flex justify-between items-center">
                                    <label class="text-xs font-bold text-neutral-700">2. Choose payment method:</label>
                                    <button type="button" onclick="resetFlowToCountry()" class="text-[10px] font-bold text-neutral-400 uppercase tracking-tight">← Back</button>
                                </div>
                                <div id="container-currency" class="grid grid-cols-2 gap-2"></div>
                            </div>

                            <div id="wrapper-details" class="hidden flex flex-col gap-3 pt-2 border-t border-neutral-200/60">
                                <div id="bank-select-dropdown" class="hidden flex flex-col gap-1">
                                    <label class="text-xs font-bold text-neutral-700">Select Bank</label>
                                    <select id="select-bank-provider" class="w-full px-3 py-2.5 rounded-xl border border-neutral-300 bg-white text-xs font-bold text-neutral-800 focus:outline-none">
                                        <option value="OPAY">OPay Digital Bank</option>
                                        <option value="PALMPAY">PalmPay Limited</option>
                                    </select>
                                </div>

                                <div class="flex flex-col gap-1">
                                    <label class="text-xs font-bold text-neutral-700">Withdrawal Amount (PTS)</label>
                                    <input type="number" id="input-amount-pts" placeholder="Min. <%= personalThreshold %> PTS" oninput="calculateDynamicYield()" class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 bg-white text-xs font-medium focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-800 shadow-inner">
                                </div>

                                <div class="flex flex-col gap-1">
                                    <label id="label-input-address" class="text-xs font-bold text-neutral-700">Account Details</label>
                                    <input type="text" id="input-destination" placeholder="Enter your account number or address..." class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 bg-white text-xs font-medium focus:outline-none focus:ring-2 focus:ring-neutral-950 text-neutral-800 shadow-inner">
                                </div>

                                <div id="wrapper-fiat-calc" class="hidden p-3 bg-neutral-100 rounded-xl border border-neutral-200 text-[11px] text-neutral-600 flex flex-col gap-1 mono-text">
                                    <div class="flex justify-between items-center w-full">
                                        <span>You'll receive:</span>
                                        <span id="display-yield-value" class="font-bold text-neutral-900">$0.00 USD</span>
                                    </div>
                                </div>

