            <button type="button" onclick="setAsset('TON')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">TON Native</button>
            <button type="button" onclick="setAsset('STARS')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">TG Stars</button>
            <button type="button" onclick="setAsset('SOL')" class="border border-neutral-300 bg-white px-2 py-2.5 rounded-xl font-bold text-[11px] text-neutral-700 truncate shadow-sm active:scale-95 transition-all">Solana Network</button>
        `;
