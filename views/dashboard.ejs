        function calculateDynamicYield() {
            const ptsInput = document.getElementById('input-amount-pts');
            const ptsVal = parseFloat(ptsInput.value) || 0;
            const yieldDisplay = document.getElementById('display-yield-value');

            const usdVal = ptsVal * 0.0008;

            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                yieldDisplay.innerHTML = `
                <span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>
                <span class="text-neutral-400 font-medium px-1">•</span>
                <span class="text-emerald-700 font-bold">₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} NGN</span>
            `;
            } else {
                yieldDisplay.innerHTML = `<span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>`;
            }
        }

        function openConfirmModal() {
            const inputVal = document.getElementById('input-destination').value.trim();
            const inputAmountVal = parseInt(document.getElementById('input-amount-pts').value) || 0;

            if (!activeAsset) return showToast("Please select your withdrawal channel target.", "⚠️");
            if (inputAmountVal <= 0) return showToast("Please specify a valid positive PTS amount.", "⚠️");

            if (activeAsset === 'NAIRA' && !/^\d{10}$/.test(inputVal)) {
                return showToast("Naira payout details must be exactly 10 numeric digits.", "⚠️");
            }

            if (!inputVal) return showToast("Please input destination settlement parameters.", "⚠️");

            document.getElementById('confirm-display-asset').innerText = activeAsset.replace('_', ' ');
            document.getElementById('confirm-display-pts').innerText = `${inputAmountVal.toLocaleString()} PTS`;
            document.getElementById('confirm-display-destination').innerText = inputVal;

            const usdVal = inputAmountVal * 0.0008;
            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                document.getElementById('confirm-display-conversion').innerHTML = `$${usdVal.toFixed(2)} USD • ₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            } else {
                document.getElementById('confirm-display-conversion').innerText = `$${usdVal.toFixed(2)} USD`;
            }

            const confirmBtn = document.getElementById('btn-modal-action-confirm');
