        function setAsset(assetType) {
            activeAsset = assetType;

            const detailsWrapper = document.getElementById('wrapper-details');
            const bankDropdown = document.getElementById('bank-select-dropdown');
            const addressLabel = document.getElementById('label-input-address');
            const addressInput = document.getElementById('input-destination');
            const fiatCalc = document.getElementById('wrapper-fiat-calc');

            detailsWrapper.classList.remove('hidden');
            fiatCalc.classList.remove('hidden');

            if (assetType === 'NAIRA') {
                bankDropdown.classList.remove('hidden');
                addressLabel.innerText = "3. Your Account Number";
                addressInput.placeholder = "Enter your 10-digit account number...";
            } else {
                bankDropdown.classList.add('hidden');

                if (assetType === 'STARS') {
                    addressLabel.innerText = "3. Your Telegram Username";
                    addressInput.placeholder = "@your_telegram_username";
                } else {
                    addressLabel.innerText = `3. Your ${assetType.split('_')[0]} Wallet Address`;
                    addressInput.placeholder = `Paste your ${assetType.split('_')[0]} address...`;
                }
            }
            calculateDynamicYield();
        }

        function calculateDynamicYield() {
            const ptsInput = document.getElementById('input-amount-pts');
            const ptsVal = parseFloat(ptsInput.value) || 0;
            const yieldDisplay = document.getElementById('display-yield-value');

            const usdVal = ptsVal * 0.0008;

            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                yieldDisplay.innerHTML = `
                <span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>
                <span class="text-neutral-400 font-medium px-1">•</span>
                <span class="text-emerald-700 font-bold">₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} NGN</span>
            `;
            } else {
                yieldDisplay.innerHTML = `<span class="text-neutral-900 font-bold">$${usdVal.toFixed(2)} USD</span>`;
            }
        }

        function openConfirmModal() {
            const inputVal = document.getElementById('input-destination').value.trim();
            const inputAmountVal = parseInt(document.getElementById('input-amount-pts').value) || 0;

            if (!activeAsset) return showToast("Pick a payment method first.", "⚠️");
            if (inputAmountVal <= 0) return showToast("Enter a valid amount.", "⚠️");

            if (activeAsset === 'NAIRA' && !/^\d{10}$/.test(inputVal)) {
                return showToast("Account number must be exactly 10 digits.", "⚠️");
            }

            if (!inputVal) return showToast("Enter your account details.", "⚠️");

            document.getElementById('confirm-display-asset').innerText = activeAsset.replace('_', ' ');
            document.getElementById('confirm-display-pts').innerText = `${inputAmountVal.toLocaleString()} PTS`;
            document.getElementById('confirm-display-destination').innerText = inputVal;

            const usdVal = inputAmountVal * 0.0008;
            if (activeCountryContext === 'NG') {
                const nairaVal = usdVal * 1600;
                document.getElementById('confirm-display-conversion').innerHTML = `$${usdVal.toFixed(2)} USD • ₦${nairaVal.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            } else {
                document.getElementById('confirm-display-conversion').innerText = `$${usdVal.toFixed(2)} USD`;
            }

            const confirmBtn = document.getElementById('btn-modal-action-confirm');
            confirmBtn.onclick = () => {
                closeConfirmModal();
                fireWithdrawalPayload();
            };

            document.getElementById('custom-confirm-modal').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('custom-confirm-modal').classList.add('hidden');
        }

        async function fireWithdrawalPayload() {
            const inputVal = document.getElementById('input-destination').value.trim();
            const inputAmountVal = parseInt(document.getElementById('input-amount-pts').value) || 0;
            const bankVal = getBankProviderValue();

            const requestPayload = {
                telegram_id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                points_to_withdraw: inputAmountVal,
                country_context: activeCountryContext,
                payment_provider: activeAsset === 'NAIRA' ? (bankVal || 'OPAY') : activeAsset,
                destination_account: inputVal,
                id: window.Telegram?.WebApp?.initDataUnsafe?.user?.id || "<%= user.telegram_id %>",
                amount: inputAmountVal,
                destination: inputVal,
                asset: activeAsset,
                bank: activeAsset === 'NAIRA' ? (bankVal || 'OPAY') : null
            };

            showToast("Submitting withdrawal...", "⚡");

            try {
                const telegramInitData = window.Telegram?.WebApp?.initData || "";

                let response = await fetch('/portal/request-payout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `WebApp ${telegramInitData}`
                    },
                    body: JSON.stringify(requestPayload)
                });

                if (response.status === 404) {
                    console.log("⚠️ Portal router returned 404. Falling back to root /request-payout route...");
                    response = await fetch('/request-payout', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `WebApp ${telegramInitData}`
                        },
                        body: JSON.stringify(requestPayload)
                    });
                }

                if (response.ok) {
                    showToast("Withdrawal submitted!", "✅");

                    closeWithdrawalFlow();

                    const userBalanceEl = document.getElementById('user-balance');
                    const walletBalanceEl = document.getElementById('wallet-balance');

                    const oldBalance = parseInt(userBalanceEl.innerText.replace(/,/g, '')) || 0;
                    const newBalance = Math.max(0, oldBalance - inputAmountVal);

                    userBalanceEl.innerText = newBalance.toLocaleString();
                    if (walletBalanceEl) {
                        walletBalanceEl.innerText = newBalance.toLocaleString();
                    }

                    const newUsdVal = newBalance * 0.0008;
                    const userValEl = document.getElementById('user-value');
                    const walletValEl = document.getElementById('wallet-valuation');

                    if (userValEl) userValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;
                    if (walletValEl) walletValEl.innerText = `$${newUsdVal.toFixed(2)} USD`;

                    const listWithdrawals = document.getElementById('list-withdrawals');
                    const emptyPlaceholder = listWithdrawals.querySelector('.text-center');
                    if (emptyPlaceholder) {
                        emptyPlaceholder.remove();
                    }

                    const optionsDate = { month: 'short', day: 'numeric', year: 'numeric' };
                    const optionsTime = { hour: '2-digit', minute: '2-digit', hour12: true };
                    const dateStr = new Date().toLocaleDateString('en-US', optionsDate);
                    const timeStr = new Date().toLocaleTimeString('en-US', optionsTime);
                    const currentFormattedTimestamp = `${dateStr} • ${timeStr}`;

                    const newTxRow = document.createElement('div');
                    newTxRow.className = "flex justify-between items-center pb-2.5 border-b border-neutral-200/50 last:border-0 last:pb-0";
                    newTxRow.innerHTML = `
                    <div class="flex flex-col">
                        <span class="text-xs font-bold text-neutral-800">Withdrawal (${activeAsset.replace('_', ' ')})</span>
                        <span class="text-[9px] text-neutral-400 mono-text">${currentFormattedTimestamp}</span>
                    </div>
                    <div class="flex flex-col items-end">
                        <span class="text-xs font-bold text-blue-700 mono-text">-$${(inputAmountVal * 0.0008).toFixed(2)} USD</span>
                        <span class="text-[9px] uppercase tracking-wider font-extrabold text-amber-500 animate-pulse mono-text">Pending</span>
                    </div>
                `;

                    listWithdrawals.insertBefore(newTxRow, listWithdrawals.firstChild);

                    document.getElementById('input-destination').value = '';
                    if (document.getElementById('input-amount-pts')) {
                        document.getElementById('input-amount-pts').value = '';
                    }

                    switchHistory('withdrawals');

                    if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.HapticFeedback) {
                        window.Telegram.WebApp.HapticFeedback.notificationOccurred('success');
                    }
                } else {
                    const errMsg = await response.text();
                    showToast(`Withdrawal failed: ${errMsg}`, "❌");
                }
            } catch (err) {
                showToast("Connection error. Try again.", "❌");
            }
        }

        // --- Ad Network Config ---
