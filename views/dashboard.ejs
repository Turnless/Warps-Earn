                                <span class="text-[10px] text-neutral-500 mt-0.5">Double your ad earnings for 1 Month</span>
                            </div>
                            <button onclick="promptStorePurchase('multiplier')" class="bg-neutral-900 text-white text-[10px] font-bold px-3 py-2 rounded-lg shrink-0"><%= ((locals.storeConfig && locals.storeConfig.multiplier) || 3000).toLocaleString() %> PTS</button>
                        </div>
