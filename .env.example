# TELEGRAM BOT CREDENTIALS
# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# DYNAMIC ROUTING (Only needed for local testing)
SERVER_URL=https://your-app-name.onrender.com

# LOCAL PORT
PORT=3000

# ADMIN SECRET
# Used for admin dashboard authentication and payout approval signing
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_SIGNATURE=your_admin_secret_here

# PUBLIC PAYOUT CHANNEL
# Telegram channel username for posting payout proofs (with @ prefix)
PUBLIC_PAYOUT_CHANNEL_ID=@your_channel_username

# MONGODB CONNECTION
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your-cluster.mongodb.net/your_dbname?retryWrites=true&w=majority

# REDIS CONNECTION (Upstash)
# Format: redis://default:your_password@your-endpoint.upstash.io:6379
REDIS_URL=redis://default:your_redis_password@your-endpoint.upstash.io:6379

# PREVIEW ENVIRONMENT (Render only)
# Set these on Render preview environments to use a separate bot token
# PREVIEW_BOT_TOKEN=your_preview_bot_token_here
